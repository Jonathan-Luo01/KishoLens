---
import "../styles/global.css";

const INITIAL_MYSTERY_TEXT = `The rain beat against the fog-stained windowpanes of 221B Baker Street as Inspector Lestrade threw open the heavy oak door. His coat was drenched, and his eyes burned with anxiety. "Holmes, you must come at once," he gasped, resting his hands upon the polished mahogany table. "Lord Harrington lies motionless in his study, the doors locked from within and a shattered crystal decanter resting beside his chair."

Sherlock Holmes did not rise immediately. He slowly lowered his pipe, allowing a dense ring of blue smoke to curl toward the ceiling before adjusting his magnifying lens. "A locked room, Lestrade? How delightfully elementary. And tell me, did you observe the faint scent of bitter almonds clinging to the victim's lips?" Lestrade blinked in astonishment. "Why, yes, Holmes—how could you possibly know?" Holmes turned to me with a faint smile. "A classic case of cyanide poisoning, Watson. Pack your bag; the hunt is afoot."`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="KishoLens — Measure sentence momentum, map 4-phase story curves, and trace literary lineage across 10,000+ serialized web novels and world classics."
    />
    <title>KishoLens — Narrative Prose & Pacing Analytics</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="app-container">
      <header class="site-header">
        <a href="/" class="brand-title">Kish<span>o</span>Lens</a>
        <nav class="site-nav">
          <a href="/analyze">Analyze Prose</a>
          <a href="/library">Library</a>
        </nav>
      </header>
      <!-- Hero Section -->
      <section class="hero-section">
        <div class="hero-header">
          <h1 class="hero-title">
            Kish<span class="brand-accent">o</span>Lens
          </h1>
          <p class="hero-tagline">
            The architecture and rhythm of narrative prose
          </p>
          <p class="hero-desc">
            Measure sentence momentum, map eastern 4-phase story curves, and trace literary lineage across 10,000+ serialized web novels and world classics in English, Japanese, and Chinese.
          </p>

          <div class="hero-actions">
            <a href="/analyze" class="btn btn-primary" id="analyze-btn">Analyze Prose &rarr;</a>
            <a href="/library" class="btn btn-secondary" id="explore-btn">Explore Library Database</a>
          </div>
        </div>

        <!-- Interactive Sample Reader Widget -->
        <div class="sample-reader">
          <div class="reader-header">
            <span class="reader-label">LIVE PROSE INSPECTOR</span>
            <div class="reader-tabs" role="tablist">
              <button class="reader-tab active" data-sample="mystery" role="tab" aria-selected="true">Mystery</button>
              <button class="reader-tab" data-sample="fantasy" role="tab" aria-selected="false">Fantasy</button>
              <button class="reader-tab" data-sample="isekai" role="tab" aria-selected="false">Isekai</button>
            </div>
          </div>

          <!-- Excerpt Box -->
          <div class="excerpt-box">
            <p id="excerpt-text" class="excerpt-content">{INITIAL_MYSTERY_TEXT}</p>
          </div>

          <!-- Live Metrics Bar -->
          <div class="reader-metrics">
            <div class="metric-pill">
              <span class="pill-lbl">Syntactic Depth</span>
              <span id="metric-depth" class="pill-val color-purple">4.57</span>
            </div>
            <div class="metric-pill">
              <span class="pill-lbl">Dialogue Ratio</span>
              <span id="metric-dialogue" class="pill-val color-cyan">38.7%</span>
            </div>
            <div class="metric-pill">
              <span class="pill-lbl">Vocabulary TTR</span>
              <span id="metric-ttr" class="pill-val color-emerald">0.74</span>
            </div>
            <div class="metric-pill">
              <span class="pill-lbl">Territory Match</span>
              <span id="metric-territory" class="pill-val color-pink">Classic Literature Territory</span>
            </div>
          </div>

          <!-- Reader Action Link to Analyze Page -->
          <div class="reader-action-row">
            <a id="btn-open-in-analyzer" href="/analyze?text=The%20rain%20beat%20against%20the%20fog-stained%20windowpanes%20of%20221B%20Baker%20Street%20as%20Inspector%20Lestrade%20threw%20open%20the%20heavy%20oak%20door.%20His%20coat%20was%20drenched%2C%20and%20his%20eyes%20burned%20with%20anxiety.%20%22Holmes%2C%20you%20must%20come%20at%20once%2C%22%20he%20gasped%2C%20resting%20his%20hands%20upon%20the%20polished%20mahogany%20table.%20%22Lord%20Harrington%20lies%20motionless%20in%20his%20study%2C%20the%20doors%20locked%20from%20within%20and%20a%20shattered%20crystal%20decanter%20resting%20beside%20his%20chair.%22%0A%0ASherlock%20Holmes%20did%20not%20rise%20immediately.%20He%20slowly%20lowered%20his%20pipe%2C%20allowing%20a%20dense%20ring%20of%20blue%20smoke%20to%20curl%20toward%20the%20ceiling%20before%20adjusting%20his%20magnifying%20lens.%20%22A%20locked%20room%2C%20Lestrade%3F%20How%20delightfully%20elementary.%20And%20tell%20me%2C%20did%20you%20observe%20the%20faint%20scent%20of%20bitter%20almonds%20clinging%20to%20the%20victim%27s%20lips%3F%22%20Lestrade%20blinked%20in%20astonishment.%20%22Why%2C%20yes%2C%20Holmes%E2%80%94how%20could%20you%20possibly%20know%3F%22%20Holmes%20turned%20to%20me%20with%20a%20faint%20smile.%20%22A%20classic%20case%20of%20cyanide%20poisoning%2C%20Watson.%20Pack%20your%20bag%3B%20the%20hunt%20is%20afoot.%22" class="btn btn-sm btn-accent">
              Open Full Breakdown in Analyzer &rarr;
            </a>
          </div>
        </div>
      </section>

      <!-- Editorial Capabilities Grid -->
      <section id="capabilities" class="capabilities-section">
        <div class="section-title-wrap">
          <span class="section-num">CORE PERSPECTIVES</span>
          <h2 class="section-heading">Three ways to look beneath the surface of a story</h2>
        </div>

        <div class="editorial-grid">
          <div class="editorial-col">
            <span class="col-num">01</span>
            <h3 class="col-title">Eastern 4-Phase Story Arcs</h3>
            <p class="col-desc">
              Western analysis often forces every story into a rigid 3-act hero's journey. KishoLens tracks Kishōtenketsu (Introduction, Development, Twist, Resolution) to show how narratives build momentum through contrast and harmony rather than direct conflict alone.
            </p>
          </div>

          <div class="editorial-col">
            <span class="col-num">02</span>
            <h3 class="col-title">Literary Lineage & Doppelgängers</h3>
            <p class="col-desc">
              Every author has an invisible syntactic fingerprint. By comparing dense semantic vectors against 10,000+ indexed works, KishoLens maps where your prose lives on the spectrum between rapid serialized web fiction and classical literature.
            </p>
          </div>

          <div class="editorial-col">
            <span class="col-num">03</span>
            <h3 class="col-title">Native Multi-Language Metrics</h3>
            <p class="col-desc">
              Grammar behaves differently in Japanese, Chinese, and English. We measure sentence clause depth, dialogue cadence, and vocabulary variety using language-specific parsers tailored to the unique rhythms of each writing tradition.
            </p>
          </div>
        </div>
      </section>

      <!-- Database Stats Bar -->
      <section class="stats-bar">
        <div class="stat-unit">
          <span class="stat-value">10,320+</span>
          <span class="stat-label">Indexed Works</span>
        </div>
        <span class="stat-sep">&bull;</span>
        <div class="stat-unit">
          <span class="stat-value">17</span>
          <span class="stat-label">Literary Archetypes</span>
        </div>
        <span class="stat-sep">&bull;</span>
        <div class="stat-unit">
          <span class="stat-value">8</span>
          <span class="stat-label">Core Dimensions</span>
        </div>
        <span class="stat-sep">&bull;</span>
        <div class="stat-unit">
          <span class="stat-value">3</span>
          <span class="stat-label">Native Languages (EN / JA / ZH)</span>
        </div>
      </section>
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="footer-wrap">
        <span class="footer-logo">Kish<span style="color: #a78bfa;">o</span>Lens</span>
        <span class="footer-meta">Dedicated to the craft of storytelling.</span>
      </div>
    </footer>

    <!-- Tab Interactivity Script -->
    <script>
      const SAMPLES = {
        mystery: {
          text: `The rain beat against the fog-stained windowpanes of 221B Baker Street as Inspector Lestrade threw open the heavy oak door. His coat was drenched, and his eyes burned with anxiety. "Holmes, you must come at once," he gasped, resting his hands upon the polished mahogany table. "Lord Harrington lies motionless in his study, the doors locked from within and a shattered crystal decanter resting beside his chair."

Sherlock Holmes did not rise immediately. He slowly lowered his pipe, allowing a dense ring of blue smoke to curl toward the ceiling before adjusting his magnifying lens. "A locked room, Lestrade? How delightfully elementary. And tell me, did you observe the faint scent of bitter almonds clinging to the victim's lips?" Lestrade blinked in astonishment. "Why, yes, Holmes—how could you possibly know?" Holmes turned to me with a faint smile. "A classic case of cyanide poisoning, Watson. Pack your bag; the hunt is afoot."`,
          depth: "4.57",
          dialogue: "38.7%",
          ttr: "0.74",
          territory: "Classic Literature Territory"
        },
        fantasy: {
          text: `High atop the ancient obsidian spire of the Archmage, Leylin channeled his mana into the glowing crystal orb. Deep within the subterranean caverns of Eldoria, ancient runes began to flare with brilliant azure light. Arcane lightning erupted across the stormy sky as the sky-thundering dragon unleashed a roar that shook the foundations of the mortal realm.

"Hold the warding barrier!" shouted High Templar Valerius, raising his runic broadsword against the descending shadow. The wind howled through the ruined ramparts, carrying the stench of ozone and scorched stone. Leylin closed his eyes, humming a forgotten incantation as the swirling vortex of raw magical energy converged upon his staff.`,
          depth: "7.33",
          dialogue: "3.7%",
          ttr: "0.76",
          territory: "Web Novel Territory"
        },
        isekai: {
          text: `Hit by Truck-kun while crossing the zebra zone after buying a limited-edition melon pan, Kazuma opened his eyes to find himself floating in an endless sea of brilliant azure light. Before he could process his untimely demise, a translucent holographic window materialized directly before his vision with a cheerful chime: [Reincarnated as Hero with Level 99 Divine Stats].

"Wait, is this really happening?" Kazuma muttered, rubbing his eyes in disbelief as a glowing goddess in silver robes stepped forward from the ethereal fog. "Welcome, brave traveler from Earth. You have been chosen to overthrow the Demon King in the realm of Fantasia." A wide grin spread across Kazuma's face as he clicked [Accept Cheat Skills].`,
          depth: "5.62",
          dialogue: "20.3%",
          ttr: "0.80",
          territory: "Web Novel Territory"
        }
      };

      document.addEventListener("DOMContentLoaded", () => {
        const tabs = document.querySelectorAll(".reader-tab");
        const textEl = document.getElementById("excerpt-text");
        const depthEl = document.getElementById("metric-depth");
        const dialogueEl = document.getElementById("metric-dialogue");
        const ttrEl = document.getElementById("metric-ttr");
        const territoryEl = document.getElementById("metric-territory");
        const actionBtn = document.getElementById("btn-open-in-analyzer");

        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            tabs.forEach((t) => {
              t.classList.remove("active");
              t.setAttribute("aria-selected", "false");
            });
            tab.classList.add("active");
            tab.setAttribute("aria-selected", "true");

            const key = tab.getAttribute("data-sample");
            const sample = SAMPLES[key];

            if (sample && textEl) {
              textEl.textContent = sample.text;
              if (depthEl) depthEl.textContent = sample.depth;
              if (dialogueEl) dialogueEl.textContent = sample.dialogue;
              if (ttrEl) ttrEl.textContent = sample.ttr;
              if (territoryEl) territoryEl.textContent = sample.territory;
              if (actionBtn) actionBtn.href = `/analyze?text=${encodeURIComponent(sample.text)}`;
            }
          });
        });

        // Capabilities section scroll highlight observer
        const capSection = document.getElementById("capabilities");
        const capNav = document.getElementById("nav-capabilities");
        if (capSection && capNav) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  capNav.classList.add("active");
                } else {
                  capNav.classList.remove("active");
                }
              });
            },
            { threshold: 0.3 }
          );
          observer.observe(capSection);
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --font-heading: 'Outfit', -apple-system, sans-serif;
    --font-body: 'Inter', -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
    --bg-main: #0b0c10;
    --card-bg: rgba(18, 20, 29, 0.7);
    --border-line: rgba(255, 255, 255, 0.08);
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
    line-height: 1.6;
    overflow-x: hidden;
  }

  .app-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-sm {
    padding: 0.4rem 0.9rem;
    font-size: 0.82rem;
  }

  .btn-accent {
    background: rgba(167, 139, 250, 0.15);
    color: #c4b5fd;
    border: 1px solid rgba(167, 139, 250, 0.3);
  }

  .btn-accent:hover {
    background: rgba(167, 139, 250, 0.25);
    color: #ffffff;
  }

  .btn-primary {
    background: #7c3aed;
    color: #ffffff;
    border: none;
  }

  .btn-primary:hover {
    background: #6d28d9;
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.04);
    color: #e2e8f0;
    border: 1px solid var(--border-line);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Page Layout */
  .page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  /* Hero Section */
  .hero-section {
    padding: 2rem 0 4rem;
  }

  .hero-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 3.4rem;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;
  }

  .hero-tagline {
    font-size: 1.05rem;
    font-weight: 600;
    color: #a78bfa;
    margin: 0 0 1rem;
    letter-spacing: 0.02em;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: #94a3b8;
    margin: 0 0 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  /* Sample Reader Widget */
  .sample-reader {
    background: var(--card-bg);
    border: 1px solid var(--border-line);
    border-radius: 0.9rem;
    padding: 1.5rem;
    margin-top: 2rem;
  }

  .reader-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-line);
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .reader-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: #64748b;
    letter-spacing: 0.08em;
  }

  .reader-tabs {
    display: flex;
    gap: 0.4rem;
  }

  .reader-tab {
    background: transparent;
    border: 1px solid transparent;
    color: #94a3b8;
    padding: 0.35rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .reader-tab:hover {
    color: #ffffff;
  }

  .reader-tab.active {
    background: rgba(167, 139, 250, 0.12);
    border-color: rgba(167, 139, 250, 0.3);
    color: #c4b5fd;
    font-weight: 600;
  }

  .excerpt-box {
    padding: 1.4rem;
    background: rgba(9, 10, 14, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 0.6rem;
    margin: 1.2rem 0;
  }

  .excerpt-content {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 0.8rem;
    white-space: pre-line;
  }

  .reader-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
  }

  @media (max-width: 768px) {
    .reader-metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .metric-pill {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-line);
    padding: 0.6rem 0.8rem;
    border-radius: 0.5rem;
  }

  .pill-lbl {
    font-size: 0.68rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .pill-val {
    font-size: 0.85rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .color-purple { color: #c4b5fd; }
  .color-cyan { color: #38bdf8; }
  .color-emerald { color: #34d399; }
  .color-pink { color: #f472b6; }

  .reader-action-row {
    display: flex;
    justify-content: flex-end;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--border-line);
  }

  /* Capabilities Grid */
  .capabilities-section {
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--border-line);
  }

  .section-title-wrap {
    margin-bottom: 2.5rem;
  }

  .section-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: #a78bfa;
    letter-spacing: 0.1em;
  }

  .section-heading {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0.3rem 0 0;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 768px) {
    .editorial-grid {
      grid-template-columns: 1fr;
    }
  }

  .editorial-col {
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .col-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #64748b;
  }

  .col-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: #f1f5f9;
    margin: 0.4rem 0 0.6rem;
  }

  .col-desc {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.65;
    margin: 0;
  }

  /* Stats Bar */
  .stats-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2.5rem 0;
    margin-top: 3rem;
    border-top: 1px solid var(--border-line);
    flex-wrap: wrap;
  }

  .stat-unit {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
  }

  .stat-label {
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .stat-sep {
    color: #475569;
    font-size: 0.8rem;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border-line);
    padding: 1.8rem 1.5rem;
    background: #07080b;
    margin-top: 2rem;
  }

  .footer-wrap {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: #ffffff;
  }

  .footer-meta {
    font-size: 0.8rem;
    color: #64748b;
  }
</style>
