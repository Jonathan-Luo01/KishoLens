---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="KishoLens — AI-powered stylistic pacing, Kishōtenketsu 4-act sentiment curves, and prose archetype analytics for web novels and classic literature."
    />
    <title>KishoLens — AI Prose & Pacing Analytics</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Top Navigation Bar -->
    <header class="navbar">
      <div class="navbar-container">
        <a href="/" class="brand-logo">
          Kish<span class="brand-accent">o</span>Lens
        </a>
        <nav class="nav-links">
          <a href="#features" class="nav-link">Features</a>
          <a href="/analyze" class="nav-link">Analyze Prose</a>
          <a href="/library" class="nav-link">Explore Library</a>
        </nav>
        <div class="nav-actions">
          <a href="/analyze" class="btn btn-sm btn-primary">Try Analyzer &rarr;</a>
        </div>
      </div>
    </header>

    <main class="page-main">
      <!-- Ambient Glow Spotlights -->
      <div class="glow-spotlight glow-purple" aria-hidden="true"></div>
      <div class="glow-spotlight glow-cyan" aria-hidden="true"></div>

      <!-- Hero Section -->
      <section class="hero-section">
        <div class="hero-content">
          <div class="hero-badge">
            <span class="badge-dot"></span>
            <span>AI-Powered Prose & Pacing Analytics &bull; 2,813+ Ingested Novels</span>
          </div>

          <h1 class="hero-title">
            Uncover the <span class="gradient-text">Narrative DNA</span> of Web Novels & Classic Literature
          </h1>

          <p class="hero-subtitle">
            Quantify 4-Act Kishōtenketsu sentiment arcs, syntactic complexity, dialogue density, and prose archetypes across 17 canonical genres and 3 languages.
          </p>

          <div class="hero-cta-group">
            <a href="/analyze" class="btn btn-lg btn-primary shadow-purple">
              <span>Analyze Prose</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/library" class="btn btn-lg btn-ghost">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
              <span>Explore Library</span>
            </a>
          </div>
        </div>

        <!-- Interactive Hero Demo Card -->
        <div class="hero-demo-wrapper">
          <div class="demo-card">
            <div class="demo-card-header">
              <div class="demo-status">
                <span class="pulse-dot"></span>
                <span class="demo-title">Live Preview: 4-Act Sentiment Arc</span>
              </div>
              <span class="demo-tag">Sample Chapter</span>
            </div>

            <!-- SVG 4-Act Kishōtenketsu Curve Chart -->
            <div class="demo-chart-container">
              <svg class="demo-svg-chart" viewBox="0 0 400 160" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="curveGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#a78bfa" />
                    <stop offset="33%" stop-color="#38bdf8" />
                    <stop offset="66%" stop-color="#ec4899" />
                    <stop offset="100%" stop-color="#34d399" />
                  </linearGradient>
                  <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#a78bfa" stop-opacity="0.3" />
                    <stop offset="100%" stop-color="#a78bfa" stop-opacity="0.0" />
                  </linearGradient>
                </defs>

                <!-- Grid Guide Lines -->
                <line x1="0" y1="40" x2="400" y2="40" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />
                <line x1="0" y1="80" x2="400" y2="80" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />
                <line x1="0" y1="120" x2="400" y2="120" stroke="rgba(255,255,255,0.06)" stroke-dasharray="4 4" />

                <!-- Act Divider Lines -->
                <line x1="100" y1="10" x2="100" y2="150" stroke="rgba(255,255,255,0.08)" />
                <line x1="200" y1="10" x2="200" y2="150" stroke="rgba(255,255,255,0.08)" />
                <line x1="300" y1="10" x2="300" y2="150" stroke="rgba(255,255,255,0.08)" />

                <!-- Filled Area -->
                <path d="M 10,110 Q 50,120 100,85 T 200,105 T 300,35 T 390,70 L 390,150 L 10,150 Z" fill="url(#areaGradient)" />

                <!-- Sentiment Curve -->
                <path d="M 10,110 Q 50,120 100,85 T 200,105 T 300,35 T 390,70" fill="none" stroke="url(#curveGradient)" stroke-width="3.5" stroke-linecap="round" />

                <!-- Act Nodes -->
                <circle cx="50" cy="115" r="5" fill="#a78bfa" class="chart-node" />
                <circle cx="150" cy="95" r="5" fill="#38bdf8" class="chart-node" />
                <circle cx="250" cy="60" r="5" fill="#ec4899" class="chart-node" />
                <circle cx="350" cy="50" r="5" fill="#34d399" class="chart-node" />
              </svg>

              <!-- Act Labels -->
              <div class="act-labels">
                <span class="act-label"><strong style="color: #a78bfa;">Ki 起</strong><br/><small>Introduction</small></span>
                <span class="act-label"><strong style="color: #38bdf8;">Shō 承</strong><br/><small>Development</small></span>
                <span class="act-label"><strong style="color: #ec4899;">Ten 転</strong><br/><small>Twist / Subversion</small></span>
                <span class="act-label"><strong style="color: #34d399;">Ketsu 结</strong><br/><small>Reconciliation</small></span>
              </div>
            </div>

            <!-- Card Bottom Metrics -->
            <div class="demo-card-footer">
              <div class="demo-chip">
                <span class="demo-chip-lbl">Archetype Match</span>
                <span class="demo-chip-val" style="color: #a78bfa;">Progression / Xianxia</span>
              </div>
              <div class="demo-chip">
                <span class="demo-chip-lbl">Territory</span>
                <span class="demo-chip-val" style="color: #38bdf8;">Web Novel Territory</span>
              </div>
              <div class="demo-chip">
                <span class="demo-chip-lbl">Dialogue Ratio</span>
                <span class="demo-chip-val" style="color: #34d399;">34.2%</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Capabilities & Features Grid -->
      <section id="features" class="features-section">
        <div class="section-header">
          <span class="section-tag">CAPABILITIES</span>
          <h2 class="section-title">Deep Prose & Pacing Analytics</h2>
          <p class="section-desc">From sentence structure to emotional arcs, quantify what makes story text captivating.</p>
        </div>

        <div class="features-grid">
          <!-- Card 1 -->
          <div class="feature-card">
            <div class="feature-icon" style="background: rgba(167, 139, 250, 0.12); color: #a78bfa;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <h3 class="feature-title">Kishōtenketsu Pacing Arcs</h3>
            <p class="feature-desc">
              Track 4-quantile sentiment dynamics (Introduction, Development, Twist, Reconciliation) to uncover narrative momentum and climax placement.
            </p>
          </div>

          <!-- Card 2 -->
          <div class="feature-card">
            <div class="feature-icon" style="background: rgba(56, 189, 248, 0.12); color: #38bdf8;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="feature-title">Prose Archetype & Territory Engine</h3>
            <p class="feature-desc">
              Cosine vector similarity matching across 384-dimensional embeddings to classify works into Web Novel Territory vs. Classic Literature Territory.
            </p>
          </div>

          <!-- Card 3 -->
          <div class="feature-card">
            <div class="feature-icon" style="background: rgba(236, 72, 153, 0.12); color: #ec4899;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h3 class="feature-title">17 Canonical Genre Taxonomies</h3>
            <p class="feature-desc">
              Multi-label classification tailored for Xianxia, Cultivation, Isekai, Romance, Historical, Sci-Fi, Slice of Life, and classic literary traditions.
            </p>
          </div>

          <!-- Card 4 -->
          <div class="feature-card">
            <div class="feature-icon" style="background: rgba(52, 211, 153, 0.12); color: #34d399;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m5 8 6 6 6-6"/><path d="m4 14 8 8 8-8"/></svg>
            </div>
            <h3 class="feature-title">Multi-Lingual Deep NLP</h3>
            <p class="feature-desc">
              Native syntactic tree depth, TTR lexical density, and dialogue ratio extraction for English (spaCy), Japanese (SudachiPy), and Chinese (spaCy/HanLP).
            </p>
          </div>
        </div>
      </section>

      <!-- Live Database Metrics Banner -->
      <section class="stats-section">
        <div class="stats-banner">
          <div class="stat-item">
            <span class="stat-num" style="color: #a78bfa;">2,813+</span>
            <span class="stat-lbl">Ingested Novels</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num" style="color: #38bdf8;">17</span>
            <span class="stat-lbl">Canonical Genres</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num" style="color: #ec4899;">4</span>
            <span class="stat-lbl">Metric Dimensions</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-num" style="color: #34d399;">3</span>
            <span class="stat-lbl">Languages (EN/JA/ZH)</span>
          </div>
        </div>
      </section>

      <!-- Call to Action Banner -->
      <section class="cta-section">
        <div class="cta-box">
          <h2 class="cta-title">Ready to Analyze Your Prose?</h2>
          <p class="cta-desc">Paste your chapter text to generate stylistic pacing curves, archetype matches, and benchmark comparisons in seconds.</p>
          <div class="cta-actions">
            <a href="/analyze" class="btn btn-lg btn-primary shadow-purple">Analyze Prose Now &rarr;</a>
            <a href="/library" class="btn btn-lg btn-ghost">Browse Library Database</a>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-left">
          <span class="footer-brand">Kish<span style="color: #a78bfa;">o</span>Lens</span>
          <span class="footer-copy">&copy; 2026 KishoLens Engine &bull; Built with Astro, FastAPI, PyTorch &amp; spaCy</span>
        </div>
        <div class="footer-links">
          <a href="/analyze" class="footer-link">Analyze</a>
          <a href="/library" class="footer-link">Library</a>
          <a href="#features" class="footer-link">Features</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    --font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    --bg-dark: #09090e;
    --card-bg: rgba(18, 18, 30, 0.65);
    --border-subtle: rgba(255, 255, 255, 0.08);
  }

  body {
    margin: 0;
    padding: 0;
    background-color: var(--bg-dark);
    color: #f8fafc;
    font-family: var(--font-body);
    overflow-x: hidden;
    line-height: 1.6;
  }

  /* Sticky Navbar */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(9, 9, 14, 0.8);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .brand-accent {
    color: #a78bfa;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* Ambient Glow Spotlights */
  .glow-spotlight {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
  }

  .glow-purple {
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 450px;
    background: radial-gradient(circle, rgba(167, 139, 250, 0.18) 0%, rgba(0,0,0,0) 70%);
  }

  .glow-cyan {
    top: 300px;
    right: -100px;
    width: 500px;
    height: 400px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.12) 0%, rgba(0,0,0,0) 70%);
  }

  /* Main Container */
  .page-main {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  /* Hero Section */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 2.5rem 0 5rem;
  }

  @media (max-width: 960px) {
    .hero-section {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2.5rem;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.35rem 0.9rem;
    background: rgba(167, 139, 250, 0.1);
    border: 1px solid rgba(167, 139, 250, 0.25);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    color: #c4b5fd;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #a78bfa;
    box-shadow: 0 0 8px #a78bfa;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 1.2rem;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 2.4rem;
    }
  }

  .gradient-text {
    background: linear-gradient(135deg, #a78bfa 0%, #38bdf8 50%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.1rem;
    color: #94a3b8;
    max-width: 540px;
    margin: 0 0 2rem;
    font-weight: 400;
  }

  @media (max-width: 960px) {
    .hero-subtitle {
      margin: 0 auto 2rem;
    }
  }

  .hero-cta-group {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-cta-group {
      justify-content: center;
    }
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.6rem;
    border-radius: 0.6rem;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-sm {
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
  }

  .btn-lg {
    padding: 0.95rem 1.8rem;
    font-size: 1rem;
  }

  .btn-primary {
    background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
    color: #ffffff;
    border: none;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(139, 92, 246, 0.4);
  }

  .btn-ghost {
    background: rgba(255, 255, 255, 0.05);
    color: #f1f5f9;
    border: 1px solid var(--border-subtle);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .shadow-purple {
    box-shadow: 0 4px 20px rgba(139, 92, 246, 0.3);
  }

  /* Interactive Hero Demo Card */
  .hero-demo-wrapper {
    position: relative;
  }

  .demo-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: 1.2rem;
    padding: 1.5rem;
    backdrop-filter: blur(16px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .demo-card:hover {
    border-color: rgba(167, 139, 250, 0.3);
    transform: translateY(-3px);
  }

  .demo-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1rem;
  }

  .demo-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #34d399;
    box-shadow: 0 0 8px #34d399;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
    100% { opacity: 1; transform: scale(1); }
  }

  .demo-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #e2e8f0;
  }

  .demo-tag {
    font-size: 0.72rem;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.06);
    padding: 0.2rem 0.6rem;
    border-radius: 0.4rem;
  }

  .demo-chart-container {
    position: relative;
    margin: 1rem 0;
  }

  .demo-svg-chart {
    width: 100%;
    height: 140px;
    overflow: visible;
  }

  .chart-node {
    transition: r 0.2s ease, fill 0.2s ease;
    cursor: pointer;
  }

  .chart-node:hover {
    r: 8;
  }

  .act-labels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    margin-top: 0.6rem;
    text-align: center;
  }

  .act-label {
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.2;
  }

  .demo-card-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 1.2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .demo-chip {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .demo-chip-lbl {
    font-size: 0.68rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;

  }

  .demo-chip-val {
    font-size: 0.82rem;
    font-weight: 700;
    margin-top: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Capabilities & Features Grid */
  .features-section {
    padding: 5rem 0 3rem;
  }

  .section-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3.5rem;
  }

  .section-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #a78bfa;
    letter-spacing: 0.1em;

  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    margin: 0.4rem 0 0.8rem;
    letter-spacing: -0.02em;

  }

  .section-desc {
    color: #94a3b8;
    font-size: 1rem;
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.8rem;
  }

  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
  }

  .feature-card {
    background: var(--card-bg);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 2rem;
    backdrop-filter: blur(12px);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    border-color: rgba(167, 139, 250, 0.3);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.2rem;
  }

  .feature-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.6rem;
    color: #f1f5f9;
  }

  .feature-desc {
    color: #94a3b8;
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }

