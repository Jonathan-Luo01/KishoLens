  <body>
    <div class="hero__glow" transition:persist aria-hidden="true"></div>
    <div class="app-container">
      <header class="site-header" transition:persist>
        <a href="/" class="brand-title">Kish<span>o</span>Lens</a>
        <div class="site-header-actions">
          <nav class="site-nav">
            <a href="/analyze"><span class="nav-text-full">Analyze Prose</span><span class="nav-text-short">Analyze</span></a>
            <a href="/library" class="active">Library</a>
          </nav>
          <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle theme" title="Toggle theme">
            <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </div>
      </header>

      <!-- 1. Top Section: Library Explorer (Left) + Stylistic Stats & Ingest Form (Right) -->
      <div class="dashboard-layout">
        <!-- Left Side: Clean Card for Search, Filters, and Novel Explorer -->
        <div class="card explorer-card">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; margin: 0;">Library & Prose Explorer</h2>
            <span class="count-badge" id="novel-count-badge">Loading...</span>
          </div>

          <!-- Section 1: Search & Territory Selection -->
          <div class="explorer-section">
            <div class="explorer-section-title">
              <span>Search & Territory</span>
            </div>

            <!-- Search Input with Icon -->
            <div class="search-input-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="novel-search-input"
                placeholder="Search by title, author, genre, or dataset..."
              />
            </div>

            <!-- Territory Selector Tabs -->
            <div class="territory-tabs" id="territory-selector" style="margin-top: 0.4rem; margin-bottom: 0;">
              <button class="t-tab active" data-territory="All" onclick="selectTerritory('All')">All Genres</button>
              <button class="t-tab" data-territory="Classic Literature Territory" onclick="selectTerritory('Classic Literature Territory')">Classic Literature Territory</button>
              <button class="t-tab" data-territory="Web Novel Territory" onclick="selectTerritory('Web Novel Territory')">Web Novel Territory</button>
            </div>

            <!-- Active Territory Description -->
            <div class="territory-desc-card" id="territory-description" style="margin-bottom: 0;">
              Explore prose archetypes, pacing metrics, and structural profiles across all ingested literature.
            </div>
          </div>

          <!-- Section 2: Prose Genre Filters -->
          <div class="explorer-section">
            <div class="explorer-section-title" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <span>Filter by Prose Genre</span>
              <div class="genre-help-tips">
                <span class="tip-badge tip-include">Click to Select</span>
                <span class="tip-badge tip-exclude">✕ Double-Click to Exclude</span>
                <button type="button" class="btn-reset-filters" onclick="resetGenreFilters()">Reset All</button>
              </div>
            </div>
            <div class="genre-checkbox-grid" id="genre-checkboxes-container">
              <div class="placeholder-text" style="padding: 0.5rem 0; grid-column: 1 / -1;">Loading genres...</div>
            </div>
          </div>

          <!-- Section 3: Ingested Novels List -->
          <div class="explorer-section explorer-novels-section">
            <div class="explorer-section-title" style="display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <span id="novels-list-title">Ingested Novels</span>
              <div class="metrics-carousel-nav" id="novelPaginationControls" style="display: none;">
                <button class="carousel-nav-btn" id="novelPagePrev" aria-label="Previous page" title="Previous page">‹</button>
                <span class="carousel-indicator-pill" id="novelPageIndicator">Page 1 of 1</span>
                <button class="carousel-nav-btn" id="novelPageNext" aria-label="Next page" title="Next page">›</button>
              </div>
            </div>
            <div class="novel-list" id="novels-container">
              <div class="placeholder-text">Loading library novels...</div>
            </div>
          </div>
        </div>

        <!-- Right Side: Stats & Ingest Control -->
        <div class="stats-panel">
          <!-- Stats Viewer -->
          <div class="card" id="stats-container">
            <h3 style="font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.75rem;" id="novel-details-title">Stylistic Analysis</h3>
            <div id="stats-content" class="stats-content-scroll">
              <div class="empty-state-card" id="library-empty-state">
                <div>
                  <div class="empty-state-title">Select a Novel to Explore</div>
                  <div class="empty-state-desc">Choose any indexed novel from the left catalog or pick a sample below to inspect stylistic footprints, emotional arcs, and doppelgänger matches.</div>
                </div>
                <div class="empty-state-features">
                  <div class="empty-feature-item">
                    <span><strong>6-Axis Archetype Radar:</strong> Complexity, vocabulary, dialogue & tone.</span>
                  </div>
                  <div class="empty-feature-item">
                    <span><strong>4-Act Kishōtenketsu Arc:</strong> Emotional narrative trajectory & turns.</span>
                  </div>
                  <div class="empty-feature-item">
                    <span><strong>Paragraph Cadence:</strong> Rhythmic pacing distribution barcode.</span>
                  </div>
                </div>
                <div class="empty-state-actions">
                  <button type="button" class="empty-quick-btn" id="quickSampleWebNovel">Load Sample Web Novel</button>
                  <button type="button" class="empty-quick-btn" id="quickSampleClassicLit">Load Sample Classic Lit</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Ingestion Form -->
