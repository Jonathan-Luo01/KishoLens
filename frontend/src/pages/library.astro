      <!-- 3. Bottom Section: Interactive Visualizations (Archetype Radar, Sentiment Arc, Pacing Barcode) -->
      <div class="charts-grid" id="chartsGrid" style="display: none;">

        <!-- Archetype Radar Chart -->
        <div class="chart-card">
          <div class="chart-header">
