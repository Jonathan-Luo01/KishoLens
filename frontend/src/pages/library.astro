            <div id="taxonomyPillars" class="taxonomy-pillars" style="display: none;"></div>
            <div id="genreAffinitiesTrack" class="genre-affinities-track" style="display: none;"></div>
            <button id="toggleAllGenresBtn" class="toggle-all-genres-btn" type="button" style="display: none;">
              <span id="toggleAllGenresText">View All 17 Ranked Genres</span>
              <svg id="toggleAllGenresChevron" class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div id="allGenresDrawer" class="all-genres-drawer" style="display: none;"></div>
