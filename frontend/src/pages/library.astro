        <!-- Kishōtenketsu Sentiment Arc Chart -->
        <div class="chart-card">
          <div class="chart-header">
            <h2 class="chart-title">Kishōtenketsu Sentiment Arc</h2>
            <div class="chart-legend">
              <span class="legend-item"><span class="legend-dot user"></span>Selected Novel</span>
              <span class="legend-item"><span class="legend-dot baseline" id="arcBaselineLegendDot"></span><span id="baselineLegendLabel">Web Novel</span></span>
            </div>
          </div>
          <p class="chart-subtitle">
            Tracks emotional polarity of the language used across the 4 acts (Ki, Shō, Ten, Ketsu).
          </p>
          <svg id="arcChart" viewBox="0 0 600 420" preserveAspectRatio="xMidYMid meet"></svg>
        </div>

        <!-- Rhythmic Pacing Barcode (Full Width) -->
        <div class="chart-card" style="grid-column: 1 / -1;">
          <div class="chart-header">
            <h2 class="chart-title">Rhythmic Pacing (Paragraph Density)</h2>
            <div class="chart-legend">
              <span class="legend-item"><span class="legend-dot user"></span>Selected Novel</span>
              <span class="legend-item"><span class="legend-dot baseline" id="pacingBaselineLegendDot"></span><span id="pacingBaselineLegendLabel">Web Novel</span></span>
            </div>
          </div>
          <p class="chart-subtitle">
            Each block represents a paragraph. Height/opacity represents word or character count. Web Novels rely on rapid, fragmented lines for mobile scrolling, while classics use dense text blocks.
          </p>
          
          <div style="margin-top: 1rem;">
            <h4 class="pacing-track-label" id="pacingDraftLabel">Selected Novel (Paragraph Lengths)</h4>
            <div id="pacingBarcodeUser" class="pacing-barcode-track"></div>
          </div>
          
          <div style="margin-top: 1.25rem;">
            <h4 class="pacing-track-label" id="pacingBaselineLabel">Web Novel Baseline</h4>
            <div id="pacingBarcodeBaseline" class="pacing-barcode-track"></div>
          </div>
        </div>

        <!-- Similar Works / Stylistic Matches Card (Full Width) -->
        <div class="doppelganger-card">
          <h3 class="doppelganger-title">Similar Works &amp; Stylistic Matches</h3>
          <p class="doppelganger-subtitle">
            The closest matching novels in the database based on prose style and semantic structure.
          </p>
          <div class="doppelganger-list" id="similarNovelsContainer">
            <div style="color: #64748b; font-size: 13px; margin: 0; padding: 12px;">Loading matches...</div>
          </div>
        </div>

      </div>

    </div>

    <!-- Tooltip Nodes for Interactive Chart Hover -->
    <div id="radarTooltip" class="radar-tooltip"></div>
    <div id="arcTooltip" class="radar-tooltip"></div>

    <!-- Client-side Logic -->
    <script>
      const API_URL = (typeof window !== "undefined" && window.__PUBLIC_API_URL__) || (import.meta.env && import.meta.env.PUBLIC_API_URL) || "http://localhost:8000";

      let allNovels = [];
      let selectedTerritory = "All";
      let excludedGenres = new Set();
      let searchQuery = "";
      let selectedNovelId = null;

      let currentStats = null;
      let currentArc   = null;
      let activeBaseline = "web_novel";
      let hoveredIndex = -1;
      let hoveredArcIndex = -1;

      // 1. Definition of Territories and Prose Genres (Clean plain text names, no emojis)
      const TERRITORIES = {
        "Classic Literature Territory": {
          description: "Traditional printed classics characterized by rich syntax structures, formal descriptive vocabulary, and low dialogic reliance.",
          genres: {
            "Action / Adventure": { description: "Expeditions, sea voyages, wilderness survival, and heroic quests." },
            "Comedy": { description: "Satire, parody, humorous stories, and social wit." },
            "Drama": { description: "Domestic drama, plays, social conflicts, and interpersonal relations." },
            "Fantasy": { description: "Mythology, folklore, fairy tales, allegories, and magic." },
            "Horror": { description: "Gothic fiction, ghost stories, macabre tales, and atmospheric dread." },
            "Historical": { description: "Historical fiction, Victorian settings, regency stories, and war fiction." },
            "Sci-Fi": { description: "Early precursors of science fiction, time travel, and imaginary voyages." },
            "Philosophy": { description: "Philosophical fiction, ethics, utilitarianism, and existential inquiry." },
            "Mystery": { description: "Detective stories, crime, police procedural, and whodunit plots." },
            "Tragedy": { description: "Fatalism, moral downfall, melancholy, and tragic downfall." },
            "Supernatural": { description: "Apparitions, spiritualism, demonology, and occult fiction." },
            "Poetry": { description: "Sonnets, epic poetry, ballads, and metered verse." },
            "Romance": { description: "Courtship, romantic fiction, love stories, and marital dynamics." }
          }
        },
        "Web Novel Territory": {
          description: "Serialized internet fiction characterized by rapid sentence pacing, dialogue reliance, and progression tropes.",
          genres: {
            "Action / Adventure": { description: "Martial action, dungeons, revenge, death games, and unlimited flow." },
            "Comedy": { description: "Slapstick, misunderstandings, gag comedy, and funny protagonists." },
            "Romance": { description: "Urban romance, CEO tropes, office romance, harem, and GL/BL." },
            "Drama": { description: "Betrayal, family conflict, politics, and emotional tension." },
            "Fantasy": { description: "LitRPG, status systems, magic academies, and dungeon building." },
            "Horror": { description: "Ghosts, demons, gore, and mystery horror." },
            "Historical": { description: "Ancient China, palace court intrigue, royalty, and kingdom building." },
            "Sci-Fi": { description: "Mecha, post-apocalyptic, VRMMO, and interstellar empire." },
            "Slice of Life": { description: "Slow life, farming, cooking, pet raising, and school life." },
            "Cultivation": { description: "Xianxia, Wuxia, Qi cultivation, sects, and immortal ascension." },
            "Tragedy": { description: "Sad endings, angst, heartbreak, and character sacrifice." },
            "Isekai": { description: "Portal fantasy, reincarnation, transmigration, and otome regressors." },
            "Progression Fantasy": { description: "LitRPG, status screens, level ups, stat points, and system notifications." },
            "Supernatural": { description: "Urban fantasy, modern magic, hunters, necromancy, and exorcism." }
          }
        }
      };

      function getAllAvailableGenres() {
        let set = new Set();
        if (selectedTerritory === "All") {
          Object.values(TERRITORIES).forEach(t => {
            Object.keys(t.genres).forEach(g => set.add(g));
          });
        } else if (TERRITORIES[selectedTerritory]) {
          Object.keys(TERRITORIES[selectedTerritory].genres).forEach(g => set.add(g));
        }
        return Array.from(set);
      }

      // Initialize empty set by default (no checkboxes checked at start, all genres active)
      let selectedGenres = new Set();

      // 2. Fetch and render novels
      async function fetchNovels() {
        selectedGenres.clear();
        excludedGenres.clear();
        renderGenreCheckboxes(); // Render checkboxes immediately on page load
        fetchDbStats();
        try {
          const res = await fetch(`${API_URL}/api/novels`);
          if (!res.ok) throw new Error(`HTTP ${res.status}: Failed to fetch novels`);
          allNovels = await res.json();

          populateNovelDropdown();
          renderGenreCheckboxes();
          filterNovels();

          // Restore previously selected novel across page switches
          const savedId = sessionStorage.getItem("library_selected_novel_id");
          const savedTitle = sessionStorage.getItem("library_selected_novel_title");
          if (savedId && savedTitle) {
            selectNovel(parseInt(savedId), savedTitle);
          }
        } catch (err) {
          console.error("Error fetching novels from API:", err);
          document.getElementById("novels-container").innerHTML = `
            <div class="placeholder-box" style="text-align:center; padding: 40px 20px;">
              <p class="placeholder-text" style="margin-bottom: 12px; color: var(--color-text-muted, #94a3b8);">Unable to connect to the novel library at this time.</p>
              <button onclick="fetchNovels()" class="btn btn-secondary" style="padding: 6px 14px; font-size: 0.85rem; cursor: pointer;">Retry Connection</button>
            </div>
          `;
        }
      }

      async function fetchDbStats() {
        try {
          let res = await fetch(`${API_URL}/api/db/stats`).catch(() => null);
          if (!res || !res.ok) return;
          const stats = await res.json();
          
          // Update total badge & KPI tiles
          const badgeEl = document.getElementById("db-total-badge");
          const kpiTotal = document.getElementById("kpi-total-val");
          const kpiWeb = document.getElementById("kpi-web-val");
          const kpiClassic = document.getElementById("kpi-classic-val");
          const kpiGenres = document.getElementById("kpi-genres-val");

          if (stats.total_novels) {
            if (badgeEl) badgeEl.innerText = `${stats.total_novels} Novels`;
            if (kpiTotal) kpiTotal.innerText = stats.total_novels;
          }

          // Update territory ratio
          const ratioEl = document.getElementById("db-territory-ratio");
          const barWeb = document.getElementById("db-bar-web");
          const barClassic = document.getElementById("db-bar-classic");
          if (stats.by_territory) {
            const webCnt = stats.by_territory["Web Novel Territory"] || 0;
            const classicCnt = stats.by_territory["Classic Literature Territory"] || 0;
            const total = webCnt + classicCnt || 1;
            const webPct = ((webCnt / total) * 100).toFixed(1);
            const classicPct = ((classicCnt / total) * 100).toFixed(1);

            if (kpiWeb) kpiWeb.innerText = webCnt;
            if (kpiClassic) kpiClassic.innerText = classicCnt;

            if (ratioEl) ratioEl.innerText = `${webCnt} Web (${webPct}%) • ${classicCnt} Classic (${classicPct}%)`;
            if (barWeb) barWeb.style.width = `${webPct}%`;
            if (barClassic) barClassic.style.width = `${classicPct}%`;
          }

          if (stats.by_genre && kpiGenres) {
            const activeGenreCount = Object.values(stats.by_genre).filter(c => c > 0).length;
            kpiGenres.innerText = activeGenreCount;
          }

          // Update sources chips with theme dots
          const sourcesContainer = document.getElementById("db-sources-badges");
          if (sourcesContainer && stats.by_source) {
            const srcMeta = {
              scribblehub: { label: "ScribbleHub", color: "#a855f7" },
              gutenberg:  { label: "Gutenberg",   color: "#f59e0b" },
              cnnovel:    { label: "CN Novel",    color: "#10b981" },
              royalroad:  { label: "Royal Road",  color: "#38bdf8" },
              syosetu:    { label: "Syosetu",     color: "#f43f5e" }
            };
            sourcesContainer.innerHTML = Object.entries(stats.by_source)
              .sort((a, b) => b[1] - a[1])
              .map(([src, cnt]) => {
                const meta = srcMeta[src] || { label: src, color: "#a78bfa" };
                return `<span class="db-source-chip"><span class="db-source-dot" style="background: ${meta.color};"></span>${meta.label}: ${cnt}</span>`;
              })
              .join("");
          }

          // Update genre chips with count badges
          const genresContainer = document.getElementById("db-genres-badges");
          if (genresContainer && stats.by_genre) {
            genresContainer.innerHTML = Object.entries(stats.by_genre)
              .sort((a, b) => b[1] - a[1])
              .map(([g, cnt]) => `<span class="db-genre-chip">${g} <span class="db-genre-count">${cnt}</span></span>`)
              .join("");
          }
        } catch (err) {
          console.error("Error fetching db stats:", err);
        }
      }

      function populateNovelDropdown(novelsToPopulate = allNovels) {
        const sel = document.getElementById("novelSelect");
        sel.innerHTML = '<option value="">— Select a novel —</option>';
        novelsToPopulate.forEach(n => {
          const opt = document.createElement("option");
          opt.value = n.id;
          opt.textContent = `${n.title} (${n.chapter_count || 1} ch)`;
          sel.appendChild(opt);
        });
        if (selectedNovelId && novelsToPopulate.some(n => n.id === selectedNovelId)) {
          sel.value = selectedNovelId;
        } else {
          sel.value = "";
        }
      }

      function selectTerritory(tName) {
        selectedTerritory = tName;
        excludedGenres.clear();
        selectedGenres.clear();
        
        document.querySelectorAll("#territory-selector .t-tab").forEach(tab => {
          if (tab.getAttribute("data-territory") === tName) {
            tab.classList.add("active");
          } else {
            tab.classList.remove("active");
          }
        });

        const descContainer = document.getElementById("territory-description");
        if (tName === "All") {
          descContainer.innerText = "Explore prose archetypes, pacing metrics, and structural profiles across all literature territories.";
        } else if (TERRITORIES[tName]) {
          descContainer.innerText = TERRITORIES[tName].description;
        }

        renderGenreCheckboxes();
        filterNovels();
      }

      let lastClickTime = 0;
      let lastClickGenre = null;

      function handleGenreItemClick(e, gName) {
        e.preventDefault();
        e.stopPropagation();

        const now = Date.now();
        if (lastClickGenre === gName && (now - lastClickTime) < 350) {
          // Double Click detected -> Exclude genre (✕)
          lastClickTime = 0;
          lastClickGenre = null;
          toggleExcludeGenre(gName);
        } else {
          // Single Click detected -> Toggle selected genre (✓)
          lastClickTime = now;
          lastClickGenre = gName;
          toggleSelectGenre(gName);
        }
      }

      function toggleSelectGenre(gName) {
        if (excludedGenres.has(gName)) {
          excludedGenres.delete(gName);
        }
        if (selectedGenres.has(gName)) {
          selectedGenres.delete(gName);
        } else {
          selectedGenres.add(gName);
        }
        renderGenreCheckboxes();
        filterNovels();
      }

      function toggleExcludeGenre(gName) {
        if (selectedGenres.has(gName)) {
          selectedGenres.delete(gName);
        }
        if (excludedGenres.has(gName)) {
          excludedGenres.delete(gName);
        } else {
          excludedGenres.add(gName);
        }
        renderGenreCheckboxes();
        filterNovels();
      }

      function resetGenreFilters() {
        excludedGenres.clear();
        selectedGenres.clear();
        renderGenreCheckboxes();
        filterNovels();
      }

      function renderGenreCheckboxes() {
        const container = document.getElementById("genre-checkboxes-container");
        if (!container) return;
        container.innerHTML = "";

        const allAvail = getAllAvailableGenres();

        allAvail.forEach(gName => {
          const item = document.createElement("label");
          const isIncluded = selectedGenres.has(gName);
          const isExcluded = excludedGenres.has(gName);

          let itemClass = "genre-checkbox-item";
          if (isExcluded) {
            itemClass += " excluded";
          } else if (isIncluded) {
            itemClass += " included";
          }

          item.className = itemClass;
          
          let desc = "";
          if (TERRITORIES[selectedTerritory] && TERRITORIES[selectedTerritory].genres[gName]) {
            desc = TERRITORIES[selectedTerritory].genres[gName].description;
          }
          if (desc) item.title = `${gName}: ${desc}`;

          const controlHTML = isExcluded
            ? `<span class="x-mark-box" style="display:inline-flex; align-items:center; justify-content:center; width:16px; height:16px; border-radius:3px; background:#dc2626; border:1px solid #f87171; color:#ffffff; font-size:10px; font-weight:900; line-height:1; flex-shrink:0; box-shadow:0 0 6px rgba(220,38,38,0.6); margin:0;">✕</span>`
            : `<input type="checkbox" class="real-genre-checkbox" ${isIncluded ? "checked" : ""} />`;

          item.innerHTML = `
            ${controlHTML}
            <span class="genre-name-text">${gName}</span>
          `;

          item.onclick = (e) => handleGenreItemClick(e, gName);

          container.appendChild(item);
        });
      }

      function filterNovels() {
        const container = document.getElementById("novels-container");
        const titleEl = document.getElementById("novels-list-title");
        const badgeEl = document.getElementById("novel-count-badge");
        
        searchQuery = document.getElementById("novel-search-input").value.toLowerCase().trim();

        let filtered = allNovels;

        // 1. Filter by territory
        if (selectedTerritory !== "All") {
          filtered = filtered.filter(n => {
            if (selectedTerritory === "Classic Literature Territory") return n.source === "gutenberg";
            return n.source !== "gutenberg";
          });
        }

        // 2. Exclude double-clicked genres
        if (excludedGenres.size > 0) {
          const exList = Array.from(excludedGenres).map(g => g.toLowerCase());
          filtered = filtered.filter(n => {
            const nGenre = (n.genre || "").toLowerCase();
            return !exList.some(ex => nGenre.includes(ex));
          });
        }

        // 3. Filter by selected (included) genres (if user has explicitly checked 1+ checkboxes)
        if (selectedGenres.size > 0) {
          const incList = Array.from(selectedGenres).map(g => g.toLowerCase());
          filtered = filtered.filter(n => {
            const nGenre = (n.genre || "").toLowerCase();
            return incList.some(inc => nGenre.includes(inc));
          });
        }

        // 4. Search query filter
        if (searchQuery) {
          filtered = filtered.filter(n => 
            (n.title && n.title.toLowerCase().includes(searchQuery)) ||
            (n.author && n.author.toLowerCase().includes(searchQuery)) ||
            (n.genre && n.genre.toLowerCase().includes(searchQuery)) ||
            (n.source && n.source.toLowerCase().includes(searchQuery))
          );
        }

        // Update list title text
        if (selectedGenres.size > 0 || excludedGenres.size > 0) {
          let parts = [];
          if (selectedGenres.size > 0) {
            parts.push(`matching ${Array.from(selectedGenres).join(", ")}`);
          }
          if (excludedGenres.size > 0) {
            parts.push(`excluding ${Array.from(excludedGenres).join(", ")}`);
          }
          titleEl.innerText = `Ingested Novels (${parts.join("; ")})`;
        } else if (selectedTerritory !== "All") {
          titleEl.innerText = `Ingested Novels in ${selectedTerritory}`;
        } else {
          titleEl.innerText = "Ingested Novels";
        }

        badgeEl.innerText = `${filtered.length} novel${filtered.length === 1 ? "" : "s"}`;
        populateNovelDropdown(filtered);
        currentNovelPage = 1;
        lastFilteredNovels = filtered;
        renderNovelsList(filtered);
      }

      let currentNovelPage = 1;
      const NOVELS_PER_PAGE = 8;
      let lastFilteredNovels = [];

      function renderNovelsList(novelsToRender) {
        const container = document.getElementById("novels-container");
        const paginationControls = document.getElementById("novelPaginationControls");
        const prevBtn = document.getElementById("novelPagePrev");
        const nextBtn = document.getElementById("novelPageNext");
        const indicator = document.getElementById("novelPageIndicator");

        if (!container) return;

        if (!novelsToRender || novelsToRender.length === 0) {
          container.innerHTML = `<p class="placeholder-text" style="padding: 1.5rem 1rem;">No matching novels found.</p>`;
          if (paginationControls) paginationControls.style.display = "none";
          return;
        }

        const totalNovels = novelsToRender.length;
        const totalPages = Math.max(1, Math.ceil(totalNovels / NOVELS_PER_PAGE));
        if (currentNovelPage > totalPages) currentNovelPage = totalPages;
        if (currentNovelPage < 1) currentNovelPage = 1;

        const startIndex = (currentNovelPage - 1) * NOVELS_PER_PAGE;
        const endIndex = Math.min(totalNovels, startIndex + NOVELS_PER_PAGE);
        const visibleNovels = novelsToRender.slice(startIndex, endIndex);

        container.innerHTML = "";
        visibleNovels.forEach(novel => {
          const card = document.createElement("div");
          card.className = `card-novel ${selectedNovelId === novel.id ? "active" : ""}`;
          card.setAttribute("data-novel-id", novel.id);
          card.addEventListener("click", () => selectNovel(novel.id, novel.title));

          const srcTag = novel.source === "gutenberg" ? "Gutenberg" : "Web Novel";

          card.innerHTML = `
            <div class="card__title">${novel.title}</div>
            <div class="card__meta">
              <span>${novel.author || "Unknown Author"}</span>
              <span class="card__source-tag" style="font-weight: 600;">${srcTag} (${novel.chapter_count || 1} ch)</span>
            </div>
          `;
          container.appendChild(card);
        });

        if (paginationControls) {
          if (totalPages > 1) {
            paginationControls.style.display = "inline-flex";
            if (indicator) indicator.innerText = `Page ${currentNovelPage} of ${totalPages}`;
            if (prevBtn) prevBtn.disabled = (currentNovelPage <= 1);
            if (nextBtn) nextBtn.disabled = (currentNovelPage >= totalPages);
          } else {
            paginationControls.style.display = "none";
          }
        }
      }

