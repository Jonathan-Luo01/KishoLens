---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="KishoLens Library & Visualizations — Explore prose archetypes, pacing metrics, dialogue ratios, and Kishōtenketsu sentiment arcs for web novels and classic literature."
    />
    <title>Library — KishoLens</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        min-height: 100vh;
      }

      .app-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .dashboard-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: 1.75rem;
        align-items: start;
      }

      @media (max-width: 950px) {
        .dashboard-layout {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* Territory Tabs Selector */
      .territory-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 0.35rem;
        flex-wrap: wrap;
      }

      .t-tab, .territory-tab {
        flex: 1 1 120px;
        background: transparent;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 0.75rem;
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background var(--transition), color var(--transition);
        text-align: center;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
      }

      .t-tab:hover, .territory-tab:hover { color: var(--color-text); }
      .t-tab.active, .territory-tab.active {
        background: var(--color-accent);
        color: #ffffff;
      }

      /* Explorer Cards & Sections */
      .explorer-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        min-width: 0;
      }

      .explorer-section {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .explorer-section:last-child {
        padding-bottom: 0;
        border-bottom: none;
      }

      .explorer-section-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text);
        letter-spacing: 0.02em;
      }

      .count-badge {
        background: rgba(124, 106, 255, 0.15);
        color: var(--color-accent);
        border: 1px solid rgba(124, 106, 255, 0.3);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.18rem 0.6rem;
        border-radius: 999px;
      }

      .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
      }

      .search-input-wrapper svg {
        position: absolute;
        left: 0.85rem;
        width: 16px;
        height: 16px;
        color: var(--color-muted);
        pointer-events: none;
      }

      .search-input-wrapper input {
        width: 100%;
        padding-left: 2.35rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        height: 40px;
        font-size: 0.85rem;
        color: var(--color-text);
        outline: none;
        transition: border-color var(--transition), box-shadow var(--transition);
      }

      .search-input-wrapper input:focus {
        border-color: var(--color-accent);
        box-shadow: 0 0 12px rgba(124, 106, 255, 0.15);
      }

      .territory-desc-card {
        background: rgba(124, 106, 255, 0.03);
        border: 1px dashed rgba(124, 106, 255, 0.25);
        border-radius: var(--radius);
        padding: 0.85rem 1rem;
        margin-bottom: 0;
        font-size: 0.82rem;
        line-height: 1.45;
        color: var(--color-muted);
      }

      /* Doppelgängers / Similar Novels Card Styles */
      .doppelganger-card {
        background: #0f172a;
        padding: 24px;
        border-radius: 16px;
        border: 1px solid #1e293b;
        display: flex;
        flex-direction: column;
        grid-column: 1 / -1;
        min-width: 0;
      }

      .doppelganger-title {
        margin: 0 0 4px 0;
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 600;
        color: #f8fafc;
      }

      .doppelganger-subtitle {
        color: #64748b;
        font-size: 13px;
        margin: 0 0 20px 0;
        line-height: 1.4;
      }

      .doppelganger-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      :global(.doppelganger-item) {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        background: #020617;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid #1e293b;
        transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
        cursor: pointer;
        min-width: 0;
      }

      :global(.doppelganger-item):hover {
        transform: translateX(4px);
        border-color: #334155;
        background: #090d1e;
      }

      :global(.doppelganger-left) {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 1;
        min-width: 0;
      }

      :global(.doppelganger-rank) {
        color: #475569;
        font-size: 18px;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
        min-width: 28px;
        flex-shrink: 0;
      }

      :global(.doppelganger-info) {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
      }

      :global(.doppelganger-item-title) {
        margin: 0;
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 600;
        color: #e2e8f0;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.doppelganger-author) {
        font-size: 12px;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.doppelganger-badge) {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 8px;
        background: #1e293b;
        color: #94a3b8;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        width: fit-content;
      }

      :global(.doppelganger-reasons) {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
      }

      :global(.reason-pill) {
        display: inline-flex;
        align-items: center;
        font-size: 11.5px;
        font-weight: 500;
        color: #c4b5fd;
        background: rgba(167, 139, 250, 0.10);
        border: 1px solid rgba(167, 139, 250, 0.28);
        border-radius: 6px;
        padding: 3px 8px;
        letter-spacing: 0.01em;
        line-height: 1.3;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
      }

      :global(.doppelganger-right) {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
        margin-left: 16px;
      }

      :global(.doppelganger-score) {
        font-size: 18px;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
      }

      :global(.doppelganger-progress-bg) {
        width: 80px;
        height: 4px;
        background: #1e293b;
        border-radius: 2px;
        overflow: hidden;
      }

      :global(.doppelganger-progress-fill) {
        height: 100%;
        border-radius: 2px;
        transition: width 0.4s ease-out;
      }

      :global(.doppelganger-breakdown) {
        display: flex;
        gap: 6px;
        margin-top: 4px;
      }

      :global(.doppelganger-factor) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
      }

      :global(.doppelganger-factor-label) {
        font-size: 8px;
        color: #64748b;
        font-weight: 600;
      }

      :global(.doppelganger-factor-bar-bg) {
        width: 16px;
        height: 2px;
        background: #1e293b;
        border-radius: 1px;
        overflow: hidden;
      }

      :global(.doppelganger-factor-bar-fill) {
        height: 100%;
        border-radius: 1px;
      }

      @media (max-width: 640px) {
        :global(.doppelganger-item) {
          flex-direction: column !important;
          align-items: flex-start !important;
          gap: 12px;
        }
        :global(.doppelganger-left) {
          width: 100%;
          min-width: 0;
        }
        :global(.doppelganger-right) {
          width: 100%;
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          margin-left: 0;
          padding-top: 10px;
          border-top: 1px solid rgba(255, 255, 255, 0.06);
        }
        :global(.doppelganger-breakdown) {
          margin-top: 0;
        }
        .controls-bar {
          flex-direction: column;
          align-items: stretch;
          gap: 0.85rem;
        }
        .selector-group {
          width: 100%;
          min-width: 0;
        }
        .baseline-group {
          width: 100%;
          justify-content: space-between;
        }
        .app-container {
          padding: 1.25rem 1rem 3rem 1rem;
        }
        .territory-tabs {
          display: flex;
          gap: 6px;
          overflow-x: auto;
          flex-wrap: nowrap;
          padding: 4px;
          background: rgba(255, 255, 255, 0.03);
          border-radius: 12px;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        }
        .territory-tabs::-webkit-scrollbar {
          display: none;
        }
        .territory-tab, .t-tab, .territory-tabs .t-tab, .territory-tabs .territory-tab {
          white-space: nowrap;
          flex: 1;
          text-align: center;
          padding: 8px 12px;
          font-size: 12px;
          border-radius: 8px;
        }
        .genre-checkboxes, .genre-checkbox-grid, #genre-checkboxes-container {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 6px 12px;
        }
        .explorer-card, .dashboard-card, .chart-card, .doppelganger-card, .card {
          padding: 1.25rem 1rem;
        }
      }

      @media (max-width: 480px) {
        .app-container {
          padding: 1rem 0.65rem 3rem 0.65rem;
        }
        .card, .chart-card, .doppelganger-card, .explorer-card, .dashboard-card {
          padding: 1.25rem 1rem;
        }
      }

      .section-title {
        font-family: var(--font-display);
        font-size: 1.05rem;
        margin: 1rem 0 0.6rem 0;
        color: var(--color-text);
      }

      /* Genre Checkboxes Grid */
      /* Genre Checkboxes Grid & Helper Tips */
      .genre-help-tips {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
      }

      .tip-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 500;
        user-select: none;
      }

      .tip-badge.tip-include {
        background: rgba(34, 197, 94, 0.12);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.25);
      }

      .tip-badge.tip-exclude {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.25);
      }

      .btn-reset-filters {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.6);
        border-radius: 6px;
        padding: 0.2rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-reset-filters:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
      }

      .genre-checkbox-grid, .genre-checkboxes {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .genre-checkbox-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.45rem 0.7rem;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        font-size: 0.84rem;
        font-weight: 500;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s, border-color 0.15s;
      }

      .genre-checkbox-item:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(124, 106, 255, 0.4);
        color: #ffffff;
      }

      .genre-checkbox-item.included {
        background: rgba(124, 106, 255, 0.12);
        border-color: rgba(124, 106, 255, 0.4);
        color: #ffffff;
      }

      :global(.genre-checkbox-item.excluded) {
        background: rgba(220, 38, 38, 0.22) !important;
        border-color: #ef4444 !important;
        color: #fca5a5 !important;
        box-shadow: 0 0 8px rgba(220, 38, 38, 0.35) !important;
      }

      :global(.genre-checkbox-item.excluded .genre-name-text) {
        text-decoration: line-through !important;
        color: #f87171 !important;
        font-weight: 600 !important;
      }

      .real-genre-checkbox {
        appearance: auto;
        -webkit-appearance: checkbox;
        width: 16px;
        height: 16px;
        accent-color: var(--color-accent);
        cursor: pointer;
        flex-shrink: 0;
        margin: 0;
      }

      :global(.x-mark-box) {
        width: 16px !important;
        height: 16px !important;
        border-radius: 3px !important;
        background: #dc2626 !important;
        border: 1px solid #f87171 !important;
        color: #ffffff !important;
        font-size: 10px !important;
        font-weight: 900 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex-shrink: 0 !important;
        line-height: 1 !important;
        box-shadow: 0 0 6px rgba(220, 38, 38, 0.6) !important;
        margin: 0 !important;
      }

      /* Card novel styling */
      .card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        backdrop-filter: blur(12px);
      }

      .card-novel {
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 0.85rem 1rem;
        transition: transform var(--transition), border-color var(--transition), background var(--transition);
      }

      .card-novel:hover {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(124, 106, 255, 0.3);
      }

      .card-novel.active {
        background: rgba(124, 106, 255, 0.08);
        border-color: var(--color-accent);
        box-shadow: 0 0 15px rgba(124, 106, 255, 0.15);
      }

      .card__title {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
      }

      .card__meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      .novel-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        max-height: 280px;
        overflow-y: auto;
        padding-right: 0.35rem;
      }

      /* Scrollbar styling */
      .novel-list::-webkit-scrollbar, .stats-content-scroll::-webkit-scrollbar {
        width: 6px;
      }
      .novel-list::-webkit-scrollbar-thumb, .stats-content-scroll::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.12);
        border-radius: 4px;
      }

      /* Stats panel styling */
      .stats-panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .stats-content-scroll {
        max-height: 520px;
        overflow-y: auto;
        padding-right: 0.35rem;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.65rem;
      }

      .stat-item {
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.65rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .stat-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
      }

      .stat-value {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-accent-2);
      }

      /* Enhanced Metrics Dashboard Component Styles */
      :global(.metrics-dashboard) {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      :global(.metrics-hero) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.6rem;
        background: rgba(124, 106, 255, 0.05);
        border: 1px solid rgba(124, 106, 255, 0.2);
        border-radius: 10px;
        padding: 0.85rem;
      }

      :global(.hero-chip) {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      :global(.hero-chip-label) {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
      }

      :global(.hero-chip-val) {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: #ffffff;
      }

      :global(.metrics-category-tabs) {
        display: flex;
        gap: 0.4rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
      }

      :global(.category-tab) {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-muted);
        border-radius: 20px;
        padding: 0.3rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
      }

      :global(.category-tab:hover), :global(.category-tab.active) {
        background: rgba(124, 106, 255, 0.18);
        border-color: rgba(124, 106, 255, 0.5);
        color: #ffffff;
      }

      :global(.metric-category-section) {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      :global(.category-section-title) {
        font-family: var(--font-display);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.4rem;
      }

      :global(.category-section-title.cat-structure) { color: #38bdf8; }
      :global(.category-section-title.cat-prose)     { color: #a78bfa; }
      :global(.category-section-title.cat-theme)     { color: #f472b6; }
      :global(.category-section-title.cat-pacing)    { color: #34d399; }

      :global(.metric-card-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 0.6rem;
      }

      :global(.metric-card) {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.65rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        position: relative;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-card:hover) {
        border-color: rgba(124, 106, 255, 0.3);
        transform: translateY(-1px);
      }

      :global(.metric-card-header) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
      }

      :global(.metric-info-icon) {
        font-size: 0.72rem;
        color: var(--color-accent-2);
        cursor: pointer;
        opacity: 0.8;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(124, 106, 255, 0.12);
        border: 1px solid rgba(124, 106, 255, 0.25);
        user-select: none;
      }

      :global(.metric-info-icon:hover), :global(.metric-info-icon.active) {
        opacity: 1.0;
        transform: scale(1.12);
        background: rgba(124, 106, 255, 0.3);
        border-color: var(--color-accent);
        color: #ffffff;
      }

      :global(.metric-tooltip-box) {
        position: absolute;
        bottom: 125%;
        right: 0;
        background: #0f172a;
        border: 1px solid rgba(124, 106, 255, 0.4);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 12px rgba(124, 106, 255, 0.25);
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        font-size: 0.73rem;
        color: #e2e8f0;
        line-height: 1.45;
        width: 220px;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-tooltip-box.visible),
      :global(.metric-info-icon:hover + .metric-tooltip-box) {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      :global(.metric-val-row) {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.4rem;
      }

      :global(.metric-primary-val) {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: #f8fafc;
      }

      :global(.percentile-bar-bg) {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 2px;
        overflow: hidden;
      }

      :global(.percentile-bar-fill) {
        height: 100%;
        border-radius: 2px;
        transition: width 0.4s ease-out;
      }

      :global(.bar-fill-structure) { background: linear-gradient(90deg, #0284c7, #38bdf8); }
      :global(.bar-fill-prose)     { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
      :global(.bar-fill-theme)     { background: linear-gradient(90deg, #db2777, #f472b6); }
      :global(.bar-fill-pacing)    { background: linear-gradient(90deg, #059669, #34d399); }

      :global(.benchmark-chip) {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 600;
        width: fit-content;
      }

      :global(.benchmark-chip.higher) {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
      }

      :global(.benchmark-chip.lower) {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      :global(.benchmark-chip.neutral) {
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
        border: 1px solid rgba(148, 163, 184, 0.2);
      }

      :global(.metric-baseline-row) {
        display: flex;
        gap: 0.55rem;
        margin-top: 0.2rem;
        flex-wrap: wrap;
      }

      :global(.metric-baseline-item) {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.63rem;
        color: rgba(255,255,255,0.45);
      }

      :global(.metric-baseline-dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      /* Form inputs */
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 0.85rem;
      }

      label {
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--color-text);
      }

      input[type="text"], input[type="number"] {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.55rem 0.75rem;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 0.85rem;
        outline: none;
        transition: border-color var(--transition);
      }

      input[type="text"]:focus, input[type="number"]:focus {
        border-color: var(--color-accent);
      }

      .placeholder-text {
        color: var(--color-muted);
        text-align: center;
        padding: 2.5rem 1rem;
        font-style: italic;
        font-size: 0.88rem;
      }

      /* Controls Bar & Charts */
      .controls-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        align-items: center;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 1rem;
        padding: 1rem 1.25rem;
      }

      .selector-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: 1;
        min-width: 220px;
      }

      .selector-group label {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
      }

      select#novelSelect {
        flex: 1;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 0.5rem;
        color: #e2e2f0;
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.45rem 0.75rem;
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s;
        min-width: 0;
        width: 100%;
      }

      select#novelSelect:focus { border-color: #a78bfa; }

      .baseline-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
        flex-wrap: wrap;
      }

      .baseline-group span {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .baseline-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 0.5rem;
        color: rgba(255,255,255,0.6);
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.45rem 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .baseline-btn:hover { color: #e2e2f0; border-color: rgba(255,255,255,0.25); }
      .baseline-btn.active[data-baseline="web_novel"] {
        background: rgba(167,139,250,0.18);
        border-color: #a78bfa;
        color: #c4b5fd;
      }
      .baseline-btn.active[data-baseline="classic_lit"] {
        background: rgba(251,191,36,0.18);
        border-color: #fbbf24;
        color: #fde68a;
      }

      .charts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.5rem;
      }

      @media (max-width: 900px) {
        .charts-grid { grid-template-columns: minmax(0, 1fr); }
      }

      .chart-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        min-width: 0;
      }

      .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .chart-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
      }

      .chart-legend {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.5);
      }

      .legend-item { display: flex; align-items: center; gap: 0.4rem; }
      .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
      .legend-dot.user { background: #7dd3fc; }
      .legend-dot.wn { background: #a78bfa; }
      .legend-dot.baseline { background: #a78bfa; }

      #radarChart {
        width: 100%;
        aspect-ratio: 1 / 1;
        max-width: 480px;
        margin: 0 auto;
        display: block;
        cursor: crosshair;
        image-rendering: crisp-edges;
      }

      svg#arcChart {
        width: 100%;
        height: auto;
        aspect-ratio: 600 / 420;
        display: block;
        cursor: crosshair;
      }

      .archetype-label {
        text-align: center;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
        font-style: italic;
      }

      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }

      .status-spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(124, 106, 255, 0.2);
        border-top-color: var(--color-accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
        margin-top: 2px;
      }

      .status-icon--success {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.2);
        color: rgb(52, 211, 153);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
        flex-shrink: 0;
      }

      .status-icon--error {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(239, 68, 68, 0.2);
        color: rgb(248, 113, 113);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
        flex-shrink: 0;
      }

      .status-pill {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.18rem 0.5rem;
        border-radius: 999px;
      }

      .status-pill--running {
        background: rgba(124, 106, 255, 0.15);
        color: var(--color-accent);
        border: 1px solid rgba(124, 106, 255, 0.3);
      }

      .status-pill--completed {
        background: rgba(16, 185, 129, 0.15);
        color: rgb(52, 211, 153);
        border: 1px solid rgba(16, 185, 129, 0.3);
      }

      .status-pill--failed {
        background: rgba(239, 68, 68, 0.15);
        color: rgb(248, 113, 113);
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      /* Hover Tooltips for Charts */
      .radar-tooltip {
        position: fixed;
        pointer-events: none;
        background: rgba(10, 10, 18, 0.95);
        border: 1px solid rgba(124, 106, 255, 0.35);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        font-size: 0.8rem;
        z-index: 1000;
        display: none;
      }
      .radar-tooltip-title {
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.35rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding-bottom: 0.25rem;
      }
      .radar-tooltip-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.2rem;
      }
      .radar-tooltip-val {
        font-family: var(--font-display);
        font-weight: 600;
      }

      /* Database Statistics Overview - Impeccable Clean Styling */
      :global(.db-stats-card) {
        background: rgba(18, 18, 30, 0.75);
        border: 1px solid rgba(124, 106, 255, 0.18);
        border-radius: 12px;
        padding: 1.15rem;
        backdrop-filter: blur(12px);
      }

      :global(.db-kpi-grid) {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
        margin-bottom: 0.85rem;
      }

      :global(.db-kpi-tile) {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 0.55rem 0.7rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      :global(.db-kpi-tile:hover) {
        border-color: rgba(124, 106, 255, 0.35);
        background: rgba(124, 106, 255, 0.04);
      }

      :global(.db-kpi-val) {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
      }

      :global(.db-kpi-lbl) {
        font-size: 0.68rem;
        color: var(--color-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.15rem;
      }

      :global(.db-source-chip) {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 6px;
        padding: 0.22rem 0.55rem;
        font-size: 0.74rem;
        color: rgba(255, 255, 255, 0.85);
        transition: all 0.2s ease;
      }
      :global(.db-source-chip:hover) {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
      }
      :global(.db-source-dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
      }

      :global(.db-genre-chip) {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.4rem;
        background: rgba(124, 106, 255, 0.05);
        border: 1px solid rgba(124, 106, 255, 0.12);
        border-radius: 6px;
        padding: 0.22rem 0.5rem;
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.8);
        transition: all 0.18s ease;
      }
      :global(.db-genre-chip:hover) {
        border-color: rgba(124, 106, 255, 0.4);
        background: rgba(124, 106, 255, 0.12);
        color: #ffffff;
      }
      :global(.db-genre-count) {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        padding: 0.05rem 0.3rem;
        font-size: 0.65rem;
        font-weight: 700;
        color: #a78bfa;
      }

      /* ── Skeleton Loading UI & Shimmer Keyframes ── */
      @keyframes skeleton-shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
      }

      @keyframes skeleton-pulse-glow {
        0%, 100% {
          border-color: rgba(148, 163, 184, 0.12);
          box-shadow: 0 0 0 0 rgba(6, 182, 212, 0);
        }
        50% {
          border-color: rgba(6, 182, 212, 0.35);
          box-shadow: 0 0 20px rgba(6, 182, 212, 0.10);
        }
      }

      @keyframes pulse-dot {
        0%, 100% { transform: scale(1); opacity: 0.8; }
        50% { transform: scale(1.3); opacity: 1; }
      }

      .skeleton-shimmer,
      :global(.skeleton-shimmer) {
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.03) 0%,
          rgba(255, 255, 255, 0.09) 50%,
          rgba(255, 255, 255, 0.03) 100%
        );
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.8s infinite ease-in-out;
      }

      .skeleton-progress-container,
      :global(.skeleton-progress-container) {
        width: 100%;
        margin-bottom: 1.25rem;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        backdrop-filter: blur(12px);
      }

      .skeleton-progress-bar-bg,
      :global(.skeleton-progress-bar-bg) {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 999px;
        overflow: hidden;
        margin-top: 0.75rem;
      }

      .skeleton-progress-bar-fill,
      :global(.skeleton-progress-bar-fill) {
        height: 100%;
        width: 15%;
        background: linear-gradient(90deg, #0284c7, #38bdf8);
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
        border-radius: 999px;
        transition: width 0.4s ease-out;
      }

      .skeleton-stage-header,
      :global(.skeleton-stage-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .skeleton-stage-pill,
      :global(.skeleton-stage-pill) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 600;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.25);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
      }

      .skeleton-stage-dot,
      :global(.skeleton-stage-dot) {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        animation: pulse-dot 1.2s infinite ease-in-out;
      }

      .skeleton-card,
      :global(.skeleton-card) {
        background: rgba(15, 23, 42, 0.45);
        border: 1px solid rgba(148, 163, 184, 0.1);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .skeleton-chart-frame,
      :global(.skeleton-chart-frame) {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 14px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        animation: skeleton-pulse-glow 3s infinite ease-in-out;
      }

      .fade-in-content,
      :global(.fade-in-content) {
        animation: fadeIn 0.35s ease-out forwards;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 640px) {
        .territory-tabs {
          display: flex !important;
          gap: 6px !important;
          overflow-x: auto !important;
          flex-wrap: nowrap !important;
          padding: 4px !important;
          background: rgba(255, 255, 255, 0.03) !important;
          border-radius: 12px !important;
          scrollbar-width: none !important;
          -webkit-overflow-scrolling: touch !important;
          width: 100% !important;
        }
        .territory-tabs::-webkit-scrollbar {
          display: none !important;
        }
        .t-tab, .territory-tab, .territory-tabs .t-tab, .territory-tabs .territory-tab {
          white-space: nowrap !important;
          flex: 1 0 auto !important;
          text-align: center !important;
          padding: 8px 14px !important;
          font-size: 12px !important;
          border-radius: 8px !important;
        }
        .genre-checkbox-grid, .genre-checkboxes, #genre-checkboxes-container {
          display: grid !important;
          grid-template-columns: 1fr 1fr !important;
          gap: 6px 10px !important;
        }
        .genre-checkbox-item {
          padding: 0.4rem 0.5rem !important;
          font-size: 0.76rem !important;
          gap: 0.4rem !important;
        }
        .app-container {
          padding: 1rem 0.75rem 3rem 0.75rem !important;
        }
        .explorer-card, .dashboard-card, .chart-card, .doppelganger-card, .card {
          padding: 1.25rem 1rem !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="app-container">
      <header class="site-header">
        <a href="/" class="brand-title">Kish<span>o</span>Lens</a>
        <nav class="site-nav">
          <a href="/analyze"><span class="nav-text-full">Analyze Prose</span><span class="nav-text-short">Analyze</span></a>
          <a href="/library" class="active">Library</a>
        </nav>
      </header>

      <!-- 1. Top Section: Library Explorer (Left) + Stylistic Stats & Ingest Form (Right) -->
      <div class="dashboard-layout">
        <!-- Left Side: Clean Card for Search, Filters, and Novel Explorer -->
        <div class="card explorer-card">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <h2 style="font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; margin: 0;">Library & Prose Explorer</h2>
            <span class="count-badge" id="novel-count-badge">Loading...</span>
          </div>

          <!-- Section 1: Search & Territory Selection -->
          <div class="explorer-section">
            <div class="explorer-section-title">
              <span>Search & Territory</span>
            </div>

            <!-- Search Input with Icon -->
            <div class="search-input-wrapper">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="novel-search-input"
                placeholder="Search by title, author, genre, or dataset..."
              />
            </div>

            <!-- Territory Selector Tabs -->
            <div class="territory-tabs" id="territory-selector" style="margin-top: 0.4rem; margin-bottom: 0;">
              <button class="t-tab active" data-territory="All" onclick="selectTerritory('All')">All Genres</button>
              <button class="t-tab" data-territory="Classic Literature Territory" onclick="selectTerritory('Classic Literature Territory')">Classic Literature Territory</button>
              <button class="t-tab" data-territory="Web Novel Territory" onclick="selectTerritory('Web Novel Territory')">Web Novel Territory</button>
            </div>

            <!-- Active Territory Description -->
            <div class="territory-desc-card" id="territory-description" style="margin-bottom: 0;">
              Explore prose archetypes, pacing metrics, and structural profiles across all ingested literature.
            </div>
          </div>

          <!-- Section 2: Prose Genre Filters -->
          <div class="explorer-section">
            <div class="explorer-section-title" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
              <span>Filter by Prose Genre</span>
              <div class="genre-help-tips">
                <span class="tip-badge tip-include">Click to Select</span>
                <span class="tip-badge tip-exclude">✕ Double-Click to Exclude</span>
                <button type="button" class="btn-reset-filters" onclick="resetGenreFilters()">Reset All</button>
              </div>
            </div>
            <div class="genre-checkbox-grid" id="genre-checkboxes-container">
              <div class="placeholder-text" style="padding: 0.5rem 0; grid-column: 1 / -1;">Loading genres...</div>
            </div>
          </div>

          <!-- Section 3: Ingested Novels List -->
          <div class="explorer-section">
            <div class="explorer-section-title">
              <span id="novels-list-title">Ingested Novels</span>
            </div>
            <div class="novel-list" id="novels-container">
              <div class="placeholder-text">Loading library novels...</div>
            </div>
          </div>
        </div>

        <!-- Right Side: Stats & Ingest Control -->
        <div class="stats-panel">
          <!-- Stats Viewer -->
          <div class="card" id="stats-container">
            <h3 style="font-family: var(--font-display); font-size: 1.15rem; margin-bottom: 0.75rem;" id="novel-details-title">Stylistic Analysis</h3>
            <div id="stats-content" class="stats-content-scroll">
