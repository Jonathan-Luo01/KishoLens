      function renderEnhancedMetricsDashboard(stats) {
        const keys = Object.keys(stats);
        const langPrefix = keys.some(k => k.startsWith("ja_")) ? "ja_" :
                           keys.some(k => k.startsWith("zh_")) ? "zh_" : "en_";

        const normRadar = stats.normalized_radar || {};
        const wnRadar   = stats.baselines?.radar?.web_novel   || [];
        const clRadar   = stats.baselines?.radar?.classic_lit || [];

        // 1. Hero Summary Header (Honest rendering of computed metrics)
        const archetypeLabel = stats.archetype_match?.closest_trope || stats.archetype || stats.genre || "Unknown";
        const territoryLabel = stats.archetype_match?.territory || stats.territory || "Unknown Territory";
        const rawWordCount = stats[`${langPrefix}word_count`] || stats[`${langPrefix}char_count`] || stats.en_word_count || stats.ja_char_count || stats.word_count;
        const wordCount = rawWordCount !== undefined && rawWordCount !== null ? rawWordCount : 0;
        const ttrVal = stats[`${langPrefix}ttr`] || stats.en_ttr || stats.ja_ttr || stats.ttr;

        const heroHtml = `
          <div class="metrics-hero">
            <div class="hero-chip">
              <span class="hero-chip-label">Archetype</span>
              <span class="hero-chip-val" style="color: #a78bfa;">${archetypeLabel}</span>
            </div>
            <div class="hero-chip">
              <span class="hero-chip-label">Territory</span>
              <span class="hero-chip-val" style="color: #38bdf8;">${territoryLabel}</span>
            </div>
            <div class="hero-chip">
              <span class="hero-chip-label">Word Count</span>
              <span class="hero-chip-val">${wordCount > 0 ? Math.round(wordCount).toLocaleString() : '0'}</span>
            </div>
            <div class="hero-chip">
              <span class="hero-chip-label">Lexical Richness</span>
              <span class="hero-chip-val" style="color: #34d399;">${typeof ttrVal === "number" ? ttrVal.toFixed(2) : (ttrVal || 'N/A')}</span>
            </div>
          </div>
        `;

        // 2. Metric Categories
        const categories = [
          { id: "structure", label: "Structure", title: "Structure & Volume", class: "cat-structure", barClass: "bar-fill-structure" },
          { id: "prose", label: "Prose", title: "Prose & Style", class: "cat-prose", barClass: "bar-fill-prose" },
          { id: "theme", label: "Theme", title: "Theme & Emotion", class: "cat-theme", barClass: "bar-fill-theme" },
          { id: "pacing", label: "Pacing", title: "Pacing & Narrative", class: "cat-pacing", barClass: "bar-fill-pacing" }
        ];

        let allCardsHtml = "";
        let totalCardsCount = 0;
        const catCounts = { structure: 0, prose: 0, theme: 0, pacing: 0 };

        categories.forEach(cat => {
          Object.keys(METRIC_METADATA).forEach(key => {
            const meta = METRIC_METADATA[key];
            if (meta.category !== cat.id) return;

            const rawKey = `${langPrefix}${key}`;
            let rawVal = stats[rawKey] !== undefined ? stats[rawKey] : stats[key];
            if (rawVal === undefined || rawVal === null) {
              rawVal = stats[`en_${key}`] ?? stats[`ja_${key}`] ?? stats[`zh_${key}`] ?? stats[key];
            }
            if (rawVal === undefined || rawVal === null) return;

            const normScore = normRadar[rawKey] !== undefined ? normRadar[rawKey] :
                              normRadar[key] !== undefined ? normRadar[key] :
                              normRadar[`en_${key}`] !== undefined ? normRadar[`en_${key}`] :
                              normRadar[`ja_${key}`] !== undefined ? normRadar[`ja_${key}`] : 0.50;

            catCounts[cat.id]++;
            totalCardsCount++;
            const cardIdx = totalCardsCount;

            let displayVal = meta.isPercent ? `${(rawVal * 100).toFixed(1)}%` :
                             meta.isInteger ? Math.round(rawVal).toLocaleString() :
                             typeof rawVal === 'number' ? (rawVal % 1 !== 0 ? rawVal.toFixed(2) : rawVal.toString()) : rawVal;

            const pctWidth = Math.min(100, Math.max(0, Math.round(normScore * 100)));

            // Benchmark comparison chip
            let benchChipHtml = "";
            if (normScore >= 0.65) {
              benchChipHtml = `<span class="benchmark-chip higher">High (+${Math.round((normScore - 0.5) * 100)}%)</span>`;
            } else if (normScore <= 0.35) {
              benchChipHtml = `<span class="benchmark-chip lower">Low (-${Math.round((0.5 - normScore) * 100)}%)</span>`;
            } else {
              benchChipHtml = `<span class="benchmark-chip neutral">Balanced</span>`;
            }

            // Web Novel / Classic Lit baseline comparison row for ALL metrics
            let baselineRowHtml = "";
            const baseInfo = ALL_METRIC_BASELINES[key];
            if (baseInfo) {
              let wnVal = baseInfo.wn;
              let clVal = baseInfo.cl;
              if (baseInfo.radarIdx !== undefined) {
                if (wnRadar[baseInfo.radarIdx] !== undefined) wnVal = wnRadar[baseInfo.radarIdx];
                if (clRadar[baseInfo.radarIdx] !== undefined) clVal = clRadar[baseInfo.radarIdx];
              }
              if (wnVal !== undefined || clVal !== undefined) {
                baselineRowHtml = `<div class="metric-baseline-row">`;
                if (wnVal !== undefined) {
                  const wnPct = Math.round(wnVal * 100);
                  baselineRowHtml += `
                    <span class="metric-baseline-item">
                      <span class="metric-baseline-dot" style="background:#a78bfa;"></span>
                      WN: ${wnPct}%
                    </span>`;
                }
                if (clVal !== undefined) {
                  const clPct = Math.round(clVal * 100);
                  baselineRowHtml += `
                    <span class="metric-baseline-item">
                      <span class="metric-baseline-dot" style="background:#fbbf24;"></span>
                      CL: ${clPct}%
                    </span>`;
                }
                baselineRowHtml += `</div>`;
              }
            }

            allCardsHtml += `
              <div class="metric-card" data-category="${cat.id}" data-card-index="${cardIdx}">
                <div class="metric-card-header">
                  <span class="metric-card-cat-badge ${cat.class}">${cat.label}</span>
                  <span class="metric-info-icon" role="button" aria-label="${meta.tooltip}">ⓘ</span>
                  <div class="metric-tooltip-box">${meta.tooltip}</div>
                </div>
                <span class="metric-card-label" style="font-size: 0.78rem; font-weight: 600; color: var(--color-text); margin-top: 0.1rem;">${meta.label}</span>
                <div class="metric-val-row">
                  <span class="metric-primary-val">${displayVal}</span>
                  ${benchChipHtml}
                </div>
                <div class="percentile-bar-bg">
                  <div class="percentile-bar-fill ${cat.barClass}" style="width: ${pctWidth}%;"></div>
                </div>
                ${baselineRowHtml}
              </div>
            `;
          });
        });

        // Category tabs with live counts and horizontal carousel controls
        const tabsHtml = `
          <div class="metrics-carousel-header">
            <div class="metrics-category-tabs">
              <button class="category-tab active" data-cat="all">All <span class="category-tab-badge">${totalCardsCount}</span></button>
              <button class="category-tab" data-cat="structure">Structure <span class="category-tab-badge">${catCounts.structure}</span></button>
              <button class="category-tab" data-cat="prose">Prose <span class="category-tab-badge">${catCounts.prose}</span></button>
              <button class="category-tab" data-cat="theme">Theme <span class="category-tab-badge">${catCounts.theme}</span></button>
              <button class="category-tab" data-cat="pacing">Pacing <span class="category-tab-badge">${catCounts.pacing}</span></button>
            </div>
            <div class="metrics-carousel-nav">
              <button class="carousel-nav-btn" id="metricsCarouselPrev" aria-label="Scroll left" title="Scroll left">‹</button>
              <span class="carousel-indicator-pill" id="metricsCarouselIndicator">1–3 of ${totalCardsCount}</span>
              <button class="carousel-nav-btn" id="metricsCarouselNext" aria-label="Scroll right" title="Scroll right">›</button>
            </div>
          </div>
        `;

        return `
          <div class="metrics-dashboard">
            ${heroHtml}
            ${tabsHtml}
            <div class="metrics-carousel-track-wrapper">
              <div class="metrics-carousel-track" id="metricsCarouselTrack">
                ${allCardsHtml}
              </div>
            </div>
          </div>
        `;
      }

