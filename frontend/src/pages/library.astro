              <!-- Top Parent Genres Breakdown Chips -->
              <div>
                <h4 style="font-size: 0.72rem; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.45rem;">Genre Distribution</h4>
                <div id="db-genres-badges" style="display: flex; flex-wrap: wrap; gap: 0.35rem; max-height: 140px; overflow-y: auto; padding-right: 4px;">
                  <span class="db-genre-chip">Action / Adventure <span class="db-genre-count">485</span></span>
