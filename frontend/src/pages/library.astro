          </div>

          <!-- Ingestion Status Loading Card -->
          <div class="card" id="ingest-status-card" style="display: none;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
              <h4 style="font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; margin: 0;">Ingestion Status</h4>
              <span id="ingest-status-badge" class="status-pill status-pill--running">Processing</span>
            </div>
            
            <div style="display: flex; align-items: flex-start; gap: 0.75rem; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); padding: 0.75rem 0.85rem; border-radius: 8px;">
              <div id="ingest-status-icon" class="status-spinner"></div>
              <div style="flex: 1; min-width: 0;">
                <div id="ingest-status-dataset" style="font-size: 0.82rem; font-weight: 600; color: var(--color-text); word-break: break-all;"></div>
                <div id="ingest-status-message" style="font-size: 0.78rem; color: var(--color-muted); margin-top: 0.15rem;">Fetching and indexing records...</div>
