                  <span class="db-genre-chip">Progression Fantasy <span class="db-genre-count">367</span></span>
                  <span class="db-genre-chip">Historical <span class="db-genre-count">120</span></span>
                  <span class="db-genre-chip">Drama <span class="db-genre-count">108</span></span>
                  <span class="db-genre-chip">Isekai <span class="db-genre-count">41</span></span>
                  <span class="db-genre-chip">Slice of Life <span class="db-genre-count">19</span></span>
                  <span class="db-genre-chip">Mystery <span class="db-genre-count">13</span></span>
