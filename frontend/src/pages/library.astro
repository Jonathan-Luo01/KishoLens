---
import "../styles/global.css";
import { ClientRouter } from 'astro:transitions';
const publicApiUrl = import.meta.env.PUBLIC_API_URL || "";
---

<html lang="en">
  <head>
    <script is:inline define:vars={{ publicApiUrl }}>
      if (publicApiUrl) {
        window.__PUBLIC_API_URL__ = publicApiUrl;
      }
    </script>
    <script is:inline>
      (function() {
        function getTheme() {
          try {
            var stored = localStorage.getItem('kisholens-theme');
            return stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          } catch (e) {
            return 'dark';
          }
        }
        function applyTheme(targetDoc) {
          var d = targetDoc || document;
          if (d && d.documentElement) {
            d.documentElement.setAttribute('data-theme', getTheme());
          }
        }
        applyTheme();
        document.addEventListener('astro:before-swap', function(e) {
          if (e && e.newDocument) applyTheme(e.newDocument);
        });
        document.addEventListener('astro:after-swap', function() {
          applyTheme();
        });
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="KishoLens Library & Visualizations — Explore prose archetypes, pacing metrics, dialogue ratios, and Kishōtenketsu sentiment arcs for web novels and classic literature."
    />
    <title>Library — KishoLens</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Kaisei+Tokumin:wght@500;700;800&family=Shippori+Mincho:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        padding: 0;
        background: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        min-height: 100vh;
      }

      .app-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .dashboard-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: 1.75rem;
        align-items: stretch;
      }

      @media (max-width: 950px) {
        .dashboard-layout {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* Territory Tabs Selector */
      .territory-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.85rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 0.35rem;
        flex-wrap: wrap;
      }

      .t-tab, .territory-tab {
        flex: 1 1 120px;
        background: transparent;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 0.75rem;
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: background var(--transition), color var(--transition);
        text-align: center;
        white-space: nowrap;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
      }

      .t-tab:hover, .territory-tab:hover { color: var(--color-text); }
      .t-tab.active, .territory-tab.active {
        background: var(--color-accent);
        color: #ffffff;
      }

      /* Explorer Cards & Sections */
      .explorer-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        min-width: 0;
        min-height: 100%;
        box-sizing: border-box;
      }

      .explorer-section {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .explorer-novels-section {
        flex: 1 1 0;
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding-bottom: 0;
        border-bottom: none;
      }

      .explorer-section:last-child {
        padding-bottom: 0;
        border-bottom: none;
      }

      .explorer-section-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-sans);
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--color-text);
        letter-spacing: 0.02em;
      }

      .count-badge {
        background: rgba(124, 106, 255, 0.15);
        color: var(--color-accent);
        border: 1px solid rgba(124, 106, 255, 0.3);
        font-size: 0.72rem;
        font-weight: 600;
        padding: 0.18rem 0.6rem;
        border-radius: 999px;
      }

      .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
      }

      .search-input-wrapper svg {
        position: absolute;
        left: 0.85rem;
        width: 16px;
        height: 16px;
        color: var(--color-muted);
        pointer-events: none;
      }

      .search-input-wrapper input {
        width: 100%;
        padding-left: 2.35rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-border);
        border-radius: 10px;
        height: 40px;
        font-size: 0.85rem;
        color: var(--color-text);
        outline: none;
        transition: border-color var(--transition), box-shadow var(--transition);
      }

      .search-input-wrapper input:focus {
        border-color: var(--color-accent);
        box-shadow: 0 0 12px rgba(124, 106, 255, 0.15);
      }

      .territory-desc-card {
        background: rgba(124, 106, 255, 0.03);
        border: 1px dashed rgba(124, 106, 255, 0.25);
        border-radius: var(--radius);
        padding: 0.85rem 1rem;
        margin-bottom: 0;
        font-size: 0.82rem;
        line-height: 1.45;
        color: var(--color-muted);
      }

      /* Doppelgängers / Similar Novels Card Styles */
      .doppelganger-card {
        background: #0f172a;
        padding: 24px;
        border-radius: 16px;
        border: 1px solid #1e293b;
        display: flex;
        flex-direction: column;
        grid-column: 1 / -1;
        min-width: 0;
      }

      .doppelganger-title {
        margin: 0 0 4px 0;
        font-family: var(--font-display);
        font-size: 18px;
        font-weight: 600;
        color: #f8fafc;
      }

      .doppelganger-subtitle {
        color: #64748b;
        font-size: 13px;
        margin: 0 0 20px 0;
        line-height: 1.4;
      }

      .doppelganger-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      :global(.doppelganger-item) {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        background: #020617;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid #1e293b;
        transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
        cursor: pointer;
        min-width: 0;
      }

      :global(.doppelganger-main) {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        min-width: 0;
      }

      :global(.doppelganger-item):hover {
        transform: translateX(4px);
        border-color: #334155;
        background: #090d1e;
      }

      :global(.doppelganger-left) {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 1;
        min-width: 0;
      }

      :global(.doppelganger-rank) {
        color: #475569;
        font-size: 18px;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
        min-width: 28px;
        flex-shrink: 0;
      }

      :global(.doppelganger-info) {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
      }

      :global(.doppelganger-item-title) {
        margin: 0;
        font-family: var(--font-display);
        font-size: 16px;
        font-weight: 600;
        color: #e2e8f0;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.doppelganger-author) {
        font-size: 12px;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.doppelganger-badge) {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 8px;
        background: #1e293b;
        color: #94a3b8;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        width: fit-content;
      }

      :global(.doppelganger-reasons) {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
      }

      :global(.reason-pill) {
        display: inline-flex;
        align-items: center;
        font-size: 11.5px;
        font-weight: 500;
        color: #c4b5fd;
        background: rgba(167, 139, 250, 0.10);
        border: 1px solid rgba(167, 139, 250, 0.28);
        border-radius: 6px;
        padding: 3px 8px;
        letter-spacing: 0.01em;
        line-height: 1.3;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
      }

      :global(.doppelganger-right) {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
        margin-left: 16px;
      }

      :global(.doppelganger-scores-dual) {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }

      :global(.doppelganger-score-chip) {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4px 10px;
        border-radius: 8px;
        min-width: 62px;
        box-sizing: border-box;
      }

      :global(.doppelganger-score-chip.story) {
        background: rgba(99, 102, 241, 0.12);
        border: 1px solid rgba(99, 102, 241, 0.35);
      }

      :global(.doppelganger-score-chip.story .score-chip-label) {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #a5b4fc;
      }

      :global(.doppelganger-score-chip.story .score-chip-val) {
        font-size: 15px;
        font-weight: 800;
        color: #c7d2fe;
        line-height: 1.1;
      }

      :global(.doppelganger-score-chip.style) {
        background: rgba(56, 189, 248, 0.08);
        border: 1px solid rgba(56, 189, 248, 0.25);
      }

      :global(.doppelganger-score-chip.style .score-chip-label) {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #7dd3fc;
      }

      :global(.doppelganger-score-chip.style .score-chip-val) {
        font-size: 15px;
        font-weight: 800;
        color: #bae6fd;
        line-height: 1.1;
      }

      :global(.doppelganger-score) {
        font-size: 18px;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
      }

      :global(.doppelganger-progress-bg) {
        width: 70px;
        height: 6px;
        background: #1e293b;
        border-radius: 3px;
        overflow: hidden;
      }

      :global(.doppelganger-progress-fill) {
        height: 100%;
        border-radius: 3px;
        transition: width 0.4s ease-out;
      }

      :global(.doppelganger-breakdown) {
        display: flex;
        gap: 6px;
        margin-top: 4px;
      }

      :global(.doppelganger-factor) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
      }

      :global(.doppelganger-factor-label) {
        font-size: 9px;
        color: #94a3b8;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      :global(.doppelganger-factor-bar-bg) {
        width: 20px;
        height: 4px;
        background: #1e293b;
        border-radius: 2px;
        overflow: hidden;
      }

      :global(.doppelganger-factor-bar-fill) {
        height: 100%;
        border-radius: 2px;
      }

      @media (max-width: 640px) {
        :global(.doppelganger-main) {
          flex-direction: column !important;
          align-items: flex-start !important;
          gap: 12px;
        }
        :global(.doppelganger-left) {
          width: 100%;
          min-width: 0;
        }
        :global(.doppelganger-right) {
          width: 100%;
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          margin-left: 0;
          padding-top: 10px;
          border-top: 1px solid rgba(255, 255, 255, 0.06);
        }
        :global(.doppelganger-breakdown) {
          margin-top: 0;
        }
        :global(.metric-compare-header),
        :global(.metric-compare-row) {
          grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
        }
        .controls-bar {
          flex-direction: column;
          align-items: stretch;
          gap: 0.85rem;
        }
        .selector-group {
          width: 100%;
          min-width: 0;
        }
        .baseline-group {
          width: 100%;
          justify-content: space-between;
        }
        .app-container {
          padding: 1.25rem 1rem 3rem 1rem;
        }
        .territory-tabs {
          display: flex;
          gap: 6px;
          overflow-x: auto;
          flex-wrap: nowrap;
          padding: 4px;
          background: rgba(255, 255, 255, 0.03);
          border-radius: 12px;
          scrollbar-width: none;
          -webkit-overflow-scrolling: touch;
        }
        .territory-tabs::-webkit-scrollbar {
          display: none;
        }
        .territory-tab, .t-tab, .territory-tabs .t-tab, .territory-tabs .territory-tab {
          white-space: nowrap;
          flex: 1;
          text-align: center;
          padding: 8px 12px;
          font-size: 12px;
          border-radius: 8px;
        }
        .genre-checkboxes, .genre-checkbox-grid, #genre-checkboxes-container {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 6px 12px;
        }
        .explorer-card, .dashboard-card, .chart-card, .doppelganger-card, .card {
          padding: 1.25rem 1rem;
        }
      }

      @media (max-width: 480px) {
        .app-container {
          padding: 1rem 0.65rem 3rem 0.65rem;
        }
        .card, .chart-card, .doppelganger-card, .explorer-card, .dashboard-card {
          padding: 1.25rem 1rem;
        }
      }

      .section-title {
        font-family: var(--font-sans);
        font-size: 1.05rem;
        margin: 1rem 0 0.6rem 0;
        color: var(--color-text);
      }

      /* Genre Checkboxes Grid */
      /* Genre Checkboxes Grid & Helper Tips */
      .genre-help-tips {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75rem;
      }

      .tip-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
        font-size: 0.72rem;
        font-weight: 500;
        user-select: none;
      }

      .tip-badge.tip-include {
        background: rgba(34, 197, 94, 0.12);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.25);
      }

      .tip-badge.tip-exclude {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.25);
      }

      .btn-reset-filters {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: rgba(255, 255, 255, 0.6);
        border-radius: 6px;
        padding: 0.2rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-reset-filters:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
      }

      .genre-checkbox-grid, .genre-checkboxes {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .genre-checkbox-item {
        font-family: var(--font-sans);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.45rem 0.7rem;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        font-size: 0.84rem;
        font-weight: 500;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s, border-color 0.15s;
      }

      .genre-checkbox-item:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(124, 106, 255, 0.4);
        color: #ffffff;
      }

      .genre-checkbox-item.included {
        background: rgba(124, 106, 255, 0.12);
        border-color: rgba(124, 106, 255, 0.4);
        color: #ffffff;
      }

      :global(.genre-checkbox-item.excluded) {
        background: rgba(220, 38, 38, 0.22) !important;
        border-color: #ef4444 !important;
        color: #fca5a5 !important;
        box-shadow: 0 0 8px rgba(220, 38, 38, 0.35) !important;
      }

      :global(.genre-checkbox-item.excluded .genre-name-text) {
        text-decoration: line-through !important;
        color: #f87171 !important;
        font-weight: 600 !important;
      }

      .genre-name-text {
        font-family: var(--font-sans);
      }

      .real-genre-checkbox {
        appearance: auto;
        -webkit-appearance: checkbox;
        width: 16px;
        height: 16px;
        accent-color: var(--color-accent);
        cursor: pointer;
        flex-shrink: 0;
        margin: 0;
      }

      :global(.x-mark-box) {
        width: 16px !important;
        height: 16px !important;
        border-radius: 3px !important;
        background: #dc2626 !important;
        border: 1px solid #f87171 !important;
        color: #ffffff !important;
        font-size: 10px !important;
        font-weight: 900 !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        flex-shrink: 0 !important;
        line-height: 1 !important;
        box-shadow: 0 0 6px rgba(220, 38, 38, 0.6) !important;
        margin: 0 !important;
      }

      /* Card novel styling */
      .card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        backdrop-filter: blur(12px);
      }

      :global(.card-novel) {
        content-visibility: auto;
        contain-intrinsic-size: 0 76px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.35rem;
        height: 76px;
        min-height: 76px;
        max-height: 76px;
        box-sizing: border-box;
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 0.65rem 0.95rem;
        transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
      }

      :global(.card-novel:hover) {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(124, 106, 255, 0.3);
      }

      :global(.card-novel.active) {
        background: rgba(124, 106, 255, 0.08);
        border-color: var(--color-accent);
        box-shadow: 0 0 15px rgba(124, 106, 255, 0.15);
      }

      :global(.card__title) {
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 600;
        line-height: 1.3;
      }

      :global(.card__meta) {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--color-muted);
      }

      :global(.card__source-tag) {
        font-weight: 600;
        color: var(--color-accent-2);
      }

      .novel-list {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        width: 100%;
      }

      /* Stats panel styling */
      .stats-panel {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .stats-content-scroll {
        width: 100%;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.65rem;
      }

      .stat-item {
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.65rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      .stat-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
      }

      .stat-value {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--color-accent-2);
      }

      /* Enhanced Metrics Dashboard Component Styles */
      :global(.metrics-dashboard) {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      :global(.metrics-hero) {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.55rem;
        background: rgba(124, 106, 255, 0.04);
        border: 1px solid rgba(124, 106, 255, 0.18);
        border-radius: 10px;
        padding: 0.65rem;
      }

      :global(.hero-chip) {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0.55rem 0.75rem;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        gap: 0.2rem;
        min-width: 0;
        overflow: hidden;
        transition: all 0.2s ease;
      }

      :global(.hero-chip-label) {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.hero-chip-val) {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--color-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.metrics-carousel-header) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      :global(.metrics-category-tabs) {
        display: flex;
        gap: 0.35rem;
        overflow-x: auto;
        padding-bottom: 0.15rem;
        scrollbar-width: none;
      }
      :global(.metrics-category-tabs::-webkit-scrollbar) {
        display: none;
      }

      :global(.category-tab) {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-muted);
        border-radius: 20px;
        padding: 0.3rem 0.65rem;
        font-size: 0.73rem;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
      }

      :global(.category-tab:hover), :global(.category-tab.active) {
        background: rgba(124, 106, 255, 0.2);
        border-color: rgba(124, 106, 255, 0.6);
        color: #ffffff;
      }

      :global(.category-tab-badge) {
        font-size: 0.62rem;
        background: rgba(255, 255, 255, 0.12);
        padding: 0.08rem 0.38rem;
        border-radius: 10px;
      }

      :global(.metrics-carousel-nav) {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      :global(.carousel-nav-btn) {
        width: 26px;
        height: 26px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: var(--color-text);
        cursor: pointer;
        font-size: 0.95rem;
        font-weight: 700;
        line-height: 1;
        transition: all 0.15s ease;
      }
      :global(.carousel-nav-btn:hover:not(:disabled)) {
        background: rgba(124, 106, 255, 0.3);
        border-color: #a78bfa;
        color: #ffffff;
      }
      :global(.carousel-nav-btn:disabled) {
        opacity: 0.3;
        cursor: not-allowed;
      }

      :global(.carousel-indicator-pill) {
        font-size: 0.7rem;
        color: var(--color-muted);
        padding: 0.2rem 0.5rem;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        font-weight: 600;
        white-space: nowrap;
      }

      :global(.metrics-carousel-track-wrapper) {
        position: relative;
        width: 100%;
      }

      :global(.metrics-carousel-track) {
        display: grid;
        grid-template-rows: repeat(2, minmax(135px, 1fr));
        grid-auto-flow: column;
        grid-auto-columns: 215px;
        gap: 0.6rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        padding: 0.2rem 0.15rem 0.65rem 0.15rem;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
        -webkit-overflow-scrolling: touch;
      }

      :global(.metrics-carousel-track::-webkit-scrollbar) {
        height: 5px;
      }
      :global(.metrics-carousel-track::-webkit-scrollbar-thumb) {
        background: rgba(255, 255, 255, 0.18);
        border-radius: 4px;
      }

      :global(.metric-category-group) {
        display: flex;
        gap: 0.65rem;
        align-items: stretch;
        flex-shrink: 0;
        position: relative;
        scroll-snap-align: start;
      }

      :global(.category-group-header) {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        height: fit-content;
        align-self: flex-start;
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        min-height: 120px;
        justify-content: center;
      }

      :global(.category-group-header.cat-structure) { color: #38bdf8; border-color: rgba(56, 189, 248, 0.25); }
      :global(.category-group-header.cat-prose)     { color: #a78bfa; border-color: rgba(167, 139, 250, 0.25); }
      :global(.category-group-header.cat-theme)     { color: #f472b6; border-color: rgba(244, 114, 182, 0.25); }
      :global(.category-group-header.cat-pacing)    { color: #34d399; border-color: rgba(52, 211, 153, 0.25); }

      :global(.metric-card) {
        flex: 0 0 215px;
        min-width: 215px;
        max-width: 215px;
        scroll-snap-align: start;
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.65rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        position: relative;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-card-cat-badge) {
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        width: fit-content;
        margin-bottom: 0.15rem;
      }
      :global(.metric-card-cat-badge.cat-structure) { background: rgba(56, 189, 248, 0.12); color: #38bdf8; }
      :global(.metric-card-cat-badge.cat-prose)     { background: rgba(167, 139, 250, 0.12); color: #a78bfa; }
      :global(.metric-card-cat-badge.cat-theme)     { background: rgba(244, 114, 182, 0.12); color: #f472b6; }
      :global(.metric-card-cat-badge.cat-pacing)    { background: rgba(52, 211, 153, 0.12); color: #34d399; }

      /* Light Theme Overrides */
      :global([data-theme="light"]) .carousel-nav-btn {
        background: rgba(255, 255, 255, 0.85);
        border: 1px solid rgba(203, 213, 225, 0.9);
        color: #0f172a;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
      }
      :global([data-theme="light"]) .carousel-nav-btn:hover:not(:disabled) {
        background: #0284c7;
        border-color: #0284c7;
        color: #ffffff;
      }
      :global([data-theme="light"]) .carousel-indicator-pill {
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid rgba(203, 213, 225, 0.8);
        color: #475569;
      }
      :global([data-theme="light"]) .metrics-carousel-track::-webkit-scrollbar-thumb {
        background: rgba(203, 213, 225, 0.9);
      }
      :global([data-theme="light"]) .category-tab-badge {
        background: rgba(15, 23, 42, 0.08);
        color: #475569;
      }
        border-radius: 8px;
        padding: 0.65rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        position: relative;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-card:hover) {
        border-color: rgba(124, 106, 255, 0.3);
        transform: translateY(-1px);
      }

      :global(.metric-card-header) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
      }

      :global(.metric-info-icon) {
        font-size: 0.72rem;
        color: var(--color-accent-2);
        cursor: pointer;
        opacity: 0.8;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(124, 106, 255, 0.12);
        border: 1px solid rgba(124, 106, 255, 0.25);
        user-select: none;
      }

      :global(.metric-info-icon:hover), :global(.metric-info-icon.active) {
        opacity: 1.0;
        transform: scale(1.12);
        background: rgba(124, 106, 255, 0.3);
        border-color: var(--color-accent);
        color: #ffffff;
      }

      :global(.metric-tooltip-box) {
        position: absolute;
        bottom: 125%;
        right: 0;
        background: #0f172a;
        border: 1px solid rgba(124, 106, 255, 0.4);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 12px rgba(124, 106, 255, 0.25);
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        font-size: 0.73rem;
        color: #e2e8f0;
        line-height: 1.45;
        width: 220px;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-tooltip-box.visible),
      :global(.metric-info-icon:hover + .metric-tooltip-box) {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      :global(.metric-val-row) {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.4rem;
      }

      :global(.metric-primary-val) {
        font-family: var(--font-display);
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-text);
      }

      :global(.percentile-bar-bg) {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 2px;
        overflow: hidden;
      }

      :global(.percentile-bar-fill) {
        height: 100%;
        border-radius: 2px;
        transition: width 0.4s ease-out;
      }

      :global(.bar-fill-structure) { background: linear-gradient(90deg, #0284c7, #38bdf8); }
      :global(.bar-fill-prose)     { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
      :global(.bar-fill-theme)     { background: linear-gradient(90deg, #db2777, #f472b6); }
      :global(.bar-fill-pacing)    { background: linear-gradient(90deg, #059669, #34d399); }

      :global(.benchmark-chip) {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 600;
        width: fit-content;
      }

      :global(.benchmark-chip.higher) {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
      }

      :global(.benchmark-chip.lower) {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      :global(.benchmark-chip.neutral) {
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
        border: 1px solid rgba(148, 163, 184, 0.2);
      }

      :global(.metric-baseline-row) {
        display: flex;
        gap: 0.55rem;
        margin-top: 0.2rem;
        flex-wrap: wrap;
      }

      :global(.metric-baseline-item) {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.63rem;
        color: rgba(255,255,255,0.45);
      }

      :global(.metric-baseline-dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      /* Form inputs */
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 0.85rem;
      }

      label {
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--color-text);
      }

      input[type="text"], input[type="number"] {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.55rem 0.75rem;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 0.85rem;
        outline: none;
        transition: border-color var(--transition);
      }

      input[type="text"]:focus, input[type="number"]:focus {
        border-color: var(--color-accent);
      }

      .placeholder-text {
        color: var(--color-muted);
        text-align: center;
        padding: 2.5rem 1rem;
        font-style: italic;
        font-size: 0.88rem;
      }

      /* Controls Bar & Charts */
      .controls-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        align-items: center;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 1rem;
        padding: 1rem 1.25rem;
      }

      .selector-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex: 1;
        min-width: 220px;
      }

      .selector-group label {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        white-space: nowrap;
      }

      select#novelSelect {
        flex: 1;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 0.5rem;
        color: #e2e2f0;
        font-family: inherit;
        font-size: 0.9rem;
        padding: 0.45rem 0.75rem;
        cursor: pointer;
        outline: none;
        transition: border-color 0.2s;
        min-width: 0;
        width: 100%;
      }

      select#novelSelect:focus { border-color: #a78bfa; }

      .baseline-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-shrink: 0;
        flex-wrap: wrap;
      }

      .baseline-group span {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(255,255,255,0.4);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .baseline-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 0.5rem;
        color: rgba(255,255,255,0.6);
        font-family: inherit;
        font-size: 0.82rem;
        font-weight: 600;
        padding: 0.45rem 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .baseline-btn:hover { color: #e2e2f0; border-color: rgba(255,255,255,0.25); }
      .baseline-btn.active[data-baseline="web_novel"] {
        background: rgba(167,139,250,0.18);
        border-color: #a78bfa;
        color: #c4b5fd;
      }
      .baseline-btn.active[data-baseline="classic_lit"] {
        background: rgba(251,191,36,0.18);
        border-color: #fbbf24;
        color: #fde68a;
      }

      .charts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.5rem;
      }

      @media (max-width: 900px) {
        .charts-grid { grid-template-columns: minmax(0, 1fr); }
      }

      .chart-card {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 1rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        position: relative;
        min-width: 0;
      }

      .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .chart-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.15rem;
        font-weight: 600;
      }

      .chart-legend {
        display: flex;
        gap: 1rem;
        align-items: center;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.5);
      }

      .legend-item { display: flex; align-items: center; gap: 0.4rem; }
      .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
      .legend-dot.user { background: #7dd3fc; }
      .legend-dot.wn { background: #a78bfa; }
      .legend-dot.baseline { background: #a78bfa; }

      #radarChart {
        width: 100%;
        aspect-ratio: 1 / 1;
        max-width: 480px;
        margin: 0 auto;
        display: block;
        cursor: crosshair;
        image-rendering: crisp-edges;
      }

      svg#arcChart {
        width: 100%;
        height: auto;
        aspect-ratio: 600 / 420;
        display: block;
        cursor: crosshair;
      }

      .archetype-label {
        text-align: center;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.7);
        font-weight: 500;
        margin: 0;
      }

      /* Archetype Taxonomy & Multi-Genre Styles */
      :global(.archetype-taxonomy-container) {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        margin-top: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
      }

      :global(.taxonomy-pillars-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 0.5rem;
      }

      :global(.pillar-card) {
        background: rgba(255, 255, 255, 0.025);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 0.55rem;
        padding: 0.5rem 0.65rem;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        transition: border-color 0.2s, background 0.2s;
      }
      :global(.pillar-card:hover) {
        border-color: rgba(255, 255, 255, 0.12);
        background: rgba(255, 255, 255, 0.04);
      }

      :global(.pillar-card.inciting) { border-left: 3px solid #f472b6; }
      :global(.pillar-card.world)    { border-left: 3px solid #38bdf8; }
      :global(.pillar-card.plot)     { border-left: 3px solid #34d399; }

      :global(.pillar-tag) {
        font-size: 0.63rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #94a3b8;
      }

      :global(.pillar-name) {
        font-size: 0.82rem;
        font-weight: 600;
        color: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.3rem;
      }

      :global(.pillar-score) {
        font-size: 0.72rem;
        font-weight: 700;
        color: #a78bfa;
        background: rgba(167, 139, 250, 0.12);
        padding: 0.05rem 0.35rem;
        border-radius: 999px;
      }

      /* Dynamic Genre Affinities Track */
      :global(.genre-affinities-track) {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      :global(.affinities-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      :global(.affinities-title) {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: #64748b;
      }

      :global(.affinity-pills-row) {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }

      :global(.genre-affinity-pill) {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.25rem 0.6rem;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 500;
        transition: transform 0.15s, border-color 0.2s;
        cursor: default;
      }
      :global(.genre-affinity-pill:hover) {
        transform: translateY(-1px);
      }

      :global(.genre-affinity-pill.tier-vibrant) {
        background: rgba(167, 139, 250, 0.14);
        border: 1px solid rgba(167, 139, 250, 0.4);
        color: #c4b5fd;
      }
      :global(.genre-affinity-pill.tier-cyan) {
        background: rgba(56, 189, 248, 0.12);
        border: 1px solid rgba(56, 189, 248, 0.35);
        color: #7dd3fc;
      }
      :global(.genre-affinity-pill.tier-emerald) {
        background: rgba(52, 211, 153, 0.12);
        border: 1px solid rgba(52, 211, 153, 0.35);
        color: #6ee7b7;
      }

      :global(.pill-pct) {
        font-weight: 700;
      }

      /* Expandable All Genres Drawer */
      :global(.toggle-all-genres-btn) {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #94a3b8;
        padding: 0.35rem 0.75rem;
        border-radius: 0.45rem;
        font-size: 0.72rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        transition: all 0.2s ease;
        margin-top: 0.1rem;
        align-self: flex-start;
      }
      :global(.toggle-all-genres-btn:hover) {
        background: rgba(255, 255, 255, 0.04);
        border-color: rgba(255, 255, 255, 0.18);
        color: #ffffff;
      }

      :global(.chevron-icon) {
        transition: transform 0.25s ease;
      }

      :global(.all-genres-drawer) {
        margin-top: 0.35rem;
        padding: 0.75rem;
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 0.6rem;
      }

      :global(.all-genres-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 0.45rem 0.9rem;
      }

      :global(.genre-rank-row) {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      :global(.genre-rank-info) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.72rem;
      }

      :global(.genre-rank-name) {
        color: #cbd5e1;
        font-weight: 500;
      }

      :global(.genre-rank-score) {
        font-weight: 700;
        font-size: 0.7rem;
      }

      :global(.genre-rank-track) {
        height: 3px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 999px;
        overflow: hidden;
      }

      :global(.genre-rank-fill) {
        height: 100%;
        border-radius: 999px;
        transition: width 0.3s ease;
      }

      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }

      .status-spinner {
        width: 18px;
        height: 18px;
        border: 2px solid rgba(124, 106, 255, 0.2);
        border-top-color: var(--color-accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        flex-shrink: 0;
        margin-top: 2px;
      }

      .status-icon--success {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.2);
        color: rgb(52, 211, 153);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
        flex-shrink: 0;
      }

      .status-icon--error {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: rgba(239, 68, 68, 0.2);
        color: rgb(248, 113, 113);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
        flex-shrink: 0;
      }

      .status-pill {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.18rem 0.5rem;
        border-radius: 999px;
      }

      .status-pill--running {
        background: rgba(124, 106, 255, 0.15);
        color: var(--color-accent);
        border: 1px solid rgba(124, 106, 255, 0.3);
      }

      .status-pill--completed {
        background: rgba(16, 185, 129, 0.15);
        color: rgb(52, 211, 153);
        border: 1px solid rgba(16, 185, 129, 0.3);
      }

      .status-pill--failed {
        background: rgba(239, 68, 68, 0.15);
        color: rgb(248, 113, 113);
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      /* Hover Tooltips for Charts */
      .radar-tooltip {
        position: fixed;
        pointer-events: none;
        background: rgba(10, 10, 18, 0.95);
        border: 1px solid rgba(124, 106, 255, 0.35);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        font-size: 0.8rem;
        z-index: 1000;
        display: none;
      }
      .radar-tooltip-title {
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.35rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding-bottom: 0.25rem;
      }
      .radar-tooltip-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.2rem;
      }
      .radar-tooltip-val {
        font-family: var(--font-display);
        font-weight: 600;
      }

      /* Database Statistics Overview - Impeccable Clean Styling */
      :global(.db-stats-card) {
        background: rgba(18, 18, 30, 0.75);
        border: 1px solid rgba(124, 106, 255, 0.18);
        border-radius: 12px;
        padding: 1.15rem;
        backdrop-filter: blur(12px);
      }

      :global(.db-kpi-grid) {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
        margin-bottom: 0.85rem;
      }

      :global(.db-kpi-tile) {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 8px;
        padding: 0.55rem 0.7rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: border-color 0.2s ease, background 0.2s ease;
      }
      :global(.db-kpi-tile:hover) {
        border-color: rgba(124, 106, 255, 0.35);
        background: rgba(124, 106, 255, 0.04);
      }

      :global(.db-kpi-val) {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
        line-height: 1.2;
      }

      :global(.db-kpi-lbl) {
        font-size: 0.68rem;
        color: var(--color-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-top: 0.15rem;
      }

      :global(.db-source-chip) {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid rgba(255, 255, 255, 0.09);
        border-radius: 6px;
        padding: 0.24rem 0.58rem;
        font-size: 0.74rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.9);
        transition: all 0.2s ease;
      }
      :global(.db-source-chip:hover) {
        background: rgba(255, 255, 255, 0.08);
        border-color: rgba(255, 255, 255, 0.25);
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
      }
      :global(.db-source-dot) {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 6px currentColor;
      }

      :global(.db-genre-chip) {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.45rem;
        background: rgba(124, 106, 255, 0.08);
        border: 1px solid rgba(124, 106, 255, 0.2);
        border-radius: 6px;
        padding: 0.24rem 0.55rem;
        font-size: 0.73rem;
        color: #e2e8f0;
        font-weight: 500;
        transition: all 0.18s ease;
      }
      :global(.db-genre-chip:hover) {
        border-color: rgba(124, 106, 255, 0.45);
        background: rgba(124, 106, 255, 0.16);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 3px 10px rgba(124, 106, 255, 0.2);
      }
      :global(.db-genre-count) {
        background: rgba(124, 106, 255, 0.22);
        border: 1px solid rgba(124, 106, 255, 0.35);
        border-radius: 4px;
        padding: 0.05rem 0.35rem;
        font-size: 0.66rem;
        font-weight: 700;
        color: #c4b5fd;
      }

      /* ── Skeleton Loading UI & Shimmer Keyframes ── */
      @keyframes skeleton-shimmer {
        0% { background-position: -200% 0; }
        100% { background-position: 200% 0; }
      }

      @keyframes skeleton-pulse-glow {
        0%, 100% {
          border-color: rgba(148, 163, 184, 0.12);
          box-shadow: 0 0 0 0 rgba(6, 182, 212, 0);
        }
        50% {
          border-color: rgba(6, 182, 212, 0.35);
          box-shadow: 0 0 20px rgba(6, 182, 212, 0.10);
        }
      }

      @keyframes pulse-dot {
        0%, 100% { transform: scale(1); opacity: 0.8; }
        50% { transform: scale(1.3); opacity: 1; }
      }

      .skeleton-shimmer,
      :global(.skeleton-shimmer) {
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.03) 0%,
          rgba(255, 255, 255, 0.09) 50%,
          rgba(255, 255, 255, 0.03) 100%
        );
        background-size: 200% 100%;
        animation: skeleton-shimmer 1.8s infinite ease-in-out;
      }

      .skeleton-progress-container,
      :global(.skeleton-progress-container) {
        width: 100%;
        margin-bottom: 1.25rem;
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        backdrop-filter: blur(12px);
      }

      .skeleton-progress-bar-bg,
      :global(.skeleton-progress-bar-bg) {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 999px;
        overflow: hidden;
        margin-top: 0.75rem;
      }

      .skeleton-progress-bar-fill,
      :global(.skeleton-progress-bar-fill) {
        height: 100%;
        width: 15%;
        background: linear-gradient(90deg, #0284c7, #38bdf8);
        box-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
        border-radius: 999px;
        transition: width 0.4s ease-out;
      }

      .skeleton-stage-header,
      :global(.skeleton-stage-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .skeleton-stage-pill,
      :global(.skeleton-stage-pill) {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        font-weight: 600;
        color: #38bdf8;
        background: rgba(56, 189, 248, 0.1);
        border: 1px solid rgba(56, 189, 248, 0.25);
        padding: 0.25rem 0.75rem;
        border-radius: 999px;
      }

      .skeleton-stage-dot,
      :global(.skeleton-stage-dot) {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #38bdf8;
        animation: pulse-dot 1.2s infinite ease-in-out;
      }

      .skeleton-elapsed,
      :global(.skeleton-elapsed) {
        font-size: 0.75rem;
        color: #94a3b8;
        font-family: monospace;
      }

      .skeleton-subtext,
      :global(.skeleton-subtext) {
        font-size: 0.8125rem;
        color: #cbd5e1;
        margin: 0.5rem 0 0 0;
      }

      .skeleton-card,
      :global(.skeleton-card) {
        background: rgba(15, 23, 42, 0.45);
        border: 1px solid rgba(148, 163, 184, 0.1);
        border-radius: 12px;
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .skeleton-chart-frame,
      :global(.skeleton-chart-frame) {
        background: rgba(15, 23, 42, 0.5);
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 14px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        animation: skeleton-pulse-glow 3s infinite ease-in-out;
      }

      .fade-in-content,
      :global(.fade-in-content) {
        animation: fadeIn 0.35s ease-out forwards;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }

      @media (max-width: 640px) {
        .territory-tabs {
          display: flex !important;
          gap: 6px !important;
          overflow-x: auto !important;
          flex-wrap: nowrap !important;
          padding: 4px !important;
          background: rgba(255, 255, 255, 0.03) !important;
          border-radius: 12px !important;
          scrollbar-width: none !important;
          -webkit-overflow-scrolling: touch !important;
          width: 100% !important;
        }
        html[data-theme="light"] .territory-tabs {
          background: rgba(0, 0, 0, 0.03) !important;
        }
        .territory-tabs::-webkit-scrollbar {
          display: none !important;
        }
        .t-tab, .territory-tab, .territory-tabs .t-tab, .territory-tabs .territory-tab {
          white-space: nowrap !important;
          flex: 1 0 auto !important;
          text-align: center !important;
          padding: 8px 14px !important;
          font-size: 12px !important;
          border-radius: 8px !important;
        }
        .genre-checkbox-grid, .genre-checkboxes, #genre-checkboxes-container {
          display: grid !important;
          grid-template-columns: 1fr 1fr !important;
          gap: 6px 10px !important;
        }
        .genre-checkbox-item {
          padding: 0.4rem 0.5rem !important;
          font-size: 0.76rem !important;
          gap: 0.4rem !important;
        }
        .app-container {
          padding: 1rem 0.75rem 3rem 0.75rem !important;
        }
        .explorer-card, .dashboard-card, .chart-card, .doppelganger-card, .card {
          padding: 1.25rem 1rem !important;
        }
        :global(.metrics-hero) {
          grid-template-columns: repeat(2, 1fr) !important;
        }
        html[data-theme="light"] :global(.doppelganger-right) {
          border-top-color: rgba(0, 0, 0, 0.06);
        }
      }

      /* =========================================================================
         LIGHT MODE STYLES & OVERRIDES
         ========================================================================= */
      :global([data-theme="light"]) {
        --color-bg-base: #f8fafc;
        --color-bg-surface: #ffffff;
        --color-bg-elevated: #f1f5f9;
        --color-bg-card: #ffffff;
        --color-text: #0f172a;
        --color-muted: #64748b;
        --color-border: #e2e8f0;
        --color-border-subtle: #cbd5e1;
        --color-primary: #0284c7;
        --color-primary-hover: #0369a1;
        --color-accent-1: #6366f1;
        --color-accent-2: #0284c7;
        --color-success: #059669;
        --color-warning: #d97706;
        --color-danger: #dc2626;
      }

      /* Global resets & typography for light mode */
      :global([data-theme="light"]) body {
        background-color: var(--color-bg-base);
        color: var(--color-text);
      }

      /* Cards & Containers (Frosted Glassmorphism) */
      :global([data-theme="light"]) .card,
      :global([data-theme="light"]) .explorer-card,
      :global([data-theme="light"]) .chart-card,
      :global([data-theme="light"]) .doppelganger-card,
      :global([data-theme="light"]) .db-stats-card {
        background: rgba(255, 255, 255, 0.82) !important;
        backdrop-filter: blur(20px) saturate(180%) !important;
        -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
        border: 1px solid rgba(226, 232, 240, 0.9) !important;
        box-shadow: 0 4px 24px -2px rgba(15, 23, 42, 0.05), 0 1px 3px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 1) !important;
      }

      :global([data-theme="light"]) .card:hover,
      :global([data-theme="light"]) .explorer-card:hover,
      :global([data-theme="light"]) .chart-card:hover,
      :global([data-theme="light"]) .doppelganger-card:hover {
        background: rgba(255, 255, 255, 0.94) !important;
        border-color: rgba(99, 102, 241, 0.28) !important;
        box-shadow: 0 14px 38px -4px rgba(99, 102, 241, 0.12), 0 4px 12px -2px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 1) !important;
      }

      /* Search & Filters */
      :global([data-theme="light"]) .search-input-wrapper {
        background: rgba(255, 255, 255, 0.75);
