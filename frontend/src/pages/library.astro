                  <span class="db-genre-chip">Romance <span class="db-genre-count">7</span></span>
                  <span class="db-genre-chip">Comedy <span class="db-genre-count">6</span></span>
                  <span class="db-genre-chip">Philosophy <span class="db-genre-count">6</span></span>
                  <span class="db-genre-chip">Supernatural <span class="db-genre-count">6</span></span>
                  <span class="db-genre-chip">Cultivation <span class="db-genre-count">5</span></span>
                  <span class="db-genre-chip">Sci-Fi <span class="db-genre-count">4</span></span>
                  <span class="db-genre-chip">Tragedy <span class="db-genre-count">4</span></span>
                  <span class="db-genre-chip">Poetry <span class="db-genre-count">2</span></span>
                </div>
