      let currentLoadingTimer = null;
      let currentLoadId = 0;

      function attachDashboardEventListeners(container) {
        if (!container) return;
        const track = container.querySelector("#metricsCarouselTrack");
        const prevBtn = container.querySelector("#metricsCarouselPrev");
        const nextBtn = container.querySelector("#metricsCarouselNext");
        const indicator = container.querySelector("#metricsCarouselIndicator");
        const tabBtns = container.querySelectorAll(".category-tab");
        const cards = container.querySelectorAll(".metric-card");
        const totalCards = cards.length;

        function updateCarouselState() {
          if (!track || !indicator) return;
          const scrollLeft = track.scrollLeft;
          const colWidth = 224; // 215px + 9px gap
          const visibleCols = Math.max(1, Math.floor((track.clientWidth + 10) / colWidth));
          const firstCol = Math.max(0, Math.round(scrollLeft / colWidth));
          const firstIdx = firstCol * 2;
          const lastIdx = Math.min(totalCards, firstIdx + (visibleCols * 2));

          indicator.innerText = `${firstIdx + 1}–${lastIdx} of ${totalCards}`;
          if (prevBtn) prevBtn.disabled = (scrollLeft <= 5);
          if (nextBtn) nextBtn.disabled = (scrollLeft + track.clientWidth >= track.scrollWidth - 5);

          // Update active category tab based on current first visible card
          const currentCard = cards[firstIdx];
          if (currentCard) {
            const currentCat = currentCard.getAttribute("data-category");
            tabBtns.forEach(btn => {
              const cat = btn.getAttribute("data-cat");
              if (cat === currentCat || (firstIdx === 0 && cat === "all")) {
                btn.classList.add("active");
              } else {
                btn.classList.remove("active");
              }
            });
          }
        }

        if (track) {
          track.addEventListener("scroll", updateCarouselState, { passive: true });
          updateCarouselState();
        }

        if (prevBtn && track) {
          prevBtn.addEventListener("click", () => {
            track.scrollBy({ left: -track.clientWidth * 0.75, behavior: "smooth" });
          });
        }

        if (nextBtn && track) {
          nextBtn.addEventListener("click", () => {
            track.scrollBy({ left: track.clientWidth * 0.75, behavior: "smooth" });
          });
        }

        tabBtns.forEach(btn => {
          btn.addEventListener("click", () => {
            const targetCat = btn.getAttribute("data-cat");
            tabBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");

            if (targetCat === "all") {
              track.scrollTo({ left: 0, behavior: "smooth" });
            } else {
              const targetCard = container.querySelector(`.metric-card[data-category="${targetCat}"]`);
              if (targetCard && track) {
                track.scrollTo({ left: targetCard.offsetLeft - track.offsetLeft - 4, behavior: "smooth" });
              }
            }
          });
        });

        // Attach info icon click handler for popovers
        const infoIcons = container.querySelectorAll(".metric-info-icon");
        infoIcons.forEach(icon => {
          icon.addEventListener("click", (e) => {
            e.stopPropagation();
            const tooltipBox = icon.nextElementSibling;
            const isVisible = tooltipBox?.classList.contains("visible");
            container.querySelectorAll(".metric-tooltip-box").forEach(box => box.classList.remove("visible"));
            container.querySelectorAll(".metric-info-icon").forEach(i => i.classList.remove("active"));
            if (!isVisible && tooltipBox) {
              tooltipBox.classList.add("visible");
              icon.classList.add("active");
            }
          });
        });

        document.addEventListener("click", () => {
          container.querySelectorAll(".metric-tooltip-box").forEach(box => box.classList.remove("visible"));
          container.querySelectorAll(".metric-info-icon").forEach(i => i.classList.remove("active"));
        });
      }

      async function selectNovel(id, title) {
        selectedNovelId = id;
        const loadId = ++currentLoadId;

        if (currentLoadingTimer) {
          clearInterval(currentLoadingTimer);
          currentLoadingTimer = null;
        }

        // Auto-navigate pagination to the page containing this novel
        if (lastFilteredNovels && lastFilteredNovels.length > 0) {
          const novelIndex = lastFilteredNovels.findIndex(n => n.id === id);
          if (novelIndex !== -1) {
            const targetPage = Math.floor(novelIndex / NOVELS_PER_PAGE) + 1;
            if (currentNovelPage !== targetPage) {
              currentNovelPage = targetPage;
              renderNovelsList(lastFilteredNovels);
            }
          } else {
            // If currently filtered out, check allNovels and navigate
            const allIndex = allNovels.findIndex(n => n.id === id);
            if (allIndex !== -1) {
              searchQuery = "";
              const searchInput = document.getElementById("novel-search-input");
              if (searchInput) searchInput.value = "";
              excludedGenres.clear();
              selectedGenres.clear();
              lastFilteredNovels = allNovels;
              renderGenreCheckboxes();
              currentNovelPage = Math.floor(allIndex / NOVELS_PER_PAGE) + 1;
              renderNovelsList(allNovels);
            }
          }
        }
        
        // Highlight active card in grid
        document.querySelectorAll(".card-novel").forEach(c => {
          if (c.getAttribute("data-novel-id") == id) {
            c.classList.add("active");
          } else {
            c.classList.remove("active");
          }
        });

        // Sync dropdown
        const dropdown = document.getElementById("novelSelect");
        if (dropdown) dropdown.value = id;

        // Reset state and activate skeleton placeholders
        currentStats = null;
        currentArc = null;

        const statsContent = document.getElementById("stats-content");
        const titleElement = document.getElementById("novel-details-title");
        const chartsGrid = document.getElementById("chartsGrid");
        const similarContainer = document.getElementById("similarNovelsContainer");

        if (titleElement) titleElement.innerText = `${title} — Analyzing Stylistic DNA...`;
        if (chartsGrid) chartsGrid.style.display = "none";
        if (statsContent) statsContent.innerHTML = renderSkeletonDashboard(title);
        if (similarContainer) similarContainer.innerHTML = renderSkeletonSimilarNovels();

        // Multi-stage progress animation timeline
        const startTime = Date.now();
        currentLoadingTimer = setInterval(() => {
          if (loadId !== currentLoadId) {
            clearInterval(currentLoadingTimer);
            return;
          }
          const elapsed = (Date.now() - startTime) / 1000;
          const elapsedEl = document.getElementById("skeletonElapsedTime");
          const pillEl = document.getElementById("skeletonStagePill");
          const textEl = document.getElementById("skeletonStageText");
          const dotEl = document.getElementById("skeletonStageDot");
          const subtextEl = document.getElementById("skeletonSubtext");
          const progressFill = document.getElementById("skeletonProgressFill");

          if (elapsedEl) elapsedEl.innerText = `${elapsed.toFixed(1)}s elapsed`;

          if (elapsed < 3.0) {
            // Step 1: Metrics
            const pct = Math.min(45, 15 + (elapsed / 3.0) * 30);
            if (progressFill) progressFill.style.width = `${pct}%`;
            if (textEl) textEl.innerText = "Step 1/3: Extracting Stylistic Metrics...";
            if (subtextEl) subtextEl.innerText = "Parsing sentence structure, syntactic depth, and lexical richness...";
          } else if (elapsed < 7.0) {
            // Step 2: Arc
            const pct = Math.min(80, 45 + ((elapsed - 3.0) / 4.0) * 35);
            if (progressFill) progressFill.style.width = `${pct}%`;
            if (textEl) textEl.innerText = "Step 2/3: Mapping Kishotenketsu Arc...";
            if (subtextEl) subtextEl.innerText = "Calculating 4-phase quantile emotional trajectories across prose...";
          } else {
            // Step 3: Synthesis & Charts
            const pct = Math.min(96, 80 + ((elapsed - 7.0) / 5.0) * 16);
            if (progressFill) progressFill.style.width = `${pct}%`;
            if (textEl) textEl.innerText = "Step 3/3: Synthesizing Archetype Radar...";
            if (subtextEl) subtextEl.innerText = "Extracting multi-factor similarity vectors and rendering visualizations...";
          }
        }, 100);

        try {
          const [statsRes, arcRes] = await Promise.all([
            fetch(`${API_URL}/api/novels/${id}/stats`),
            fetch(`${API_URL}/api/novels/${id}/arc`)
          ]);

          if (loadId !== currentLoadId) return; // Stale request discarded
          if (currentLoadingTimer) {
            clearInterval(currentLoadingTimer);
            currentLoadingTimer = null;
          }

          if (!statsRes.ok) throw new Error("Stats request failed");
          if (!arcRes.ok) throw new Error("Arc request failed");

          const stats = await statsRes.json();
          const arc = await arcRes.json();

          if (loadId !== currentLoadId) return;

          currentStats = stats;
          currentArc = arc;

          if (titleElement) titleElement.innerText = `${title} Metrics`;

          if (Object.keys(stats).length === 0) {
            statsContent.innerHTML = `<p class="placeholder-text">No text metrics found for this novel.</p>`;
            return;
          }

          statsContent.innerHTML = `<div class="fade-in-content">${renderEnhancedMetricsDashboard(stats)}</div>`;

          // Attach tab filter and popover handlers
          attachDashboardEventListeners(statsContent);

          // Unhide charts container and render visualizations with smooth fade-in
          if (chartsGrid) {
            chartsGrid.style.display = "grid";
            chartsGrid.classList.add("fade-in-content");
          }
          renderAll();
          if (stats.top_matches) {
            renderSimilarNovels(stats.top_matches);
          }

          try {
            sessionStorage.setItem("library_selected_novel_id", id.toString());
            sessionStorage.setItem("library_selected_novel_title", title);
          } catch (e) {}

        } catch (err) {
          if (loadId !== currentLoadId) return;
          if (currentLoadingTimer) {
            clearInterval(currentLoadingTimer);
            currentLoadingTimer = null;
          }
          console.error("Error loading stats or arc:", err);
          if (titleElement) titleElement.innerText = `${title} (Error)`;
          if (statsContent) {
            const escapedTitle = title.replace(/'/g, "\\'");
            statsContent.innerHTML = `
              <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px; padding: 1.5rem; text-align: center;">
                <p style="color: #f87171; font-weight: 600; margin: 0 0 0.5rem 0;">Failed to load metrics for this novel.</p>
                <p style="color: #94a3b8; font-size: 0.8125rem; margin: 0 0 1rem 0;">${err.message || "Network request failed"}</p>
                <button class="baseline-btn" onclick="selectNovel(${id}, '${escapedTitle}')">Retry Analysis</button>
              </div>
            `;
          }
        }
      }

      function buildStatItem(label, value) {
        return `
          <div class="stat-item">
            <div class="stat-label">${label}</div>
            <div class="stat-value">${value ?? 'N/A'}</div>
          </div>
        `;
      }

      /* ── Visualization Charts Logic (Identical to Latest Visualization Page) ── */
      const RADAR_DIMS = [
        { key: "en_theme_explication_ratio",     label: "Thematic Explicitness", min: 0,    max: 10.0 },
        { key: "en_linearity_subversion_score",  label: "Temporal Complexity",  min: 0,    max: 0.20 },
        { key: "en_sensory_body_density",        label: "Visceral Emotion",     min: 0,    max: 1.0  },
        { key: "en_outside_world_engagement",    label: "World Grounding",      min: 0.5,  max: 4.0  },
        { key: "en_narrative_feature_diversity", label: "Subplot Diversity",    min: 0,    max: 1.0  },
        { key: "en_dialogue_ratio",              label: "Dialogue Density",     min: 0,    max: 0.8  },
        { key: "en_ttr",                         label: "Lexical Richness",     min: 0.3,  max: 0.9  },
        { key: "en_compound_sentiment",          label: "Emotional Tone",       min: 0,    max: 1.0  },
      ];

      const RADAR_BASELINES = {
        web_novel:   [0.35, 0.55, 0.60, 0.40, 0.40, 0.65, 0.45, 0.50],
        classic_lit: [0.30, 0.20, 0.40, 0.80, 0.70, 0.30, 0.80, 0.40],
      };

      const PACING_BASELINES = {
        web_novel: [15, 8, 22, 5, 12, 30, 9, 14, 6, 18, 11, 25, 7, 16, 13, 8, 20, 10, 15, 6, 24, 9, 12, 17, 8, 14, 5, 21, 7, 13, 11, 28, 6, 15, 9, 19, 12, 10, 16, 8, 23, 7, 11, 14, 5, 17, 12, 9, 21, 6],
        classic_lit: [85, 112, 64, 140, 95, 130, 78, 105, 88, 120, 90, 115, 130, 80, 125, 95, 110, 140, 75, 100, 105, 120, 85, 135, 95, 110, 130, 90, 115, 100, 112, 88, 98, 125, 70, 118, 132, 92, 104, 115]
      };

      function norm(val, min, max) {
        return Math.max(0, Math.min(1, (val - min) / Math.max(1e-9, max - min)));
      }

      function renderAll() {
        if (!currentStats) return;
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        const isWeb = activeBaseline === "web_novel";
        const labelText = isWeb ? "Web Novel" : "Classic Lit";
        const dotColor = isWeb
          ? (isLight ? "#7c3aed" : "#a78bfa")
          : (isLight ? "#d97706" : "#fbbf24");
        
        const rLbl = document.getElementById("radarBaselineLegendLabel");
        const aLbl = document.getElementById("baselineLegendLabel");
        const pLbl = document.getElementById("pacingBaselineLegendLabel");
        if (rLbl) rLbl.textContent = labelText;
        if (aLbl) aLbl.textContent = labelText;
        if (pLbl) pLbl.textContent = labelText;
        
        const rDot = document.getElementById("radarBaselineLegendDot");
        const aDot = document.getElementById("arcBaselineLegendDot");
        const pDot = document.getElementById("pacingBaselineLegendDot");
        if (rDot) rDot.style.backgroundColor = dotColor;
        if (aDot) aDot.style.backgroundColor = dotColor;
        if (pDot) pDot.style.backgroundColor = dotColor;

        drawRadar(currentStats, activeBaseline);
        if (currentArc) drawArc(currentArc, activeBaseline);
        drawPacing(currentStats, activeBaseline);
      }


      /* ── Radar chart (Canvas) ── */
      function drawRadar(stats, baseline) {
        const canvas = document.getElementById("radarChart");
        if (!canvas) return;
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        const dpr = window.devicePixelRatio || 1;

        const rect = canvas.getBoundingClientRect();
        const cssW = (rect.width > 50 ? rect.width : (canvas.clientWidth || 480));
        const cssH = (rect.height > 50 ? rect.height : (canvas.clientHeight || 480));
        canvas.width  = Math.round(cssW * dpr);
        canvas.height = Math.round(cssH * dpr);

        const ctx = canvas.getContext("2d");
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const W = cssW, H = cssH;
        const cx = W / 2, cy = H / 2;
        const labelPad = 80;
        const R  = Math.min(W, H) / 2 - labelPad;
        const n  = RADAR_DIMS.length;

        /* Grid rings */
        for (let ring = 5; ring >= 1; ring--) {
          ctx.beginPath();
          for (let i = 0; i < n; i++) {
            const angle = (2 * Math.PI * i / n) - Math.PI / 2;
            const r = R * ring / 5;
            const x = cx + r * Math.cos(angle);
            const y = cy + r * Math.sin(angle);
            i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
          }
          ctx.closePath();
          if (ring % 2 === 1) {
            ctx.fillStyle = isLight ? "rgba(2, 132, 199, 0.03)" : "rgba(255, 255, 255, 0.015)";
            ctx.fill();
          }
          ctx.strokeStyle = isLight ? "rgba(2, 132, 199, 0.16)" : "rgba(255, 255, 255, 0.08)";
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.fillStyle = isLight ? "rgba(2, 132, 199, 0.70)" : "rgba(255, 255, 255, 0.3)";
          ctx.font = "600 10px Inter, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(`${ring * 20}%`, cx + 4, cy - R * ring / 5 - 7);
        }

        /* Spokes + axis labels */
        RADAR_DIMS.forEach((dim, i) => {
          const isHovered = hoveredIndex === i;
          const angle = (2 * Math.PI * i / n) - Math.PI / 2;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + R * Math.cos(angle), cy + R * Math.sin(angle));
          
          ctx.strokeStyle = isLight
            ? (isHovered ? "rgba(2, 132, 199, 0.60)" : "rgba(2, 132, 199, 0.20)")
            : (isHovered ? "rgba(255, 255, 255, 0.38)" : "rgba(255, 255, 255, 0.15)");
          ctx.lineWidth = isHovered ? 2.5 : 1;
          ctx.stroke();

          const labelR = R + 38;
          const lx = cx + labelR * Math.cos(angle);
          const ly = cy + labelR * Math.sin(angle);

          const words = dim.label.split(" ");
          ctx.fillStyle = isHovered
            ? (isLight ? "#0284c7" : "#7dd3fc")
            : (isLight ? "#0369a1" : "#cbd5e1");
          ctx.font = isHovered ? "bold 11px Inter, sans-serif" : "bold 10px Inter, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          if (words.length === 2) {
            ctx.fillText(words[0], lx, ly - 6);
            ctx.fillText(words[1], lx, ly + 6);
          } else {
            ctx.fillText(dim.label, lx, ly);
          }
        });

        function plotPolygon(values, strokeColor, fillColor) {
          ctx.beginPath();
          values.forEach((v, i) => {
            const angle = (2 * Math.PI * i / n) - Math.PI / 2;
            const r = R * Math.max(0, Math.min(1, v));
            i === 0 ? ctx.moveTo(cx + r * Math.cos(angle), cy + r * Math.sin(angle))
                    : ctx.lineTo(cx + r * Math.cos(angle), cy + r * Math.sin(angle));
          });
          ctx.closePath();
          ctx.fillStyle = fillColor;
          ctx.fill();
          ctx.strokeStyle = strokeColor;
          ctx.lineWidth = 2;
          ctx.stroke();
        }

        const hasHover = hoveredIndex !== -1;
        const blOpacityStroke = hasHover ? (isLight ? 0.45 : 0.35) : (isLight ? 0.90 : 0.8);
        const blOpacityFill   = hasHover ? (isLight ? 0.08 : 0.04) : (isLight ? 0.18 : 0.12);
        const userOpacityStroke = hasHover ? (isLight ? 0.50 : 0.40) : (isLight ? 0.95 : 0.85);
        const userOpacityFill   = hasHover ? (isLight ? 0.08 : 0.03) : (isLight ? 0.18 : 0.10);

        const isWeb = baseline === "web_novel";
        const blColor = isWeb
          ? (isLight ? "#7c3aed" : "#a78bfa")
          : (isLight ? "#d97706" : "#fbbf24");
        const blRgb = isWeb
          ? (isLight ? "124, 58, 237" : "167, 139, 250")
          : (isLight ? "217, 119, 6" : "251, 191, 36");

        const userColor = isLight ? "#0284c7" : "#7dd3fc";
        const userRgb   = isLight ? "2, 132, 199" : "125, 211, 252";

        const blVals = (stats && stats.baselines && stats.baselines.radar && stats.baselines.radar[baseline])
          ? stats.baselines.radar[baseline]
          : RADAR_BASELINES[baseline];

        plotPolygon(
          blVals,
          `rgba(${blRgb}, ${blOpacityStroke})`,
          `rgba(${blRgb}, ${blOpacityFill})`
        );

        if (stats) {
          const prefix = Object.keys(stats).find(k => k.startsWith("zh_")) ? "zh_" :
                         Object.keys(stats).find(k => k.startsWith("ja_")) ? "ja_" : "en_";
          const userVals = RADAR_DIMS.map(d => {
            const baseKey = d.key.replace(/^en_/, "");
            const statsKey = `${prefix}${baseKey}`;
            if (stats.normalized_radar) {
              if (stats.normalized_radar[statsKey] !== undefined) return stats.normalized_radar[statsKey];
              if (stats.normalized_radar[baseKey] !== undefined) return stats.normalized_radar[baseKey];
              if (stats.normalized_radar[`en_${baseKey}`] !== undefined) return stats.normalized_radar[`en_${baseKey}`];
              if (stats.normalized_radar[`ja_${baseKey}`] !== undefined) return stats.normalized_radar[`ja_${baseKey}`];
              if (stats.normalized_radar[`zh_${baseKey}`] !== undefined) return stats.normalized_radar[`zh_${baseKey}`];
            }
            const rawVal = stats[statsKey] ?? stats[baseKey] ?? stats[`en_${baseKey}`] ?? stats[`ja_${baseKey}`];
            if (rawVal !== undefined && rawVal !== null) {
              return norm(rawVal, d.min, d.max);
            }
            return 0.0;
          });

          const hasUserData = userVals.some(v => v > 0);
          if (hasUserData) {
            plotPolygon(
              userVals,
              `rgba(${userRgb}, ${userOpacityStroke})`,
              `rgba(${userRgb}, ${userOpacityFill})`
            );

            /* Dot on each axis */
            userVals.forEach((v, i) => {
              const isHovered = hoveredIndex === i;
              const angle = (2 * Math.PI * i / n) - Math.PI / 2;
              const r = R * Math.max(0, Math.min(1, v));
              ctx.beginPath();
              
              if (isHovered) {
                ctx.shadowBlur = 8;
                ctx.shadowColor = userColor;
                ctx.arc(cx + r * Math.cos(angle), cy + r * Math.sin(angle), 6, 0, 2 * Math.PI);
                ctx.fillStyle = userColor;
                ctx.fill();
                ctx.strokeStyle = isLight ? "#ffffff" : "rgba(255,255,255,0.95)";
                ctx.lineWidth = 2.5;
                ctx.stroke();
                ctx.shadowBlur = 0;
              } else {
                ctx.arc(cx + r * Math.cos(angle), cy + r * Math.sin(angle), 3.5, 0, 2 * Math.PI);
                ctx.fillStyle = hasHover ? `rgba(${userRgb}, 0.4)` : userColor;
                ctx.fill();
              }
            });
          }

          if (hasHover) {
            const blVal = blVals[hoveredIndex];
            const angle = (2 * Math.PI * hoveredIndex / n) - Math.PI / 2;
            const r = R * Math.max(0, Math.min(1, blVal));
            ctx.beginPath();
            ctx.shadowBlur = 8;
            ctx.shadowColor = blColor;
            ctx.arc(cx + r * Math.cos(angle), cy + r * Math.sin(angle), 6, 0, 2 * Math.PI);
            ctx.fillStyle = blColor;
            ctx.fill();
            ctx.strokeStyle = isLight ? "#ffffff" : "rgba(255,255,255,0.95)";
            ctx.lineWidth = 2.5;
            ctx.stroke();
            ctx.shadowBlur = 0;
          }

          renderArchetypeTaxonomy(stats);
        }
      }

      function renderArchetypeTaxonomy(stats) {
        const am = stats["archetype_match"] || {};
        const tax = stats["taxonomy"] || am.taxonomy || {};
        const isLight = document.documentElement.getAttribute("data-theme") === "light";

        // 1. Primary Archetype & Territory Header Label
        const labelEl = document.getElementById("archetypeLabel");
        if (labelEl) {
          if (am.top_genres && am.top_territories && am.top_territories.length > 0) {
            const genresStr = am.top_genres.slice(0, 3).map(g => `${g.genre} (${Math.min(99, Math.max(1, Math.round(g.confidence * 100)))}%)`).join(", ");
            const tConf = am.top_territories[0].confidence !== undefined
              ? ` (${Math.min(99, Math.max(1, Math.round(am.top_territories[0].confidence * 100)))}%)`
              : "";
            const territoryStr = `${am.top_territories[0].territory}${tConf}`;
            labelEl.textContent = `${genresStr} · ${territoryStr}`;
          } else {
            const tropeConf = Math.min(99, Math.max(1, Math.round((am.confidence || 0.75) * 100)));
            labelEl.textContent = `${am.closest_trope || 'Unknown'} (${tropeConf}%) · ${am.territory || 'Classic Literature Territory'}`;
          }
        }

        // 2. 3-Pillar Taxonomy Badges
        const pillarsEl = document.getElementById("taxonomyPillars");
        if (pillarsEl) {
          if (tax.world_setting || tax.narrative_plot || tax.inciting_event) {
            const incitingVal = tax.inciting_event?.primary;
            const incitingScore = tax.inciting_event?.score ? Math.round(tax.inciting_event.score * 100) : null;
            const worldVal = tax.world_setting?.primary;
            const worldScore = tax.world_setting?.score ? Math.round(tax.world_setting.score * 100) : null;
            const plotVal = tax.narrative_plot?.primary;
            const plotScore = tax.narrative_plot?.score ? Math.round(tax.narrative_plot.score * 100) : null;

            let html = '<div class="taxonomy-pillars-grid">';
            if (incitingVal) {
              html += `
                <div class="pillar-card inciting">
                  <span class="pillar-tag">Inciting Catalyst</span>
                  <span class="pillar-name">${incitingVal} ${incitingScore ? `<span class="pillar-score">${incitingScore}%</span>` : ''}</span>
                </div>
              `;
            }
            if (worldVal) {
              html += `
                <div class="pillar-card world">
                  <span class="pillar-tag">World Setting</span>
                  <span class="pillar-name">${worldVal} ${worldScore ? `<span class="pillar-score">${worldScore}%</span>` : ''}</span>
                </div>
              `;
            }
            if (plotVal) {
              html += `
                <div class="pillar-card plot">
                  <span class="pillar-tag">Narrative Plot</span>
                  <span class="pillar-name">${plotVal} ${plotScore ? `<span class="pillar-score">${plotScore}%</span>` : ''}</span>
                </div>
              `;
            }
            html += '</div>';
            pillarsEl.innerHTML = html;
            pillarsEl.style.display = "block";
          } else {
            pillarsEl.innerHTML = "";
            pillarsEl.style.display = "none";
          }
        }

        // 3. Dynamic Genre Affinities (>= 65%)
        const rawGenreScores = tax.genre_scores || am.genre_scores || am.top_genres || [];
        const normalizedScores = rawGenreScores.map(g => ({
          genre: g.genre,
          score: g.score !== undefined ? g.score : (g.confidence !== undefined ? g.confidence : 0)
        })).sort((a, b) => b.score - a.score);

        const affinitiesTrack = document.getElementById("genreAffinitiesTrack");
        const highAffinities = normalizedScores.filter(g => g.score >= 0.65);
        const displayedAffinities = highAffinities.length >= 2 ? highAffinities : normalizedScores.slice(0, 4);

        if (affinitiesTrack && displayedAffinities.length > 0) {
          let pillsHtml = `
            <div class="affinities-header">
              <span class="affinities-title">Key Genre Affinities (≥65%)</span>
            </div>
            <div class="affinity-pills-row">
          `;
          displayedAffinities.forEach(g => {
            const pct = Math.min(99, Math.max(1, Math.round(g.score * 100)));
            let tierClass = pct >= 85 ? "tier-vibrant" : pct >= 75 ? "tier-cyan" : "tier-emerald";
            pillsHtml += `<span class="genre-affinity-pill ${tierClass}">${g.genre} <strong class="pill-pct">${pct}%</strong></span>`;
          });
          pillsHtml += '</div>';
          affinitiesTrack.innerHTML = pillsHtml;
          affinitiesTrack.style.display = "block";
        } else if (affinitiesTrack) {
          affinitiesTrack.innerHTML = "";
          affinitiesTrack.style.display = "none";
        }

        // 4. Expandable Drawer for All 17 Genres
        const drawerBtn = document.getElementById("toggleAllGenresBtn");
        const drawerEl = document.getElementById("allGenresDrawer");
        if (drawerBtn && drawerEl && normalizedScores.length > 0) {
          let drawerHtml = `
            <div class="all-genres-grid">
          `;
          normalizedScores.forEach(g => {
            const pct = Math.min(99, Math.max(1, Math.round(g.score * 100)));
            let barColor = isLight
              ? (pct >= 80 ? "#6366f1" : pct >= 65 ? "#0284c7" : pct >= 45 ? "#059669" : "#64748b")
              : (pct >= 80 ? "#a78bfa" : pct >= 65 ? "#38bdf8" : pct >= 45 ? "#34d399" : "rgba(255,255,255,0.25)");
            drawerHtml += `
              <div class="genre-rank-row">
                <div class="genre-rank-info">
                  <span class="genre-rank-name">${g.genre}</span>
                  <span class="genre-rank-score" style="color: ${barColor};">${pct}%</span>
                </div>
                <div class="genre-rank-track">
                  <div class="genre-rank-fill" style="width: ${pct}%; background: ${barColor};"></div>
                </div>
              </div>
            `;
          });
          drawerHtml += '</div>';
          drawerEl.innerHTML = drawerHtml;
          drawerBtn.style.display = "inline-flex";

          drawerBtn.onclick = () => {
            const isHidden = drawerEl.style.display === "none";
            drawerEl.style.display = isHidden ? "block" : "none";
            const txt = document.getElementById("toggleAllGenresText");
            const chev = document.getElementById("toggleAllGenresChevron");
            if (txt) txt.textContent = isHidden ? "Hide All 17 Genres" : "View All 17 Ranked Genres";
            if (chev) chev.style.transform = isHidden ? "rotate(180deg)" : "rotate(0deg)";
          };
        } else if (drawerBtn) {
          drawerBtn.style.display = "none";
        }
      }

      /* ── Kishōtenketsu arc (SVG) ── */
      function drawArc(arcData, baseline) {
        const svg = document.getElementById("arcChart");
        if (!svg || !arcData) return;
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        svg.innerHTML = "";
        const W = 600, H = 420;
        const PAD = { top: 30, bottom: 48, left: 48, right: 48 };
        const plotW = W - PAD.left - PAD.right;
        const plotH = H - PAD.top - PAD.bottom;
        const ns = "http://www.w3.org/2000/svg";

        const acts    = (arcData.quantiles && arcData.quantiles.length > 0)
          ? arcData.quantiles.map((v, i) => ({ sentiment: v, actIndex: i }))
          : arcData.acts || [];
        if (acts.length === 0) return;

        const blVals  = (arcData.baselines && arcData.baselines[baseline])
          ? arcData.baselines[baseline]
          : [0.0839, 0.0588, 0.1347, 0.1006];
        const isWeb   = baseline === "web_novel";
        const blColor = isWeb
          ? (isLight ? "#7c3aed" : "#a78bfa")
          : (isLight ? "#d97706" : "#fbbf24");
        const blRgb   = isWeb
          ? (isLight ? "124, 58, 237" : "167, 139, 250")
          : (isLight ? "217, 119, 6" : "251, 191, 36");
        const userColor = isLight ? "#0284c7" : "#7dd3fc";
        const userRgb   = isLight ? "2, 132, 199" : "125, 211, 252";

        const sentY = s => {
          const clamped = Math.max(-1.0, Math.min(1.0, s));
          return PAD.top + plotH * (1 - (clamped + 1) / 2);
        };
        const actX  = i => PAD.left + i * plotW / (acts.length - 1);
        const axisX  = actX(0);
        const endX   = actX(acts.length - 1);
        const bottomY = PAD.top + plotH;
        const zeroY   = sentY(0);

        /* ── Smooth Catmull-Rom / Hermite Spline ── */
        function smoothPath(pts_x, pts_y) {
          const n = pts_x.length;
          if (n === 0) return "";
          if (n === 1) return `M ${pts_x[0].toFixed(1)},${pts_y[0].toFixed(1)}`;
          let d = `M ${pts_x[0].toFixed(1)},${pts_y[0].toFixed(1)}`;
          for (let i = 0; i < n - 1; i++) {
            const x0 = pts_x[i === 0 ? 0 : i - 1];
            const y0 = pts_y[i === 0 ? 0 : i - 1];
            const x1 = pts_x[i];
            const y1 = pts_y[i];
            const x2 = pts_x[i + 1];
            const y2 = pts_y[i + 1];
            const x3 = pts_x[i + 2 >= n ? n - 1 : i + 2];
            const y3 = pts_y[i + 2 >= n ? n - 1 : i + 2];

            const cp1x = x1 + (x2 - x0) / 6;
            const cp1y = y1 + (y2 - y0) / 6;
            const cp2x = x2 - (x3 - x1) / 6;
            const cp2y = y2 - (y3 - y1) / 6;

            d += ` C ${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`;
          }
          return d;
        }

        const xs      = acts.map((_, i) => actX(i));
        const userYs  = acts.map(a => sentY(typeof a === "number" ? a : a.sentiment));
        const blYs    = blVals.map(v => sentY(v));
        const pathD   = smoothPath(xs, userYs);
        const blPathD = smoothPath(xs, blYs);

        const areaClose = (path, xArr) =>
          `${path} L ${xArr[xArr.length-1].toFixed(1)},${zeroY.toFixed(1)} L ${xArr[0].toFixed(1)},${zeroY.toFixed(1)} Z`;

        const userAvgAbs = acts.reduce((s, a) => s + Math.abs(typeof a === "number" ? a : a.sentiment), 0) / acts.length;
        const blAvgAbs   = blVals.reduce((s, v) => s + Math.abs(v), 0) / blVals.length;
        const userIsInner = userAvgAbs <= blAvgAbs;
        const [innerPathD, outerPathD] = userIsInner ? [pathD, blPathD] : [blPathD, pathD];
        const [innerGrad,  outerGrad]  = userIsInner ? ["arcUserGrad", "arcBaselineGrad"] : ["arcBaselineGrad", "arcUserGrad"];

        /* ── Gradients Defs ── */
        const defs = document.createElementNS(ns, "defs");
        const zf = (zeroY - PAD.top) / plotH;

        const makeGrad = (id, rgb, alpha) => {
          const g = document.createElementNS(ns, "linearGradient");
          g.setAttribute("id", id);
          g.setAttribute("gradientUnits", "userSpaceOnUse");
          g.setAttribute("x1", "0"); g.setAttribute("y1", String(PAD.top));
          g.setAttribute("x2", "0"); g.setAttribute("y2", String(bottomY));
          const pct = p => `${(Math.max(0, Math.min(1, p)) * 100).toFixed(1)}%`;
          const minA = (alpha * (isLight ? 0.35 : 0.40)).toFixed(3);
          [
            [0,   `rgba(${rgb},${alpha})`],
            [zf,  `rgba(${rgb},${minA})`],
            [1,   `rgba(${rgb},${alpha})`],
          ].forEach(([offset, color]) => {
            const s = document.createElementNS(ns, "stop");
            s.setAttribute("offset", pct(offset));
            s.setAttribute("stop-color", color);
            g.appendChild(s);
          });
          return g;
        };

        defs.appendChild(makeGrad("arcUserGrad",     userRgb, isLight ? 0.35 : 0.80));
        defs.appendChild(makeGrad("arcBaselineGrad", blRgb,   isLight ? 0.30 : 0.75));

        const clipPath = document.createElementNS(ns, "clipPath");
        clipPath.setAttribute("id", "outerFillClip");
        const clipShape = document.createElementNS(ns, "path");
        const boundingRect =
          `M ${axisX.toFixed(1)},${PAD.top} L ${endX.toFixed(1)},${PAD.top}` +
          ` L ${endX.toFixed(1)},${bottomY} L ${axisX.toFixed(1)},${bottomY} Z`;
        clipShape.setAttribute("d", `${boundingRect} ${areaClose(innerPathD, xs)}`);
        clipShape.setAttribute("clip-rule", "evenodd");
        clipPath.appendChild(clipShape);
        defs.appendChild(clipPath);
        svg.appendChild(defs);

        // Vertical guide line when hovering
        if (hoveredArcIndex >= 0 && hoveredArcIndex < acts.length) {
          const hx = actX(hoveredArcIndex);
          const vGuide = document.createElementNS(ns, "line");
          vGuide.setAttribute("x1", hx); vGuide.setAttribute("y1", PAD.top);
          vGuide.setAttribute("x2", hx); vGuide.setAttribute("y2", bottomY);
          vGuide.setAttribute("stroke", isLight ? "rgba(15, 23, 42, 0.25)" : "rgba(255, 255, 255, 0.25)");
          vGuide.setAttribute("stroke", isLight ? "rgba(2, 132, 199, 0.35)" : "rgba(255, 255, 255, 0.25)");
          vGuide.setAttribute("stroke-dasharray", "3 3");
          svg.appendChild(vGuide);
        }

        /* ── Grid lines ── */
        [-1, -0.5, 0, 0.5, 1].forEach(val => {
          const y = sentY(val);
          const isZero = val === 0;

          const line = document.createElementNS(ns, "line");
          line.setAttribute("x1", String(axisX));
          line.setAttribute("y1", y);
          line.setAttribute("x2", String(endX));
          line.setAttribute("y2", y);
          line.setAttribute("stroke", isZero
            ? (isLight ? "rgba(2, 132, 199, 0.35)" : "rgba(255, 255, 255, 0.3)")
            : (isLight ? "rgba(2, 132, 199, 0.10)" : "rgba(255, 255, 255, 0.055)"));
          if (!isZero) line.setAttribute("stroke-dasharray", "4 5");
          svg.appendChild(line);

          const lbl = document.createElementNS(ns, "text");
          lbl.setAttribute("x", String(axisX - 8));
          lbl.setAttribute("y", y + 3.5);
          lbl.setAttribute("fill", isLight ? "#0369a1" : "rgba(255, 255, 255, 0.3)");
          lbl.setAttribute("font-size", "9");
          lbl.setAttribute("font-family", "Inter, sans-serif");
          lbl.setAttribute("text-anchor", "end");
          lbl.textContent = val > 0 ? `+${val.toFixed(1)}` : val.toFixed(1);
          svg.appendChild(lbl);
        });

        // Y-axis line
        const yAxis = document.createElementNS(ns, "line");
        yAxis.setAttribute("x1", String(axisX)); yAxis.setAttribute("y1", String(PAD.top));
        yAxis.setAttribute("x2", String(axisX)); yAxis.setAttribute("y2", String(bottomY));
        yAxis.setAttribute("stroke", isLight ? "rgba(2, 132, 199, 0.20)" : "rgba(255, 255, 255, 0.15)");
        svg.appendChild(yAxis);

        // X-axis line & labels
        const xAxis = document.createElementNS(ns, "line");
        xAxis.setAttribute("x1", String(axisX)); xAxis.setAttribute("y1", String(bottomY));
        xAxis.setAttribute("x2", String(endX));  xAxis.setAttribute("y2", String(bottomY));
        xAxis.setAttribute("stroke", isLight ? "#cbd5e1" : "rgba(255, 255, 255, 0.15)");
        svg.appendChild(xAxis);

        ["Ki (Intro)", "Shō (Dev)", "Ten (Twist)", "Ketsu (Res)"].forEach((label, i) => {
          const lx = actX(i);
          const tick = document.createElementNS(ns, "line");
          tick.setAttribute("x1", lx); tick.setAttribute("y1", bottomY);
          tick.setAttribute("x2", lx); tick.setAttribute("y2", bottomY + 4);
          tick.setAttribute("stroke", isLight ? "#e2e8f0" : "rgba(255, 255, 255, 0.07)");
          svg.appendChild(tick);

          const txt = document.createElementNS(ns, "text");
          txt.setAttribute("x", lx); txt.setAttribute("y", bottomY + 16);
          txt.setAttribute("fill", isLight ? "#64748b" : "rgba(255, 255, 255, 0.45)");
          txt.setAttribute("font-size", "10"); txt.setAttribute("font-weight", "600");
          txt.setAttribute("font-family", "Inter, sans-serif");
          txt.setAttribute("text-anchor", "middle");
          txt.textContent = label;
          svg.appendChild(txt);
        });

        // Outer fill
        const outerFill = document.createElementNS(ns, "path");
        outerFill.setAttribute("d", areaClose(outerPathD, xs));
        outerFill.setAttribute("fill", `url(#${outerGrad})`);
        outerFill.setAttribute("clip-path", "url(#outerFillClip)");
        svg.appendChild(outerFill);

        // Inner fill
        const innerFill = document.createElementNS(ns, "path");
        innerFill.setAttribute("d", areaClose(innerPathD, xs));
        innerFill.setAttribute("fill", `url(#${innerGrad})`);
        svg.appendChild(innerFill);

        // Baseline stroke
        const blPath = document.createElementNS(ns, "path");
        blPath.setAttribute("d", blPathD);
        blPath.setAttribute("fill", "none");
        blPath.setAttribute("stroke", blColor);
        blPath.setAttribute("stroke-width", "1.75");
        blPath.setAttribute("stroke-dasharray", "5 4");
        blPath.setAttribute("opacity", isLight ? "0.95" : "0.85");
        svg.appendChild(blPath);

        // User stroke
        const userPath = document.createElementNS(ns, "path");
        userPath.setAttribute("d", pathD);
        userPath.setAttribute("fill", "none");
        userPath.setAttribute("stroke", userColor);
        userPath.setAttribute("stroke-width", "2.5");
        svg.appendChild(userPath);

        // Dots
        xs.forEach((x, i) => {
          const userDot = document.createElementNS(ns, "circle");
          userDot.setAttribute("cx", x); userDot.setAttribute("cy", userYs[i]);
          userDot.setAttribute("r", i === hoveredArcIndex ? "6" : "4");
          userDot.setAttribute("fill", userColor);
          userDot.setAttribute("stroke", isLight ? "#ffffff" : "#0a0a12");
          userDot.setAttribute("stroke-width", "2");
          svg.appendChild(userDot);

          const blDot = document.createElementNS(ns, "circle");
          blDot.setAttribute("cx", x); blDot.setAttribute("cy", blYs[i]);
          blDot.setAttribute("r", i === hoveredArcIndex ? "5" : "3.5");
          blDot.setAttribute("fill", blColor);
          blDot.setAttribute("stroke", isLight ? "#ffffff" : "#0a0a12");
          blDot.setAttribute("stroke-width", "1.5");
          svg.appendChild(blDot);
        });
      }

      /* ── Rhythmic Pacing (Paragraph Barcode) ── */
      function drawPacing(stats, baseline) {
        if (!stats) return;
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        const userPacing = stats.pacing || [];
        const isWeb = baseline === "web_novel";
        const baselineColor = isWeb
          ? (isLight ? "linear-gradient(180deg, #a78bfa 0%, #7c3aed 100%)" : "linear-gradient(180deg, #c084fc 0%, #7c3aed 100%)")
          : (isLight ? "linear-gradient(180deg, #fbbf24 0%, #d97706 100%)" : "linear-gradient(180deg, #fde68a 0%, #d97706 100%)");
        const userColor = isLight
          ? "linear-gradient(180deg, #38bdf8 0%, #0284c7 100%)"
          : "linear-gradient(180deg, #7dd3fc 0%, #0284c7 100%)";
        const baselineData = (stats.baselines && stats.baselines.pacing)
          ? stats.baselines.pacing[baseline]
          : PACING_BASELINES[baseline];

        const userAvg = userPacing.length > 0 ? (userPacing.reduce((a,b)=>a+b,0)/userPacing.length).toFixed(1) : 0;
        const baseAvg = (baselineData.reduce((a,b)=>a+b,0)/baselineData.length).toFixed(1);

        const draftLabel = document.getElementById("pacingDraftLabel");
        const baseLabel  = document.getElementById("pacingBaselineLabel");
        if (draftLabel) {
          draftLabel.textContent = `Selected Novel (Average Paragraph Length: ${userAvg} words/chars)`;
          draftLabel.style.color = isLight ? "#475569" : "rgba(255,255,255,0.6)";
        }
        if (baseLabel) {
          baseLabel.textContent = `${isWeb ? "Web Novel" : "Classic Lit"} Baseline (Average Paragraph Length: ${baseAvg} words/chars)`;
          baseLabel.style.color = isLight ? "#475569" : "rgba(255,255,255,0.6)";
        }

        renderBarcode("pacingBarcodeUser", userPacing, userColor);
        renderBarcode("pacingBarcodeBaseline", baselineData, baselineColor);
      }

      function renderBarcode(containerId, data, barGradient) {
        const container = document.getElementById(containerId);
        if (!container) return;
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        container.className = "pacing-barcode-track";
        container.innerHTML = "";
        container.style.background = "";
        container.style.border = "";
        container.style.boxShadow = "";

        if (!data || data.length === 0) {
          container.innerHTML = `<div style='color: ${isLight ? "#64748b" : "rgba(255,255,255,0.35)"}; font-size:0.8rem; padding: 1rem; width:100%; text-align:center;'>No paragraph pacing data available</div>`;
          return;
        }

        const maxVal = Math.max(...data, 1);
        data.forEach((val, idx) => {
          const intensity = val / maxVal;
          const bar = document.createElement("div");
          bar.className = "pacing-bar";
          bar.style.background = barGradient;
          bar.style.opacity = Math.max(isLight ? 0.45 : 0.25, intensity).toFixed(2);
          if (isLight) {
            bar.style.boxShadow = "0 1px 2px rgba(15, 23, 42, 0.08)";
          }
          bar.title = `Paragraph #${idx + 1}: ${val} words/chars`;
          container.appendChild(bar);
        });
      }

      /* ── Doppelgängers / Similar Novels Renderer ── */
      function renderSimilarNovels(matches) {
        const container = document.getElementById("similarNovelsContainer");
        if (!container) return;
        const isLight = document.documentElement.getAttribute("data-theme") === "light";
        container.innerHTML = "";

        if (!matches || matches.length === 0) {
          container.innerHTML = `<p style="color: #64748b; font-size: 13px; margin: 0; padding: 12px;">No similar matches found.</p>`;
          return;
        }

        matches.forEach((m, index) => {
          const item = document.createElement("div");
          item.className = "doppelganger-item";
          item.addEventListener("click", () => selectNovel(m.id, m.title));

          const storyPct = m.story_similarity || Math.round((m.breakdown?.story || m.breakdown?.semantic || m.similarity_score || 0) * 100);
          const stylePct = m.style_similarity || Math.round((m.breakdown?.style || 0) * 100);
          const topGenres = (m.genre || 'Fiction').split(',').map(g => g.trim()).filter(Boolean).slice(0, 3).join(', ');

          const hasComparisons = Array.isArray(m.metric_comparisons) && m.metric_comparisons.length > 0;
          
          let badgesHtml = '';
          if (Array.isArray(m.match_badges) && m.match_badges.length > 0) {
            badgesHtml = `
              <div class="doppelganger-reasons">
                ${m.match_badges.map(b => `
                  <span class="reason-pill tier-${b.tier || 'cyan'}"><strong>${b.label}:</strong> ${b.detail}</span>
                `).join('')}
              </div>
            `;
          } else if (Array.isArray(m.reasons) && m.reasons.length > 0) {
            badgesHtml = `
              <div class="doppelganger-reasons">
                ${m.reasons.slice(0, 4).map(r => `<span class="reason-pill tier-cyan">${r}</span>`).join('')}
              </div>
            `;
          }

          item.innerHTML = `
            <div class="doppelganger-main">
              <div class="doppelganger-left">
                <span class="doppelganger-rank">#${index + 1}</span>
                <div class="doppelganger-info">
                  <h4 class="doppelganger-item-title">${m.title}</h4>
                  ${m.author ? `<span class="doppelganger-author">${m.author}</span>` : ''}
                  <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 4px;">
                    <span class="doppelganger-badge">${topGenres}</span>
                    ${hasComparisons || m.narrative_reasoning ? `
                      <button type="button" class="doppelganger-why-btn" data-drawer-id="doppelganger-drawer-${m.id}" aria-expanded="false">
                        Story & Style Breakdown <span class="why-chevron">▾</span>
                      </button>
                    ` : ''}
                  </div>
                  ${badgesHtml}
                </div>
              </div>

              <div class="doppelganger-right">
                <div class="doppelganger-scores-dual">
                  <div class="doppelganger-score-chip story" title="Story & Plot Content Match (Premise, Setting & Conflict)">
                    <span class="score-chip-label">Story Match</span>
                    <span class="score-chip-val">${storyPct}%</span>
                  </div>
                  <div class="doppelganger-score-chip style" title="Prose Style & Sentence Cadence Match">
                    <span class="score-chip-label">Style Match</span>
                    <span class="score-chip-val">${stylePct}%</span>
                  </div>
                </div>
                ${m.breakdown ? `
                  <div class="doppelganger-breakdown">
                    ${[
                      { label: 'SEM', name: 'Story Premise', val: m.breakdown.semantic },
                      { label: 'GEN', name: 'Genre & Setting', val: m.breakdown.genre },
                      { label: 'TAG', name: 'Narrative Tropes', val: m.breakdown.tags },
                      { label: 'STY', name: 'Prose Cadence', val: m.breakdown.style }
                    ].map(f => {
                      const fPct = Math.round((f.val || 0) * 100);
                      const fColor = f.val > 0.8 ? (isLight ? '#0284c7' : '#38bdf8') : (isLight ? '#64748b' : '#94a3b8');
                      return `
                        <div class="doppelganger-factor" title="${f.name}: ${fPct}%">
                          <span class="doppelganger-factor-label">${f.label}</span>
                          <div class="doppelganger-factor-bar-bg">
                            <div class="doppelganger-factor-bar-fill" style="width: ${fPct}%; background-color: ${fColor}"></div>
                          </div>
                        </div>
                      `;
                    }).join('')}
                  </div>
                ` : ''}
              </div>
            </div>

            ${hasComparisons || m.narrative_reasoning ? `
              <div id="doppelganger-drawer-${m.id}" class="doppelganger-drawer" style="display: none;">
                ${m.narrative_reasoning?.narrative_synthesis ? `
                  <div class="narrative-synthesis-box">
                    <div class="synthesis-tag">📖 Narrative Synthesis</div>
                    <p class="synthesis-text">"${m.narrative_reasoning.narrative_synthesis}"</p>
                  </div>
                ` : ''}

                ${m.narrative_reasoning?.pillars ? `
                  <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #a78bfa; margin-bottom: 4px; margin-top: 12px;">
                    4-Pillar Narrative Alignment (85% Ranking Weight)
                  </div>
                  <div class="pillars-grid">
                    ${['catalyst', 'setting', 'conflict', 'style_cadence'].map(pKey => {
                      const p = m.narrative_reasoning.pillars[pKey];
                      if (!p) return '';
                      const meta = {
                        catalyst: { icon: "⚡", title: "Premise & Inciting Catalyst", color: "linear-gradient(90deg, #818cf8, #a78bfa)" },
                        setting: { icon: "🏰", title: "World Setting & Atmosphere", color: "linear-gradient(90deg, #38bdf8, #67e8f9)" },
                        conflict: { icon: "⚔️", title: "Conflict Stakes & Tension", color: "linear-gradient(90deg, #f43f5e, #fb7185)" },
                        style_cadence: { icon: "✍️", title: "Prose Voice & Cadence", color: "linear-gradient(90deg, #34d399, #6ee7b7)" }
                      }[pKey] || { icon: "🔹", title: pKey, color: "#a78bfa" };

                      const scorePct = Math.round((p.score || 0) * 100);
                      const qVal = p.query_val || p.value || 'N/A';
                      const cVal = p.cand_val || p.value || 'N/A';

                      return `
                        <div class="pillar-card">
                          <div class="pillar-card-header">
                            <div class="pillar-title-group">
                              <span class="pillar-icon">${meta.icon}</span>
                              <strong>${p.name || meta.title}</strong>
                            </div>
                            <span class="pillar-score-badge">${scorePct}%</span>
                          </div>
                          
                          <div class="pillar-score-bar-bg">
                            <div class="pillar-score-bar-fill" style="width: ${scorePct}%; background: ${meta.color};"></div>
                          </div>

                          <div class="pillar-mapping-container">
                            <div class="pillar-capsule" title="Target Novel: ${qVal}">
                              <span class="capsule-label">Target Novel</span>
                              <span class="capsule-value">${qVal}</span>
                            </div>
                            <span class="pillar-arrow">➔</span>
                            <div class="pillar-capsule" title="Matched Work: ${cVal}">
                              <span class="capsule-label">Matched Work</span>
                              <span class="capsule-value">${cVal}</span>
                            </div>
                          </div>

                          <p class="pillar-desc">${p.explanation}</p>
                        </div>
                      `;
                    }).join('')}
                  </div>
                ` : `
                  <div style="margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #a78bfa; margin-bottom: 4px;">
                      Story & Thematic Anatomy (85% Ranking Weight)
                    </div>
                    <div style="display: flex; gap: 8px; flex-wrap: wrap; font-size: 0.75rem; color: var(--color-muted);">
                      <span><strong>Premise Alignment:</strong> ${Math.round((m.breakdown?.semantic || 0) * 100)}%</span>
                      <span>•</span>
                      <span><strong>Genre & Setting:</strong> ${Math.round((m.breakdown?.genre || 0) * 100)}%</span>
                      <span>•</span>
                      <span><strong>Trope Overlap:</strong> ${Math.round((m.breakdown?.tags || 0) * 100)}%</span>
                    </div>
                  </div>
                `}

                ${m.narrative_reasoning?.shared_tropes?.length ? `
                  <div class="shared-tropes-section" style="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                    <span class="tropes-label" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--color-muted); display: block; margin-bottom: 6px;">🏷️ Shared Tropes & Motifs:</span>
                    <div class="tropes-list" style="display: flex; flex-wrap: wrap; gap: 6px;">
                      ${m.narrative_reasoning.shared_tropes.map(t => `<span class="shared-trope-chip">${t}</span>`).join('')}
                    </div>
                  </div>
                ` : ''}

                ${hasComparisons ? `
                  <div style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8; margin-bottom: 6px;">
                    Forensic Stylometry & Cadence (15% Tiebreaker Weight)
                  </div>
                  <div class="metric-compare-header">
                    <span class="metric-col metric-col-name">Style Metric</span>
                    <span class="metric-col metric-col-query">Selected Work</span>
                    <span class="metric-col metric-col-target">Matched Work</span>
                    <span class="metric-col metric-col-match">Alignment</span>
                  </div>
                  <div class="metric-compare-table">
                    ${m.metric_comparisons.map(comp => {
                      const matchNum = parseInt(comp.match, 10) || 0;
                      const barColor = matchNum >= 90
                        ? (isLight ? '#0284c7' : '#38bdf8')
                        : matchNum >= 75
                          ? (isLight ? '#7c3aed' : '#a78bfa')
                          : (isLight ? '#d97706' : '#fbbf24');
                      return `
                        <div class="metric-compare-row">
                          <div class="metric-col metric-col-name">${comp.metric}</div>
                          <div class="metric-col metric-col-query">${comp.query}</div>
                          <div class="metric-col metric-col-target">${comp.candidate}</div>
                          <div class="metric-col metric-col-match">
                            <span class="metric-match-pct">${comp.match}</span>
                            <div class="metric-compare-bar-bg">
                              <div class="metric-compare-bar" style="width: ${matchNum}%; background-color: ${barColor};"></div>
                            </div>
                          </div>
                        </div>
                      `;
                    }).join('')}
                  </div>
                ` : ''}
              </div>
            ` : ''}
          `;

          // Attach event listeners for the drawer toggle and drawer container
          const whyBtn = item.querySelector(`.doppelganger-why-btn`);
          if (whyBtn) {
            whyBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              const drawer = item.querySelector(`.doppelganger-drawer`);
              if (drawer) {
                const isOpen = drawer.style.display !== "none";
                drawer.style.display = isOpen ? "none" : "block";
                whyBtn.setAttribute("aria-expanded", String(!isOpen));
                if (!isOpen) {
                  whyBtn.classList.add("active");
                } else {
                  whyBtn.classList.remove("active");
                }
              }
            });
          }

          const drawerEl = item.querySelector(`.doppelganger-drawer`);
          if (drawerEl) {
            drawerEl.addEventListener("click", (e) => {
              e.stopPropagation();
            });
          }

          container.appendChild(item);
        });
      }

      // 4. Ingestion Status Display & Job Polling
      function showIngestStatusCard(jobId, datasetName) {
        const card = document.getElementById("ingest-status-card");
        const badge = document.getElementById("ingest-status-badge");
        const dataset = document.getElementById("ingest-status-dataset");
        const message = document.getElementById("ingest-status-message");
        const detail = document.getElementById("ingest-status-detail");
        const iconContainer = document.getElementById("ingest-status-icon");

        if (card) card.style.display = "block";
        if (badge) {
          badge.className = "status-pill status-pill--running";
          badge.innerText = "Processing";
        }
        if (dataset) dataset.innerText = datasetName;
        if (message) message.innerText = "Fetching records, extracting features, and parsing chapters...";
        if (detail) detail.style.display = "none";
        if (iconContainer) iconContainer.innerHTML = '<div class="status-spinner"></div>';
      }

      function pollIngestJobStatus(jobId) {
        const ingestSubmitBtn = document.getElementById("ingest-submit");
        const interval = setInterval(async () => {
          try {
            const resp = await fetch(`${API_URL}/api/pipeline/ingest/status/${jobId}`);
            if (!resp.ok) return;
            const data = await resp.json();

            const badge = document.getElementById("ingest-status-badge");
            const message = document.getElementById("ingest-status-message");
            const detail = document.getElementById("ingest-status-detail");
            const iconContainer = document.getElementById("ingest-status-icon");

            if (data.status === "completed") {
              clearInterval(interval);
              if (badge) {
                badge.className = "status-pill status-pill--completed";
                badge.innerText = "Completed";
              }
              if (message) message.innerText = "Ingestion complete! Successfully indexed records into library.";
              if (iconContainer) iconContainer.innerHTML = '<div class="status-icon--success">✓</div>';

              if (ingestSubmitBtn) {
                ingestSubmitBtn.disabled = false;
                ingestSubmitBtn.innerText = "Schedule Ingest";
              }

              fetchNovels();

            } else if (data.status === "failed") {
              clearInterval(interval);
              if (badge) {
                badge.className = "status-pill status-pill--failed";
                badge.innerText = "Failed";
              }
              if (message) message.innerText = "Ingestion failed during processing.";
              if (detail) {
                detail.style.display = "block";
                detail.innerText = data.error || "Unknown error encountered.";
              }
              if (iconContainer) iconContainer.innerHTML = '<div class="status-icon--error">✕</div>';

              if (ingestSubmitBtn) {
                ingestSubmitBtn.disabled = false;
                ingestSubmitBtn.innerText = "Schedule Ingest";
              }
            }
          } catch (err) {
            console.error("Error polling job status:", err);
          }
        }, 2000);
      }

      // 5. Ingestion Form Setup
      function setupIngestionForm() {
        const ingestForm = document.getElementById("ingest-form");
        const ingestSubmitBtn = document.getElementById("ingest-submit");

        if (ingestForm && ingestSubmitBtn) {
          ingestForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const datasetName = (document.getElementById("dataset_name")?.value || "").trim();
            const numRecordsInput = document.getElementById("num_records");
            const numRecords = numRecordsInput ? parseInt(numRecordsInput.value, 10) : 50;

            if (!datasetName) return;

            ingestSubmitBtn.disabled = true;
            ingestSubmitBtn.innerText = "Submitting Job...";

            try {
              const resp = await fetch(`${API_URL}/api/pipeline/ingest`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ dataset_name: datasetName, num_records: numRecords })
              });

              if (!resp.ok) {
                const errData = await resp.json();
                throw new Error(errData.detail || "Failed to schedule ingestion job");
              }

              const data = await resp.json();
              const jobId = data.job_id;

              showIngestStatusCard(jobId, datasetName);
              pollIngestJobStatus(jobId);

            } catch (err) {
              alert(`Ingestion Error: ${err.message}`);
              ingestSubmitBtn.disabled = false;
              ingestSubmitBtn.innerText = "Schedule Ingest";
            }
          });
        }
      }

      // 6. Archetype Radar & Arc Chart Hover & Tooltip Events
      function setupChartHoverListeners() {
        const canvasNode = document.getElementById("radarChart");
        const tooltipNode = document.getElementById("radarTooltip");

        if (canvasNode && tooltipNode) {
          canvasNode.addEventListener("mousemove", (e) => {
            if (!currentStats) return;
            const rect = canvasNode.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;
            const cx = rect.width / 2;
            const cy = rect.height / 2;
            const dx = mx - cx;
            const dy = my - cy;
            const d = Math.sqrt(dx * dx + dy * dy);
            let angle = Math.atan2(dy, dx);

            const labelPad = 75;
            const R_css = Math.min(rect.width, rect.height) / 2 - labelPad;
            const n = RADAR_DIMS.length;
            let bestIndex = -1;
            let minDiff = Infinity;

            if (d <= R_css + 45 && d >= 12) {
              for (let i = 0; i < n; i++) {
                const spokeAngle = (2 * Math.PI * i / n) - Math.PI / 2;
                let diff = Math.abs(angle - spokeAngle);
                while (diff > Math.PI) {
                  diff = Math.abs(diff - 2 * Math.PI);
                }
                if (diff < minDiff) {
                  minDiff = diff;
                  bestIndex = i;
                }
              }
              if (minDiff > 0.35) {
                bestIndex = -1;
              }
            }

            if (bestIndex !== hoveredIndex) {
              hoveredIndex = bestIndex;
              renderAll();
            }

            if (hoveredIndex !== -1) {
              const dim = RADAR_DIMS[hoveredIndex];
              const prefix = Object.keys(currentStats).find(k => k.startsWith("zh_")) ? "zh_" :
                             Object.keys(currentStats).find(k => k.startsWith("ja_")) ? "ja_" : "en_";
              const statsKey = dim.key.replace("en_", prefix);

              const userVal = (currentStats.normalized_radar && currentStats.normalized_radar[statsKey] !== undefined)
                ? currentStats.normalized_radar[statsKey]
                : norm(currentStats[statsKey] ?? 0, dim.min, dim.max);
              
              const blVals = (currentStats.baselines && currentStats.baselines.radar && currentStats.baselines.radar[activeBaseline])
                ? currentStats.baselines.radar[activeBaseline]
                : RADAR_BASELINES[activeBaseline];
              const blVal = blVals ? blVals[hoveredIndex] : 0;

              const isLight = document.documentElement.getAttribute("data-theme") === "light";
              const userPct = (userVal * 100).toFixed(0) + "%";
              const blPct = (blVal * 100).toFixed(0) + "%";
              const baseName = activeBaseline === "web_novel" ? "Web Novel Baseline" : "Classic Lit Baseline";
              const blColor = activeBaseline === "web_novel"
                ? (isLight ? "#7c3aed" : "#a78bfa")
                : (isLight ? "#d97706" : "#fbbf24");
              const userColor = isLight ? "#0284c7" : "#7dd3fc";
              const labelColor = isLight ? "#64748b" : "rgba(255,255,255,0.7)";

              tooltipNode.innerHTML = `
                <div class="radar-tooltip-title">${dim.label}</div>
                <div class="radar-tooltip-row">
                  <span style="color: ${labelColor}">Selected Novel:</span>
                  <span class="radar-tooltip-val" style="color: ${userColor}">${userPct}</span>
                </div>
                <div class="radar-tooltip-row">
                  <span style="color: ${labelColor}">${baseName}:</span>
                  <span class="radar-tooltip-val" style="color: ${blColor}">${blPct}</span>
                </div>
              `;
              tooltipNode.style.display = "block";
              tooltipNode.style.left = (e.clientX + 15) + "px";
              tooltipNode.style.top = (e.clientY + 15) + "px";
            } else {
              tooltipNode.style.display = "none";
            }
          });

          canvasNode.addEventListener("mouseleave", () => {
            if (hoveredIndex !== -1) {
              hoveredIndex = -1;
              renderAll();
            }
            tooltipNode.style.display = "none";
          });
        }

        const svgNode = document.getElementById("arcChart");
        const arcTooltipNode = document.getElementById("arcTooltip");

        if (svgNode && arcTooltipNode) {
          svgNode.addEventListener("mousemove", (e) => {
            try {
              if (!currentArc) return;
              const rect = svgNode.getBoundingClientRect();
              if (rect.width === 0 || rect.height === 0) return;

              const svgX = (e.clientX - rect.left) * (600 / rect.width);
              const W = 600;
              const PAD = { top: 30, bottom: 48, left: 48, right: 48 };
              const plotW = W - PAD.left - PAD.right;
              const acts = (currentArc.quantiles && currentArc.quantiles.length > 0)
                ? currentArc.quantiles.map((v, i) => ({ sentiment: v, actIndex: i }))
                : currentArc.acts;

              const actX = i => PAD.left + i * plotW / (acts.length - 1);

              let closestIdx = -1;
              let minDiff = Infinity;

              for (let i = 0; i < acts.length; i++) {
                const diff = Math.abs(svgX - actX(i));
                if (diff < minDiff) {
                  minDiff = diff;
                  closestIdx = i;
                }
              }

              if (svgX < PAD.left - 25 || svgX > W - PAD.right + 25) {
                closestIdx = -1;
              }

              if (closestIdx !== hoveredArcIndex) {
                hoveredArcIndex = closestIdx;
                if (currentArc) drawArc(currentArc, activeBaseline);
              }

              if (hoveredArcIndex !== -1) {
                const act = acts[hoveredArcIndex];
                const userVal = typeof act === "number" ? act : act.sentiment;
                const blVals = (currentArc.baselines && currentArc.baselines[activeBaseline])
                  ? currentArc.baselines[activeBaseline]
                  : [0.0839, 0.0588, 0.1347, 0.1006];
                const blVal = blVals[hoveredArcIndex] || 0;

                const labelMap = { "Introduction": "Intro", "Development": "Dev", "Twist": "Twist", "Resolution": "Res" };
                const actNames = ["Ki (Intro)", "Shō (Dev)", "Ten (Twist)", "Ketsu (Res)"];
                const titleFmt = actNames[hoveredArcIndex] || `${act.act || ''} (${labelMap[act.label] || act.label || ''})`;

                const isLight = document.documentElement.getAttribute("data-theme") === "light";
                const userFmt = userVal >= 0 ? `+${userVal.toFixed(2)}` : userVal.toFixed(2);
                const blFmt = blVal >= 0 ? `+${blVal.toFixed(2)}` : blVal.toFixed(2);
                const baseName = activeBaseline === "web_novel" ? "Web Novel Baseline" : "Classic Lit Baseline";
                const blColor = activeBaseline === "web_novel"
                  ? (isLight ? "#7c3aed" : "#a78bfa")
                  : (isLight ? "#d97706" : "#fbbf24");
                const userColor = isLight ? "#0284c7" : "#7dd3fc";
                const labelColor = isLight ? "#64748b" : "rgba(255,255,255,0.7)";

                arcTooltipNode.innerHTML = `
                  <div class="radar-tooltip-title">${titleFmt}</div>
                  <div class="radar-tooltip-row">
                    <span style="color: ${labelColor}">Selected Novel:</span>
                    <span class="radar-tooltip-val" style="color: ${userColor}">${userFmt}</span>
                  </div>
                  <div class="radar-tooltip-row">
                    <span style="color: ${labelColor}">${baseName}:</span>
                    <span class="radar-tooltip-val" style="color: ${blColor}">${blFmt}</span>
                  </div>
                `;

                arcTooltipNode.style.display = "block";
                arcTooltipNode.style.left = (e.clientX + 15) + "px";
                arcTooltipNode.style.top = (e.clientY + 15) + "px";
              } else {
                arcTooltipNode.style.display = "none";
              }
            } catch (err) {
              console.error("Error handling arc tooltip:", err);
            }
          });

          svgNode.addEventListener("mouseleave", () => {
            if (hoveredArcIndex !== -1) {
              hoveredArcIndex = -1;
              if (currentArc) drawArc(currentArc, activeBaseline);
            }
            arcTooltipNode.style.display = "none";
          });
        }
      }

      // 7. Check URL Search Parameters
      function checkUrlParams() {
        const urlParams = new URLSearchParams(window.location.search);
        const linkedNovelId = urlParams.get('novelId');
        if (linkedNovelId) {
          setTimeout(() => {
            const novelId = parseInt(linkedNovelId);
            if (novelId) {
              const novelCard = document.querySelector(`[data-novel-id="${novelId}"]`);
              const title = novelCard ? novelCard.querySelector('.card-title')?.textContent : `Novel #${novelId}`;
              selectNovel(novelId, title || `Novel #${novelId}`);
            }
          }, 1500);
        }
      }

      // 8. Main Library Explorer Initializer
      function initExplorer() {
        const searchInput = document.getElementById("novel-search-input");
        const novelSelect = document.getElementById("novelSelect");
        const resetBtn = document.querySelector(".btn-reset-filters");

        if (searchInput) {
          searchInput.addEventListener("input", filterNovels);
        }

        // Quick sample buttons in empty state
        document.getElementById("quickSampleWebNovel")?.addEventListener("click", () => {
          const webNovel = allNovels.find(n => n.territory === "Web Novel Territory" || (n.dataset && n.dataset.toLowerCase().includes("novel"))) || allNovels[0];
          if (webNovel) selectNovel(webNovel.id, webNovel.title);
        });

        document.getElementById("quickSampleClassicLit")?.addEventListener("click", () => {
          const classic = allNovels.find(n => n.territory === "Classic Literature Territory" || (n.dataset && n.dataset.toLowerCase().includes("gutenberg"))) || allNovels[1] || allNovels[0];
          if (classic) selectNovel(classic.id, classic.title);
        });

        if (novelSelect) {
          novelSelect.addEventListener("change", (e) => {
            const id = parseInt(e.target.value);
            if (!id) return;
            const novel = allNovels.find(n => n.id === id);
            if (novel) {
              selectNovel(novel.id, novel.title);
            }
          });
        }

        // Territory tabs click listeners
        document.querySelectorAll("#territory-selector .t-tab").forEach(tab => {
          tab.addEventListener("click", () => {
            const territory = tab.getAttribute("data-territory");
            if (territory) selectTerritory(territory);
          });
        });

        // Baseline switch click handlers
        document.querySelectorAll(".baseline-btn").forEach(btn => {
          btn.addEventListener("click", () => {
            document.querySelectorAll(".baseline-btn").forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            activeBaseline = btn.dataset.baseline;
            if (currentStats) renderAll();
          });
        });

        // Reset all filters button listener
        if (resetBtn) {
          resetBtn.addEventListener("click", resetGenreFilters);
        }

        // Novel catalog pagination listeners
        const pagePrevBtn = document.getElementById("novelPagePrev");
        const pageNextBtn = document.getElementById("novelPageNext");

        if (pagePrevBtn) {
          pagePrevBtn.addEventListener("click", () => {
            if (currentNovelPage > 1) {
              currentNovelPage--;
              renderNovelsList(lastFilteredNovels);
            }
          });
        }

        if (pageNextBtn) {
          pageNextBtn.addEventListener("click", () => {
            const totalPages = Math.ceil(lastFilteredNovels.length / NOVELS_PER_PAGE);
            if (currentNovelPage < totalPages) {
              currentNovelPage++;
              renderNovelsList(lastFilteredNovels);
            }
          });
        }

        // Setup Ingestion Form
        setupIngestionForm();

        // Setup Chart Hover & Tooltip Events
        setupChartHoverListeners();

        // Render genres and fetch novels
        renderGenreCheckboxes();
        fetchNovels();
        checkUrlParams();
      }

      // 9. ClientRouter Lifecycle Initializer (astro:page-load)
      function reRenderLibrary() {
        if (currentStats && (document.getElementById("radarChart") || document.getElementById("novels-container"))) {
          renderAll();
          if (currentStats.top_matches) {
            renderSimilarNovels(currentStats.top_matches);
          }
        }
      }

      function toggleTheme() {
        const current = document.documentElement.getAttribute("data-theme") || "dark";
        const next = current === "light" ? "dark" : "light";
        
        // Temporarily disable CSS transitions to prevent multi-element frame drops
        document.documentElement.classList.add("theme-transitioning");
        document.documentElement.setAttribute("data-theme", next);
        try {
          localStorage.setItem("kisholens-theme", next);
        } catch (e) {}

        window.dispatchEvent(new CustomEvent("themechange", { detail: { theme: next } }));

        reRenderLibrary();

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.remove("theme-transitioning");
          });
        });
      }

      document.addEventListener("astro:page-load", () => {
        const themeToggleBtn = document.getElementById("themeToggleBtn");
        if (themeToggleBtn) {
          themeToggleBtn.onclick = toggleTheme;
        }

        // Initialize Library Explorer if on library page
        if (document.getElementById("novels-container") || document.getElementById("territory-selector")) {
          initExplorer();
        }
      });

      // Window exposed functions for inline event handlers and global access
      window.selectTerritory = selectTerritory;
      window.handleGenreItemClick = handleGenreItemClick;
      window.selectNovel = selectNovel;

      window.addEventListener("themechange", () => {
        requestAnimationFrame(() => {
          reRenderLibrary();
        });
      });

      window.addEventListener("resize", () => {
        requestAnimationFrame(() => {
          reRenderLibrary();
        });
      });
    </script>
  </body>
</html>
