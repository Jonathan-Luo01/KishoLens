---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Paste your prose and analyze stylistic pacing, dialogue ratios, and prose archetypes." />
    <title>Analyze Prose</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <style>
      .app-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 1.5rem;
      }
      .brand-title {
        font-family: var(--font-display);
        font-size: 1.8rem;
        font-weight: 700;
        text-decoration: none;
        color: var(--color-text);
      }
      .brand-title span {
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .analyze-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
        gap: 2rem;
      }
      @media (max-width: 900px) {
        .analyze-layout {
          grid-template-columns: minmax(0, 1fr);
        }
      }
      .card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--color-border);
        border-radius: var(--radius);
        padding: 1.5rem;
        backdrop-filter: blur(12px);
        min-width: 0;
      }
      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
      }
      label {
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--color-text);
      }
      input[type="text"], select, textarea {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 0.75rem;
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        outline: none;
        transition: border-color var(--transition);
      }
      input[type="text"]:focus, select:focus, textarea:focus {
        border-color: var(--color-accent);
      }
      textarea {
        resize: vertical;
        min-height: 250px;
      }
      .counter-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: var(--color-muted);
        margin-top: -0.75rem;
        margin-bottom: 1.25rem;
      }
      .placeholder-text {
        color: var(--color-muted);
        text-align: center;
        padding: 5rem 1rem;
        font-style: italic;
      }
      .error-alert {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid rgba(239, 68, 68, 0.3);
        color: rgb(248, 113, 113);
        padding: 0.75rem 1rem;
        border-radius: 8px;
        font-size: 0.9rem;
        margin-bottom: 1.25rem;
        display: none;
      }
      
      /* Loading Shimmer Spinner */
      .loading-container {
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 5rem 1rem;
        gap: 1.5rem;
      }
      .spinner {
        width: 50px;
        height: 50px;
        border: 3px solid rgba(124, 106, 255, 0.1);
        border-top: 3px solid var(--color-accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }

      /* Results Section Styling */
      #results-container {
        display: none;
        flex-direction: column;
        gap: 1.5rem;
      }
      .archetype-banner {
        background: linear-gradient(135deg, rgba(124, 106, 255, 0.1), rgba(192, 132, 252, 0.05));
        border: 1px solid var(--color-accent);
        box-shadow: 0 0 15px rgba(124, 106, 255, 0.1);
        border-radius: var(--radius);
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
      }
      .archetype-banner::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
      }
      .archetype-title-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 0.5rem;
      }
      .archetype-name {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
      }
      .archetype-confidence {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--color-accent-2);
        background: rgba(192, 132, 252, 0.1);
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
      }
      .archetype-description {
        font-size: 0.95rem;
        color: var(--color-text);
        line-height: 1.5;
      }
      .metric-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
      @media (max-width: 500px) {
        .metric-grid {
          grid-template-columns: 1fr;
        }
      }
      .metric-card {
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      .metric-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
      }
      .metric-value {
        font-family: var(--font-display);
        font-size: 1.4rem;
        font-weight: 600;
        color: #fff;
      }
      .progress-bar-container {
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 3px;
        overflow: hidden;
        margin-top: 0.5rem;
      }
      .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
        width: 0%;
        transition: width 0.5s ease-out;
      }
      .baseline-comparison {
        display: flex;
        justify-content: space-between;
        font-size: 0.72rem;
        color: var(--color-muted);
        margin-top: 0.4rem;
        border-top: 1px solid rgba(255, 255, 255, 0.03);
        padding-top: 0.3rem;
      }
      .baseline-comparison strong {
        color: var(--color-text);
        font-weight: 500;
      }

      /* ── Visualizer Chart Styles ── */
      .controls-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        margin-top: 2rem;
        margin-bottom: -0.75rem;
      }
      .baseline-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .baseline-group span {
        font-size: 0.8rem;
        color: rgba(255,255,255,0.4);
        white-space: nowrap;
      }
      .baseline-btn {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 2rem;
        color: rgba(255,255,255,0.55);
        font-family: inherit;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.35rem 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .baseline-btn:hover { border-color: #a78bfa; color: #a78bfa; }
      .baseline-btn.active {
        background: rgba(167,139,250,0.15);
        border-color: #a78bfa;
        color: #a78bfa;
      }

      .charts-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1.75rem;
      }
      @media (max-width: 860px) {
        .charts-grid { grid-template-columns: minmax(0, 1fr); }
      }

      .chart-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 1.25rem;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        transition: border-color 0.3s;
        min-width: 0;
      }
      .chart-card:hover { border-color: rgba(167,139,250,0.25); }

      .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .chart-title {
        font-family: 'Outfit', sans-serif;
        font-size: 1.05rem;
        font-weight: 600;
        color: #e2e2f0;
      }

      .chart-legend {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: center;
      }
      .legend-item {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.5);
      }
      .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        flex-shrink: 0;
      }
      .legend-dot.user     { background: #7dd3fc; }
      .legend-dot.wn       { background: #a78bfa; }
      .legend-dot.cl       { background: #fbbf24; }
      .legend-dot.baseline { background: #a78bfa; border: 1.5px dashed rgba(255,255,255,0.4); }

      canvas#radarChart {
        width: 100%;
        aspect-ratio: 1 / 1;
        max-width: 480px;
        margin: 0 auto;
        display: block;
        image-rendering: crisp-edges;
      }

      .archetype-label {
        text-align: center;
        font-size: 0.8rem;
        color: rgba(167,139,250,0.8);
        font-weight: 500;
        letter-spacing: 0.02em;
        min-height: 1.2em;
      }

      /* Doppelgängers / Similar Novels Card Styles */
      .doppelganger-card {
        background: #0f172a;
        padding: 24px;
        border-radius: 16px;
        border: 1px solid #1e293b;
        display: flex;
        flex-direction: column;
        grid-column: 1 / -1;
        min-width: 0;
      }

      .doppelganger-title {
        margin: 0 0 4px 0;
        font-family: 'Outfit', sans-serif;
        font-size: 18px;
        font-weight: 600;
        color: #f8fafc;
      }

      .doppelganger-subtitle {
        color: #64748b;
        font-size: 13px;
        margin: 0 0 20px 0;
        line-height: 1.4;
      }

      .doppelganger-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      :global(.doppelganger-item) {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        background: #020617;
        padding: 16px;
        border-radius: 12px;
        border: 1px solid #1e293b;
        transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
        cursor: pointer;
        min-width: 0;
      }

      :global(.doppelganger-item):hover {
        transform: translateX(4px);
        border-color: #334155;
        background: #090d1e;
      }

      :global(.doppelganger-left) {
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 1;
        min-width: 0;
      }

      :global(.doppelganger-rank) {
        color: #475569;
        font-size: 18px;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
        min-width: 28px;
        flex-shrink: 0;
      }

      :global(.doppelganger-info) {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
      }

      :global(.doppelganger-item-title) {
        margin: 0;
        font-family: 'Outfit', sans-serif;
        font-size: 16px;
        font-weight: 600;
        color: #e2e8f0;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.doppelganger-author) {
        font-size: 12px;
        color: #64748b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      :global(.doppelganger-badge) {
        display: inline-block;
        margin-top: 4px;
        padding: 2px 8px;
        background: #1e293b;
        color: #94a3b8;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        width: fit-content;
      }

      :global(.doppelganger-reasons) {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
      }

      :global(.reason-pill) {
        display: inline-flex;
        align-items: center;
        font-size: 11.5px;
        font-weight: 500;
        color: #c4b5fd;
        background: rgba(167, 139, 250, 0.10);
        border: 1px solid rgba(167, 139, 250, 0.28);
        border-radius: 6px;
        padding: 3px 8px;
        letter-spacing: 0.01em;
        line-height: 1.3;
        max-width: 100%;
        white-space: normal;
        word-break: break-word;
      }

      :global(.doppelganger-right) {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        flex-shrink: 0;
        margin-left: 16px;
      }

      :global(.doppelganger-score) {
        font-size: 18px;
        font-weight: bold;
        font-variant-numeric: tabular-nums;
      }

      :global(.doppelganger-progress-bg) {
        width: 80px;
        height: 4px;
        background: #1e293b;
        border-radius: 2px;
        overflow: hidden;
      }

      :global(.doppelganger-progress-fill) {
        height: 100%;
        border-radius: 2px;
        transition: width 0.4s ease-out;
      }

      :global(.doppelganger-breakdown) {
        display: flex;
        gap: 6px;
        margin-top: 4px;
      }

      :global(.doppelganger-factor) {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
      }

      :global(.doppelganger-factor-label) {
        font-size: 8px;
        color: #64748b;
        font-weight: 600;
      }

      :global(.doppelganger-factor-bar-bg) {
        width: 16px;
        height: 2px;
        background: #1e293b;
        border-radius: 1px;
        overflow: hidden;
      }

      :global(.doppelganger-factor-bar-fill) {
        height: 100%;
        border-radius: 1px;
      }

      @media (max-width: 600px) {
        :global(.doppelganger-item) {
          flex-direction: column !important;
          align-items: flex-start !important;
          gap: 12px;
        }
        :global(.doppelganger-left) {
          width: 100%;
          min-width: 0;
        }
        :global(.doppelganger-right) {
          width: 100%;
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          margin-left: 0;
          padding-top: 10px;
          border-top: 1px solid rgba(255, 255, 255, 0.06);
        }
        :global(.doppelganger-breakdown) {
          margin-top: 0;
        }
        .controls-bar {
          justify-content: flex-start;
          width: 100%;
        }
        .baseline-group {
          width: 100%;
          justify-content: space-between;
        }
      }

      @media (max-width: 480px) {
        .app-container {
          padding: 1rem 0.65rem 3rem 0.65rem;
        }
        .card, .chart-card, .doppelganger-card {
          padding: 1rem 0.85rem;
        }
      }

      svg#arcChart {
        width: 100%;
        max-width: 100%;
        height: auto;
        min-height: 180px;
        display: block;
      }

      .act-labels {
        display: flex;
        justify-content: space-around;
      }
      .act-chip {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15rem;
      }
      .act-key {
        font-family: 'Outfit', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        color: #a78bfa;
      }
      .act-name {
        font-size: 0.7rem;
        color: rgba(255,255,255,0.35);
        letter-spacing: 0.03em;
      }

      /* ── ENHANCED METRICS DASHBOARD (PARITY WITH LIBRARY) ── */
      :global(.metrics-dashboard) {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
      }

      :global(.metrics-hero) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 0.6rem;
        background: rgba(124, 106, 255, 0.05);
        border: 1px solid rgba(124, 106, 255, 0.2);
        border-radius: 10px;
        padding: 0.85rem;
      }

      :global(.hero-chip) {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
      }

      :global(.hero-chip-label) {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-muted);
      }

      :global(.hero-chip-val) {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffffff;
      }

      :global(.metrics-category-tabs) {
        display: flex;
        gap: 0.4rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
      }

      :global(.category-tab) {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--color-muted);
        border-radius: 20px;
        padding: 0.3rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.2s ease;
      }

      :global(.category-tab:hover), :global(.category-tab.active) {
        background: rgba(124, 106, 255, 0.18);
        border-color: rgba(124, 106, 255, 0.5);
        color: #ffffff;
      }

      :global(.metric-category-section) {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      :global(.category-section-title) {
        font-family: var(--font-display);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.4rem;
      }

      :global(.category-section-title.cat-structure) { color: #38bdf8; }
      :global(.category-section-title.cat-prose)     { color: #a78bfa; }
      :global(.category-section-title.cat-theme)     { color: #f472b6; }
      :global(.category-section-title.cat-pacing)    { color: #34d399; }

      :global(.metric-card-grid) {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 0.6rem;
      }

      :global(.metric-card) {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 0.65rem 0.8rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        position: relative;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-card:hover) {
        border-color: rgba(124, 106, 255, 0.3);
        transform: translateY(-1px);
      }

      :global(.metric-card-header) {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: relative;
      }

      :global(.metric-card-label) {
        font-size: 0.73rem;
        font-weight: 500;
        color: #cbd5e1;
      }

      :global(.metric-info-icon) {
        font-size: 0.72rem;
        color: var(--color-accent-2);
        cursor: pointer;
        opacity: 0.8;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background: rgba(124, 106, 255, 0.12);
        border: 1px solid rgba(124, 106, 255, 0.25);
        user-select: none;
      }

      :global(.metric-info-icon:hover), :global(.metric-info-icon.active) {
        opacity: 1.0;
        transform: scale(1.12);
        background: rgba(124, 106, 255, 0.3);
        border-color: var(--color-accent);
        color: #ffffff;
      }

      :global(.metric-tooltip-box) {
        position: absolute;
        bottom: 125%;
        right: 0;
        background: #0f172a;
        border: 1px solid rgba(124, 106, 255, 0.4);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6), 0 0 12px rgba(124, 106, 255, 0.25);
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        font-size: 0.73rem;
        color: #e2e8f0;
        line-height: 1.45;
        width: 220px;
        z-index: 100;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
      }

      :global(.metric-tooltip-box.visible),
      :global(.metric-info-icon:hover + .metric-tooltip-box) {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }

      :global(.metric-val-row) {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.4rem;
      }

      :global(.metric-primary-val) {
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 700;
        color: #f8fafc;
      }

      :global(.percentile-bar-bg) {
        width: 100%;
        height: 4px;
        background: rgba(255, 255, 255, 0.08);
        border-radius: 2px;
        overflow: hidden;
      }

      :global(.percentile-bar-fill) {
        height: 100%;
        border-radius: 2px;
        transition: width 0.4s ease-out;
      }

      :global(.bar-fill-structure) { background: linear-gradient(90deg, #0284c7, #38bdf8); }
      :global(.bar-fill-prose)     { background: linear-gradient(90deg, #7c3aed, #a78bfa); }
      :global(.bar-fill-theme)     { background: linear-gradient(90deg, #db2777, #f472b6); }
      :global(.bar-fill-pacing)    { background: linear-gradient(90deg, #059669, #34d399); }

      :global(.benchmark-chip) {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.45rem;
        border-radius: 4px;
        font-size: 0.65rem;
        font-weight: 600;
        width: fit-content;
      }

      :global(.benchmark-chip.higher) {
        background: rgba(34, 197, 94, 0.15);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, 0.3);
      }

      :global(.benchmark-chip.lower) {
        background: rgba(239, 68, 68, 0.15);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.3);
      }

      :global(.benchmark-chip.neutral) {
        background: rgba(148, 163, 184, 0.12);
        color: #cbd5e1;
        border: 1px solid rgba(148, 163, 184, 0.2);
      }

      :global(.metric-baseline-row) {
        display: flex;
        gap: 0.55rem;
        margin-top: 0.2rem;
        flex-wrap: wrap;
      }

      :global(.metric-baseline-item) {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.63rem;
        color: rgba(255,255,255,0.45);
      }

      :global(.metric-baseline-dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
      }

      /* Hover Tooltips for Charts */
      .radar-tooltip {
        position: fixed;
        pointer-events: none;
        background: rgba(10, 10, 18, 0.95);
        border: 1px solid rgba(124, 106, 255, 0.35);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        font-size: 0.8rem;
        z-index: 1000;
        display: none;
      }
      .radar-tooltip-title {
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.35rem;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        padding-bottom: 0.25rem;
      }
      .radar-tooltip-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.2rem;
      }
      .radar-tooltip-val {
        font-family: var(--font-display);
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="app-container">
      <header class="site-header">
        <a href="/" class="brand-title">Kish<span>o</span>Lens</a>
        <nav class="site-nav">
          <a href="/analyze" class="active">Analyze Prose</a>
          <a href="/library">Library</a>
        </nav>
      </header>

      <div class="analyze-layout">
        <!-- Left Pane: Input Form -->
        <div class="card">
          <h2 style="font-family: var(--font-display); margin-bottom: 1.5rem;">Input Passage</h2>
          <form id="analyze-form">

            <div class="form-group">
              <label for="passage-title">Passage Title (Optional)</label>
              <input type="text" id="passage-title" placeholder="e.g. Chapter 1, Draft 2" />
            </div>
            <div class="form-group">
              <label for="passage-lang">Language</label>
              <select id="passage-lang">
                <option value="auto">Auto-detect (recommended)</option>
                <option value="en">English</option>
                <option value="ja">Japanese</option>
                <option value="zh">Chinese</option>
              </select>
            </div>
            <div class="form-group">
              <label for="passage-text">Prose Content</label>
              <textarea id="passage-text" placeholder="Paste your writing here (at least 20 words recommended)..." required></textarea>
            </div>
            <div class="counter-row">
              <span id="char-counter">0 characters</span>
              <span id="word-counter">0 words</span>
            </div>
            <button type="submit" class="btn btn--primary" id="analyze-submit" style="width: 100%;">Analyze Prose</button>
          </form>
        </div>

        <!-- Right Pane: Analysis Results -->
        <div class="card" style="display: flex; flex-direction: column;">
          <h2 style="font-family: var(--font-display); margin-bottom: 1.5rem;">Stylistic Analysis</h2>
          
          <div class="error-alert" id="error-box"></div>

          <!-- State 1: Ready -->
          <div class="placeholder-text" id="ready-state">
            Pasted text analysis will appear here. Paste writing in the input pane and click "Analyze Prose".
          </div>

          <!-- State 2: Loading -->
          <div class="loading-container" id="loading-state">
            <div class="spinner"></div>
            <p style="color: var(--color-muted);">Extracting stylistic pacing metrics...</p>
          </div>

          <!-- State 3: Success -->
          <div id="results-container"></div>
        </div>
      </div>

      <!-- Visualizations Section (Full Width) -->
      <div id="visualizations-container" style="display: none; flex-direction: column; gap: 1.75rem; width: 100%; margin-top: 2rem;">
        <div class="controls-bar" style="margin-top: 1rem; margin-bottom: 0px;">
          <div class="baseline-group">
            <span>Compare Visualizations to:</span>
            <button id="btnWebNovel" class="baseline-btn active" data-baseline="web_novel">Web Novel</button>
            <button id="btnClassic"  class="baseline-btn"        data-baseline="classic_lit">Classic Lit</button>
          </div>
        </div>

        <div class="charts-grid">
          <div class="chart-card">
            <div class="chart-header">
              <h2 class="chart-title">Archetype Radar</h2>
              <div class="chart-legend">
                <span class="legend-item"><span class="legend-dot user"></span>Your Novel</span>
                <span class="legend-item"><span class="legend-dot wn" id="radarBaselineLegendDot"></span><span id="radarBaselineLegendLabel">Web Novel</span></span>
              </div>
            </div>
            <canvas id="radarChart"></canvas>
            <p id="archetypeLabel" class="archetype-label"></p>
          </div>

          <div class="chart-card">
            <div class="chart-header">
              <h2 class="chart-title">Kishōtenketsu Sentiment Arc</h2>
              <div class="chart-legend">
                <span class="legend-item"><span class="legend-dot user"></span>Novel</span>
                <span class="legend-item"><span class="legend-dot baseline" id="arcBaselineLegendDot"></span><span id="baselineLegendLabel">Web Novel</span></span>
              </div>
            </div>
            <p style="color: rgba(255,255,255,0.4); font-size: 0.8rem; line-height: 1.4; margin-top: -0.25rem;">
              Tracks emotional polarity across the 4 acts (Ki, Shō, Ten, Ketsu). Notice the "Tidy Resolution" spike.
            </p>
            <svg id="arcChart" viewBox="0 0 600 420" preserveAspectRatio="xMidYMid meet"></svg>
            <div class="act-labels" id="actLabels" style="display: none;"></div>
          </div>

          <!-- Pacing Barcode (Full Width) -->
          <div class="chart-card" style="grid-column: 1 / -1;">
            <div class="chart-header">
              <h2 class="chart-title">Rhythmic Pacing (Paragraph Density)</h2>
              <div class="chart-legend">
                <span class="legend-item"><span class="legend-dot user"></span>Your Novel</span>
                <span class="legend-item"><span class="legend-dot baseline" id="pacingBaselineLegendDot"></span><span id="pacingBaselineLegendLabel">Web Novel</span></span>
              </div>
            </div>
            <p style="color: rgba(255,255,255,0.45); font-size: 0.8rem; line-height: 1.45;">
              Each block represents a paragraph. Height/opacity represents word or character count. Web Novels rely on rapid, fragmented lines for mobile scrolling, while classics use dense text blocks.
            </p>
            
            <div style="margin-top: 1rem;">
              <h4 style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;" id="pacingDraftLabel">Your Draft (Highly Fragmented)</h4>
              <div id="pacingBarcodeUser" style="display: flex; height: 60px; align-items: stretch; gap: 2px; background: rgba(0,0,0,0.25); padding: 4px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);"></div>
            </div>
            
            <div style="margin-top: 1.25rem;">
              <h4 style="color: rgba(255,255,255,0.5); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem;" id="pacingBaselineLabel">Web Novel Baseline</h4>
              <div id="pacingBarcodeBaseline" style="display: flex; height: 60px; align-items: stretch; gap: 2px; background: rgba(0,0,0,0.25); padding: 4px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.06);"></div>
            </div>
          </div>

          <!-- Similar Works / Stylistic Matches Card (Full Width) -->
          <div class="doppelganger-card">
            <h3 class="doppelganger-title">Similar Works &amp; Stylistic Matches</h3>
            <p class="doppelganger-subtitle">
              The closest matching novels in the database based on prose style and semantic structure.
            </p>
            <div class="doppelganger-list" id="similarNovelsContainer">
              <div style="color: #64748b; font-size: 13px; margin: 0; padding: 12px;">No similar matches found.</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      const API_URL = "http://127.0.0.1:8000";
      const textarea = document.getElementById("passage-text");
      const charCounter = document.getElementById("char-counter");
      const wordCounter = document.getElementById("word-counter");
      const form = document.getElementById("analyze-form");
      const errorBox = document.getElementById("error-box");
      
      const readyState = document.getElementById("ready-state");
      const loadingState = document.getElementById("loading-state");
      const resultsContainer = document.getElementById("results-container");
      let currentStats = null;
      let currentArc   = null;
      let activeBaseline = "web_novel";
      let hoveredIndex = -1;
      let hoveredArcIndex = -1;

      // 1. Text Area character and word counter
      textarea.addEventListener("input", () => {
        const text = textarea.value;
        charCounter.textContent = `${text.length} characters`;
        
        const words = text.trim() === "" ? 0 : text.trim().split(/\s+/).length;
        wordCounter.textContent = `${words} words`;
      });

      // Pre-fill text if passed via URL parameter (e.g. from homepage reader widget)
      const urlParams = new URLSearchParams(window.location.search);
      const urlText = urlParams.get("text");
      if (urlText && textarea) {
        textarea.value = urlText;
        textarea.dispatchEvent(new Event("input"));
      }

      // 2. Submit form to API
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errorBox.style.display = "none";
        readyState.style.display = "none";
        resultsContainer.style.display = "none";
        document.getElementById("visualizations-container").style.display = "none";
        loadingState.style.display = "flex";

        const title = document.getElementById("passage-title").value.trim() || "Untitled";
        const lang = document.getElementById("passage-lang").value;
        const text = textarea.value;

        try {
          // Perform stylistic analysis
          const res = await fetch(`${API_URL}/api/analyze`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ title, lang, text })
          });

          if (!res.ok) {
            const errData = await res.json();
            throw new Error(errData.detail || "Server failed to process analysis");
          }

          const data = await res.json();
          currentStats = data.stats;
          currentArc   = data.arc;
          renderResults(data);
          renderAll();
          if (data.top_matches) {
            renderSimilarNovels(data.top_matches);
          }
          document.getElementById("visualizations-container").style.display = "flex";
          sessionStorage.setItem("custom_analysis", JSON.stringify(data));
        } catch (err) {
          loadingState.style.display = "none";
          errorBox.textContent = `Analysis error: ${err.message}`;
          errorBox.style.display = "block";
        }
      });

      const METRIC_METADATA = {
        // Structure & Volume
        word_count:                  { label: "Word Count", category: "structure", isInteger: true, tooltip: "Total words parsed in passage" },
        char_count:                  { label: "Character Count", category: "structure", isInteger: true, tooltip: "Total characters in text" },
        sentence_count:              { label: "Sentence Count", category: "structure", isInteger: true, tooltip: "Total sentences identified" },
        avg_sentence_len:            { label: "Avg Sentence Length", category: "structure", tooltip: "Average words/characters per sentence" },
        avg_sentences_per_paragraph: { label: "Sentences/Paragraph", category: "structure", tooltip: "Paragraph density and pacing structure" },
        dep_tree_depth:              { label: "Dep Tree Depth", category: "structure", tooltip: "Syntactic dependency tree depth (higher = more complex sentence grammar)" },

        // Prose & Style
        dialogue_ratio:              { label: "Dialogue Ratio", category: "prose", isPercent: true, tooltip: "Percentage of prose contained within quotation marks" },
        ttr:                         { label: "Lexical Density (TTR)", category: "prose", tooltip: "Type-Token Ratio: vocabulary diversity and richness" },
        adj_ratio:                   { label: "Adjective Ratio", category: "prose", isPercent: true, tooltip: "Proportion of adjectives relative to total word count" },
        verb_ratio:                  { label: "Verb Ratio", category: "prose", isPercent: true, tooltip: "Action verb frequency relative to word count" },
        particle_ratio:              { label: "Particle Ratio", category: "prose", isPercent: true, tooltip: "Grammatical particle density" },
        kanji_ratio:                 { label: "Kanji Density", category: "prose", isPercent: true, tooltip: "Kanji character density in Japanese text" },

        // Theme & Emotion
        compound_sentiment:          { label: "Sentiment Tone", category: "theme", tooltip: "Average emotional intensity score (0.0 calm to 1.0 highly charged)" },
        theme_explication_ratio:     { label: "Thematic Explicitness", category: "theme", tooltip: "Density of explicit moral/theme statements per 10k units" },
        sensory_body_density:        { label: "Visceral Emotion", category: "theme", isPercent: true, tooltip: "Ratio of somatic body sensations vs direct emotion words" },
        outside_world_engagement:    { label: "World Grounding", category: "theme", tooltip: "Engagement with setting and physical world descriptions" },

        // Pacing & Subplots
        linearity_subversion_score:  { label: "Temporal Complexity", category: "pacing", tooltip: "Non-linear story structure and flashback frequency" },
        temporal_shift_score:        { label: "Time Shifts", category: "pacing", tooltip: "Frequency of time jump markers and scene transitions" },
        narrative_feature_diversity: { label: "Subplot Diversity", category: "pacing", tooltip: "Co-occurrence diversity of secondary entities and subplots" }
      };

      // Maps metric key -> index in RADAR_DIMS baselines array
      const RADAR_KEY_INDEX = {
        theme_explication_ratio: 0,
        linearity_subversion_score: 1,
        sensory_body_density: 2,
        outside_world_engagement: 3,
        narrative_feature_diversity: 4,
        dialogue_ratio: 5,
        ttr: 6,
        compound_sentiment: 7,
      };

      function renderEnhancedMetricsDashboard(stats) {
        const keys = Object.keys(stats);
        const langPrefix = keys.some(k => k.startsWith("en_")) ? "en_" :
                           keys.some(k => k.startsWith("ja_")) ? "ja_" : "zh_";

        const normRadar = stats.normalized_radar || {};
        const wnRadar   = stats.baselines?.radar?.web_novel   || [];
        const clRadar   = stats.baselines?.radar?.classic_lit || [];

        // 1. Hero Summary Header
        const heroHtml = `
          <div class="metrics-hero">
            <div class="hero-chip">
              <span class="hero-chip-label">Archetype</span>
              <span class="hero-chip-val" style="color: #a78bfa;">${stats.archetype_match?.closest_trope || stats.archetype?.closest_trope || 'Unknown'}</span>
            </div>
            <div class="hero-chip">
              <span class="hero-chip-label">Territory</span>
              <span class="hero-chip-val" style="color: #38bdf8;">${stats.archetype_match?.territory || stats.archetype?.territory || 'Web Novel'}</span>
            </div>
            <div class="hero-chip">
              <span class="hero-chip-label">Word Count</span>
              <span class="hero-chip-val">${Math.round(stats[`${langPrefix}word_count`] || stats[`${langPrefix}char_count`] || stats.word_count || stats.char_count || 0).toLocaleString()}</span>
            </div>
            <div class="hero-chip">
              <span class="hero-chip-label">Lexical Richness</span>
              <span class="hero-chip-val" style="color: #34d399;">${(stats[`${langPrefix}ttr`] || stats.ttr || 0).toFixed(2)}</span>
            </div>
          </div>
        `;

        // 2. Filter Tabs
        const tabsHtml = `
          <div class="metrics-category-tabs">
            <button class="category-tab active" data-cat="all">All Metrics</button>
            <button class="category-tab" data-cat="structure">Structure</button>
            <button class="category-tab" data-cat="prose">Prose & Style</button>
            <button class="category-tab" data-cat="theme">Theme & Emotion</button>
            <button class="category-tab" data-cat="pacing">Pacing & Narrative</button>
          </div>
        `;

        // 3. Metric Sections Grouping
        const categories = [
          { id: "structure", title: "Structure & Volume", class: "cat-structure", barClass: "bar-fill-structure" },
          { id: "prose", title: "Prose & Style", class: "cat-prose", barClass: "bar-fill-prose" },
          { id: "theme", title: "Theme & Emotion", class: "cat-theme", barClass: "bar-fill-theme" },
          { id: "pacing", title: "Pacing & Narrative", class: "cat-pacing", barClass: "bar-fill-pacing" }
        ];

        let sectionsHtml = "";

        categories.forEach(cat => {
          let cardsInCatHtml = "";
          Object.keys(METRIC_METADATA).forEach(key => {
            const meta = METRIC_METADATA[key];
            if (meta.category !== cat.id) return;

            const rawKey = `${langPrefix}${key}`;
            let rawVal = stats[rawKey] !== undefined ? stats[rawKey] : stats[key];
            if (rawVal === undefined || rawVal === null || (rawVal === 0 && key === "compound_sentiment")) {
              rawVal = stats[`en_${key}`] ?? stats[`zh_${key}`] ?? stats[`ja_${key}`] ?? stats[key];
            }
            if (rawVal === null || rawVal === undefined) return;

            let displayVal = meta.isPercent ? `${(rawVal * 100).toFixed(1)}%` :
                             meta.isInteger ? Math.round(rawVal).toLocaleString() :
                             typeof rawVal === 'number' ? (rawVal % 1 !== 0 ? rawVal.toFixed(2) : rawVal.toString()) : rawVal;

            const normScore = normRadar[rawKey] !== undefined ? normRadar[rawKey] :
                              normRadar[key] !== undefined ? normRadar[key] : 0.5;

            const pctWidth = Math.min(100, Math.max(0, Math.round(normScore * 100)));

            // Benchmark comparison chip
            let benchChipHtml = "";
            if (normScore >= 0.65) {
              benchChipHtml = `<span class="benchmark-chip higher">High (+${Math.round((normScore - 0.5) * 100)}% vs Avg)</span>`;
            } else if (normScore <= 0.35) {
              benchChipHtml = `<span class="benchmark-chip lower">Low (-${Math.round((0.5 - normScore) * 100)}% vs Avg)</span>`;
            } else {
              benchChipHtml = `<span class="benchmark-chip neutral">Balanced</span>`;
            }

            // Web Novel / Classic Lit baseline row
            let baselineRowHtml = "";
            const radarIdx = RADAR_KEY_INDEX[key];
            if (radarIdx !== undefined) {
              const wnVal = wnRadar[radarIdx];
              const clVal = clRadar[radarIdx];
              if (wnVal !== undefined || clVal !== undefined) {
                baselineRowHtml = `<div class="metric-baseline-row">`;
                if (wnVal !== undefined) {
                  const wnPct = Math.round(wnVal * 100);
                  baselineRowHtml += `
                    <span class="metric-baseline-item">
                      <span class="metric-baseline-dot" style="background:#a78bfa;"></span>
                      WN: ${wnPct}%
                    </span>`;
                }
                if (clVal !== undefined) {
                  const clPct = Math.round(clVal * 100);
                  baselineRowHtml += `
                    <span class="metric-baseline-item">
                      <span class="metric-baseline-dot" style="background:#fbbf24;"></span>
                      CL: ${clPct}%
                    </span>`;
                }
                baselineRowHtml += `</div>`;
              }
            }

            cardsInCatHtml += `
              <div class="metric-card" data-category="${cat.id}">
                <div class="metric-card-header">
                  <span class="metric-card-label">${meta.label}</span>
                  <span class="metric-info-icon" role="button" aria-label="${meta.tooltip}">ⓘ</span>
                  <div class="metric-tooltip-box">${meta.tooltip}</div>
                </div>
                <div class="metric-val-row">
                  <span class="metric-primary-val">${displayVal}</span>
                  ${benchChipHtml}
                </div>
                <div class="percentile-bar-bg">
                  <div class="percentile-bar-fill ${cat.barClass}" style="width: ${pctWidth}%;"></div>
                </div>
                ${baselineRowHtml}
              </div>
            `;
          });

          if (cardsInCatHtml) {
            sectionsHtml += `
              <div class="metric-category-section" data-cat-section="${cat.id}">
                <div class="category-section-title ${cat.class}">${cat.title}</div>
                <div class="metric-card-grid">
                  ${cardsInCatHtml}
                </div>
              </div>
            `;
          }
        });

        return `
          <div class="metrics-dashboard">
            ${heroHtml}
            ${tabsHtml}
            ${sectionsHtml}
          </div>
        `;
      }

      function renderResults(data) {
        loadingState.style.display = "none";
        resultsContainer.style.display = "block";

        const statsObj = data.stats || {
          ...data.features,
          normalized_radar: data.normalized_radar,
          archetype_match: data.archetype,
          baselines: data.baselines
        };

        resultsContainer.innerHTML = renderEnhancedMetricsDashboard(statsObj);

        // Attach category tab filter event listener
        const tabBtns = resultsContainer.querySelectorAll(".category-tab");
        tabBtns.forEach(btn => {
          btn.addEventListener("click", () => {
            tabBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            const targetCat = btn.getAttribute("data-cat");
            const sections = resultsContainer.querySelectorAll("[data-cat-section]");
            sections.forEach(sec => {
              if (targetCat === "all" || sec.getAttribute("data-cat-section") === targetCat) {
                sec.style.display = "flex";
              } else {
                sec.style.display = "none";
              }
            });
          });
        });

        // Attach info icon click popover event listener
        const infoIcons = resultsContainer.querySelectorAll(".metric-info-icon");
        infoIcons.forEach(icon => {
          icon.addEventListener("click", (e) => {
            e.stopPropagation();
            const tooltipBox = icon.nextElementSibling;
            const isVisible = tooltipBox?.classList.contains("visible");
            resultsContainer.querySelectorAll(".metric-tooltip-box").forEach(box => box.classList.remove("visible"));
            resultsContainer.querySelectorAll(".metric-info-icon").forEach(i => i.classList.remove("active"));
            if (!isVisible && tooltipBox) {
              tooltipBox.classList.add("visible");
              icon.classList.add("active");
            }
          });
        });

        document.addEventListener("click", () => {
          resultsContainer.querySelectorAll(".metric-tooltip-box").forEach(box => box.classList.remove("visible"));
          resultsContainer.querySelectorAll(".metric-info-icon").forEach(i => i.classList.remove("active"));
        });
      }

      const RADAR_DIMS = [
        { key: "en_theme_explication_ratio",     label: "Thematic Explicitness", min: 0,    max: 10.0 },
        { key: "en_linearity_subversion_score",  label: "Temporal Complexity",  min: 0,    max: 0.20 },
        { key: "en_sensory_body_density",        label: "Visceral Emotion",     min: 0,    max: 1.0  },
        { key: "en_outside_world_engagement",    label: "World Grounding",      min: 0.5,  max: 4.0  },
        { key: "en_narrative_feature_diversity", label: "Subplot Diversity",    min: 0,    max: 1.0  },
        { key: "en_dialogue_ratio",              label: "Dialogue Density",     min: 0,    max: 0.8  },
        { key: "en_ttr",                         label: "Lexical Richness",     min: 0.3,  max: 0.9  },
        { key: "en_compound_sentiment",          label: "Emotional Tone",       min: 0,    max: 1.0  },
      ];

      const RADAR_BASELINES = {
        web_novel:   [0.35, 0.55, 0.60, 0.40, 0.40, 0.65, 0.45, 0.50],
        classic_lit: [0.30, 0.20, 0.40, 0.80, 0.70, 0.30, 0.80, 0.40],
      };

      const PACING_BASELINES = {
        web_novel: [15, 8, 22, 5, 12, 30, 9, 14, 6, 18, 11, 25, 7, 16, 13, 8, 20, 10, 15, 6, 24, 9, 12, 17, 8, 14, 5, 21, 7, 13, 11, 28, 6, 15, 9, 19, 12, 10, 16, 8, 23, 7, 11, 14, 5, 17, 12, 9, 21, 6],
        classic_lit: [85, 112, 64, 140, 95, 130, 78, 105, 88, 120, 90, 115, 130, 80, 125, 95, 110, 140, 75, 100, 105, 120, 85, 135, 95, 110, 130, 90, 115, 100, 112, 88, 98, 125, 70, 118, 132, 92, 104, 115]
      };

      function norm(val, min, max) {
        return Math.max(0, Math.min(1, (val - min) / Math.max(1e-9, max - min)));
      }

      function renderAll() {
        drawRadar(currentStats, activeBaseline);
        drawArc(currentArc, activeBaseline);
        drawPacing(currentStats, activeBaseline);
      }

      /* ── Baseline Switch Click Handlers ── */
      document.querySelectorAll(".baseline-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".baseline-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          activeBaseline = btn.dataset.baseline;
          
          // Update legends dynamically
          const isWeb = activeBaseline === "web_novel";
          const labelText = isWeb ? "Web Novel" : "Classic Lit";
          const dotColor = isWeb ? "#a78bfa" : "#fbbf24";
          
          document.getElementById("radarBaselineLegendLabel").textContent = labelText;
          document.getElementById("baselineLegendLabel").textContent = labelText;
          document.getElementById("pacingBaselineLegendLabel").textContent = labelText;
          
          document.getElementById("radarBaselineLegendDot").style.backgroundColor = dotColor;
          document.getElementById("arcBaselineLegendDot").style.backgroundColor = dotColor;
          document.getElementById("pacingBaselineLegendDot").style.backgroundColor = dotColor;
          
          if (currentStats && currentArc) renderAll();
        });
      });

      /* ── Radar chart (Canvas) ── */
      function drawRadar(stats, baseline) {
        const canvas = document.getElementById("radarChart");
        if (!canvas) return;
        const dpr = window.devicePixelRatio || 1;

        const cssW = canvas.clientWidth  || 480;
        const cssH = canvas.clientHeight || 480;
        if (canvas.width !== Math.round(cssW * dpr) || canvas.height !== Math.round(cssH * dpr)) {
          canvas.width  = Math.round(cssW * dpr);
          canvas.height = Math.round(cssH * dpr);
        }

        const ctx = canvas.getContext("2d");
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const W = cssW, H = cssH;
        const cx = W / 2, cy = H / 2;
        const labelPad = 80;
        const R  = Math.min(W, H) / 2 - labelPad;
        const n  = RADAR_DIMS.length;
        ctx.clearRect(0, 0, W, H);

        /* Grid rings */
        for (let ring = 1; ring <= 5; ring++) {
          ctx.beginPath();
          for (let i = 0; i < n; i++) {
            const angle = (2 * Math.PI * i / n) - Math.PI / 2;
            const r = R * ring / 5;
            const x = cx + r * Math.cos(angle);
            const y = cy + r * Math.sin(angle);
            i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
          }
          ctx.closePath();
          ctx.strokeStyle = "rgba(255,255,255,0.07)";
          ctx.lineWidth = 1;
          ctx.stroke();

          ctx.fillStyle = "rgba(255,255,255,0.18)";
          ctx.font = "10px Inter, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(`${ring * 20}%`, cx + 4, cy - R * ring / 5 - 7);
        }

        /* Spokes + axis labels */
        RADAR_DIMS.forEach((dim, i) => {
          const isHovered = hoveredIndex === i;
          const angle = (2 * Math.PI * i / n) - Math.PI / 2;
          ctx.beginPath();
          ctx.moveTo(cx, cy);
          ctx.lineTo(cx + R * Math.cos(angle), cy + R * Math.sin(angle));
          
          ctx.strokeStyle = isHovered ? "rgba(255,255,255,0.38)" : "rgba(255,255,255,0.10)";
          ctx.lineWidth = isHovered ? 2.5 : 1;
          ctx.stroke();

          const labelR = R + 38;
          const lx = cx + labelR * Math.cos(angle);
          const ly = cy + labelR * Math.sin(angle);

          const words = dim.label.split(" ");
          ctx.fillStyle = isHovered ? "#7dd3fc" : "rgba(255,255,255,0.58)";
          ctx.font = isHovered ? "bold 11px Inter, sans-serif" : "bold 10px Inter, sans-serif";
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          if (words.length === 2) {
            ctx.fillText(words[0], lx, ly - 6);
            ctx.fillText(words[1], lx, ly + 6);
          } else {
            ctx.fillText(dim.label, lx, ly);
          }
        });

        function plotPolygon(values, strokeColor, fillColor) {
          ctx.beginPath();
          values.forEach((v, i) => {
            const angle = (2 * Math.PI * i / n) - Math.PI / 2;
            const r = R * Math.max(0, Math.min(1, v));
            i === 0 ? ctx.moveTo(cx + r * Math.cos(angle), cy + r * Math.sin(angle))
                    : ctx.lineTo(cx + r * Math.cos(angle), cy + r * Math.sin(angle));
          });
          ctx.closePath();
          ctx.fillStyle = fillColor;
          ctx.fill();
          ctx.strokeStyle = strokeColor;
          ctx.lineWidth = 2;
          ctx.stroke();
        }

        const hasHover = hoveredIndex !== -1;
        const blOpacityStroke = hasHover ? 0.35 : 0.8;
        const blOpacityFill   = hasHover ? 0.04 : 0.12;
        const userOpacityStroke = hasHover ? 0.40 : 0.85;
        const userOpacityFill   = hasHover ? 0.03 : 0.10;

        const blColor = baseline === "web_novel" ? "#a78bfa" : "#fbbf24";
        const blRgb = baseline === "web_novel" ? "167,139,250" : "251,191,36";

        const blVals = (stats.baselines && stats.baselines.radar && stats.baselines.radar[baseline])
          ? stats.baselines.radar[baseline]
          : RADAR_BASELINES[baseline];

        plotPolygon(
          blVals,
          `rgba(${blRgb}, ${blOpacityStroke})`,
          `rgba(${blRgb}, ${blOpacityFill})`
        );

        const prefix = Object.keys(stats).find(k => k.startsWith("zh_")) ? "zh_" :
                       Object.keys(stats).find(k => k.startsWith("ja_")) ? "ja_" : "en_";
        const userVals = RADAR_DIMS.map(d => {
          const statsKey = d.key.replace("en_", prefix);
          if (stats.normalized_radar && stats.normalized_radar[statsKey] !== undefined) {
            return stats.normalized_radar[statsKey];
          }
          return norm(stats[statsKey] ?? 0, d.min, d.max);
        });
        plotPolygon(
          userVals,
          `rgba(125,211,252, ${userOpacityStroke})`,
          `rgba(125,211,252, ${userOpacityFill})`
        );

        /* Dot on each axis */
        userVals.forEach((v, i) => {
          const isHovered = hoveredIndex === i;
          const angle = (2 * Math.PI * i / n) - Math.PI / 2;
          const r = R * Math.max(0, Math.min(1, v));
          ctx.beginPath();
          
          if (isHovered) {
            ctx.shadowBlur = 8;
            ctx.shadowColor = "#7dd3fc";
            ctx.arc(cx + r * Math.cos(angle), cy + r * Math.sin(angle), 6, 0, 2 * Math.PI);
            ctx.fillStyle = "#7dd3fc";
            ctx.fill();
            ctx.strokeStyle = "rgba(255,255,255,0.95)";
            ctx.lineWidth = 2.5;
            ctx.stroke();
            ctx.shadowBlur = 0;
          } else {
            ctx.arc(cx + r * Math.cos(angle), cy + r * Math.sin(angle), 3.5, 0, 2 * Math.PI);
            ctx.fillStyle = hasHover ? "rgba(125,211,252,0.4)" : "#7dd3fc";
            ctx.fill();
          }
        });

        if (hasHover) {
          const blVal = blVals[hoveredIndex];
          const angle = (2 * Math.PI * hoveredIndex / n) - Math.PI / 2;
          const r = R * Math.max(0, Math.min(1, blVal));
          ctx.beginPath();
          ctx.shadowBlur = 8;
          ctx.shadowColor = blColor;
          ctx.arc(cx + r * Math.cos(angle), cy + r * Math.sin(angle), 6, 0, 2 * Math.PI);
          ctx.fillStyle = blColor;
          ctx.fill();
          ctx.strokeStyle = "rgba(255,255,255,0.95)";
          ctx.lineWidth = 2.5;
          ctx.stroke();
          ctx.shadowBlur = 0;
        }

        const am = stats["archetype_match"];
        if (am) {
          if (am.top_genres && am.top_territories) {
            const genresStr = am.top_genres.slice(0, 3).map(g => `${g.genre} (${Math.min(99, Math.max(1, Math.round(g.confidence * 100)))}%)`).join(", ");
            const territoryStr = am.top_territories[0].territory;
            const maxConf = Math.min(99, Math.max(1, Math.round(am.confidence * 100)));
            document.getElementById("archetypeLabel").textContent =
              `${genresStr} · ${territoryStr} · ${maxConf}% match`;
          } else {
            const tropeConf = Math.min(99, Math.max(1, Math.round(am.confidence * 100)));
            document.getElementById("archetypeLabel").textContent =
              `${am.closest_trope} · ${am.territory} · ${tropeConf}% match`;
          }
        }
      }

      /* ── Kishōtenketsu arc (SVG) ── */
      function drawArc(arcData, baseline) {
        const svg = document.getElementById("arcChart");
        if (!svg) return;
        svg.innerHTML = "";
        const W = 600, H = 420;
        const PAD = { top: 30, bottom: 48, left: 48, right: 48 };
        const plotW = W - PAD.left - PAD.right;
        const plotH = H - PAD.top - PAD.bottom;
        const ns = "http://www.w3.org/2000/svg";

        const acts    = (arcData.quantiles && arcData.quantiles.length > 0)
          ? arcData.quantiles.map((v, i) => ({ sentiment: v, actIndex: i }))
          : arcData.acts;
        const blVals  = (arcData.baselines && arcData.baselines[baseline])
          ? arcData.baselines[baseline]
          : [0.0839, 0.0588, 0.1347, 0.1006];
        const blColor = baseline === "web_novel" ? "#a78bfa" : "#fbbf24";
        const blRgb   = baseline === "web_novel" ? "167,139,250" : "251,191,36";
        const sentY = s => {
          const clamped = Math.max(-1.0, Math.min(1.0, s));
          return PAD.top + plotH * (1 - (clamped + 1) / 2);
        };
        const actX  = i => PAD.left + i * plotW / (acts.length - 1);
        const axisX  = actX(0);
        const endX   = actX(acts.length - 1);
        const bottomY = PAD.top + plotH;
        const zeroY   = sentY(0);

        /* ── Smooth Catmull-Rom / Hermite Spline ── */
        function smoothPath(pts_x, pts_y) {
          const n = pts_x.length;
          if (n === 0) return "";
          if (n === 1) return `M ${pts_x[0].toFixed(1)},${pts_y[0].toFixed(1)}`;
          let d = `M ${pts_x[0].toFixed(1)},${pts_y[0].toFixed(1)}`;
          for (let i = 0; i < n - 1; i++) {
            const x0 = pts_x[i === 0 ? 0 : i - 1];
            const y0 = pts_y[i === 0 ? 0 : i - 1];
            const x1 = pts_x[i];
            const y1 = pts_y[i];
            const x2 = pts_x[i + 1];
            const y2 = pts_y[i + 1];
            const x3 = pts_x[i + 2 >= n ? n - 1 : i + 2];
            const y3 = pts_y[i + 2 >= n ? n - 1 : i + 2];

            const cp1x = x1 + (x2 - x0) / 6;
            const cp1y = y1 + (y2 - y0) / 6;
            const cp2x = x2 - (x3 - x1) / 6;
            const cp2y = y2 - (y3 - y1) / 6;

            d += ` C ${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`;
          }
          return d;
        }

        const xs      = acts.map((_, i) => actX(i));
        const userYs  = acts.map(a => sentY(typeof a === "number" ? a : a.sentiment));
        const blYs    = blVals.map(v => sentY(v));
        const pathD   = smoothPath(xs, userYs);
        const blPathD = smoothPath(xs, blYs);

        const areaClose = (path, xArr) =>
          `${path} L ${xArr[xArr.length-1].toFixed(1)},${zeroY.toFixed(1)} L ${xArr[0].toFixed(1)},${zeroY.toFixed(1)} Z`;

        const userAvgAbs = acts.reduce((s, a) => s + Math.abs(typeof a === "number" ? a : a.sentiment), 0) / acts.length;
        const blAvgAbs   = blVals.reduce((s, v) => s + Math.abs(v), 0) / blVals.length;
        const userIsInner = userAvgAbs <= blAvgAbs;
        const [innerPathD, outerPathD] = userIsInner ? [pathD, blPathD] : [blPathD, pathD];
        const [innerGrad,  outerGrad]  = userIsInner ? ["arcUserGrad", "arcBaselineGrad"] : ["arcBaselineGrad", "arcUserGrad"];

        /* ── Gradients Defs ── */
        const defs = document.createElementNS(ns, "defs");
        const zf = (zeroY - PAD.top) / plotH;

        const makeGrad = (id, rgb, alpha) => {
          const g = document.createElementNS(ns, "linearGradient");
          g.setAttribute("id", id);
          g.setAttribute("gradientUnits", "userSpaceOnUse");
          g.setAttribute("x1", "0"); g.setAttribute("y1", String(PAD.top));
          g.setAttribute("x2", "0"); g.setAttribute("y2", String(bottomY));
          const pct = p => `${(Math.max(0, Math.min(1, p)) * 100).toFixed(1)}%`;
          const minA = (alpha * 0.40).toFixed(3);
          [
            [0,   `rgba(${rgb},${alpha})`],
            [zf,  `rgba(${rgb},${minA})`],
            [1,   `rgba(${rgb},${alpha})`],
          ].forEach(([offset, color]) => {
            const s = document.createElementNS(ns, "stop");
            s.setAttribute("offset", pct(offset));
            s.setAttribute("stop-color", color);
            g.appendChild(s);
          });
          return g;
        };

        defs.appendChild(makeGrad("arcUserGrad",     "125,211,252", 0.80));
        defs.appendChild(makeGrad("arcBaselineGrad", blRgb,         0.75));

        const clipPath = document.createElementNS(ns, "clipPath");
        clipPath.setAttribute("id", "outerFillClip");
        const clipShape = document.createElementNS(ns, "path");
        const boundingRect =
          `M ${axisX.toFixed(1)},${PAD.top} L ${endX.toFixed(1)},${PAD.top}` +
          ` L ${endX.toFixed(1)},${bottomY} L ${axisX.toFixed(1)},${bottomY} Z`;
        clipShape.setAttribute("d", `${boundingRect} ${areaClose(innerPathD, xs)}`);
        clipShape.setAttribute("clip-rule", "evenodd");
        clipPath.appendChild(clipShape);
        defs.appendChild(clipPath);
        svg.appendChild(defs);

        // Vertical guide line when hovering
        if (hoveredArcIndex >= 0 && hoveredArcIndex < acts.length) {
          const hx = actX(hoveredArcIndex);
          const vGuide = document.createElementNS(ns, "line");
          vGuide.setAttribute("x1", hx); vGuide.setAttribute("y1", PAD.top);
          vGuide.setAttribute("x2", hx); vGuide.setAttribute("y2", bottomY);
          vGuide.setAttribute("stroke", "rgba(255,255,255,0.25)");
          vGuide.setAttribute("stroke-dasharray", "3 3");
          svg.appendChild(vGuide);
        }

        /* ── Grid lines ── */
        [-1, -0.5, 0, 0.5, 1].forEach(val => {
          const y = sentY(val);
          const isZero = val === 0;

          const line = document.createElementNS(ns, "line");
          line.setAttribute("x1", String(axisX));
          line.setAttribute("y1", y);
          line.setAttribute("x2", String(endX));
          line.setAttribute("y2", y);
          line.setAttribute("stroke", isZero ? "rgba(255,255,255,0.18)" : "rgba(255,255,255,0.055)");
          if (!isZero) line.setAttribute("stroke-dasharray", "4 5");
          svg.appendChild(line);

          const lbl = document.createElementNS(ns, "text");
          lbl.setAttribute("x", String(axisX - 8));
          lbl.setAttribute("y", y + 3.5);
          lbl.setAttribute("fill", "rgba(255,255,255,0.3)");
          lbl.setAttribute("font-size", "9");
          lbl.setAttribute("font-family", "Inter, sans-serif");
          lbl.setAttribute("text-anchor", "end");
          lbl.textContent = val > 0 ? `+${val.toFixed(1)}` : val.toFixed(1);
          svg.appendChild(lbl);
        });

        const yAxis = document.createElementNS(ns, "line");
        yAxis.setAttribute("x1", String(axisX)); yAxis.setAttribute("y1", String(PAD.top));
        yAxis.setAttribute("x2", String(axisX)); yAxis.setAttribute("y2", String(bottomY));
        yAxis.setAttribute("stroke", "rgba(255,255,255,0.22)");
        svg.appendChild(yAxis);

        const xAxis = document.createElementNS(ns, "line");
        xAxis.setAttribute("x1", String(axisX)); xAxis.setAttribute("y1", String(bottomY));
        xAxis.setAttribute("x2", String(endX));  xAxis.setAttribute("y2", String(bottomY));
        xAxis.setAttribute("stroke", "rgba(255,255,255,0.22)");
        svg.appendChild(xAxis);

        ["Ki (Intro)", "Shō (Dev)", "Ten (Twist)", "Ketsu (Res)"].forEach((label, i) => {
          const lx = actX(i);
          const tick = document.createElementNS(ns, "line");
          tick.setAttribute("x1", lx); tick.setAttribute("y1", bottomY);
          tick.setAttribute("x2", lx); tick.setAttribute("y2", bottomY + 4);
          tick.setAttribute("stroke", "rgba(255,255,255,0.2)");
          svg.appendChild(tick);

          const txt = document.createElementNS(ns, "text");
          txt.setAttribute("x", lx); txt.setAttribute("y", bottomY + 16);
          txt.setAttribute("fill", "rgba(255,255,255,0.45)");
          txt.setAttribute("font-size", "10"); txt.setAttribute("font-weight", "600");
          txt.setAttribute("font-family", "Inter, sans-serif");
          txt.setAttribute("text-anchor", "middle");
          txt.textContent = label;
          svg.appendChild(txt);
        });

        /* ── Fills ── */
        const outerArea = document.createElementNS(ns, "path");
        outerArea.setAttribute("d", areaClose(outerPathD, xs));
        outerArea.setAttribute("fill", `url(#${outerGrad})`);
        outerArea.setAttribute("clip-path", "url(#outerFillClip)");
        svg.appendChild(outerArea);

        const innerArea = document.createElementNS(ns, "path");
        innerArea.setAttribute("d", areaClose(innerPathD, xs));
        innerArea.setAttribute("fill", `url(#${innerGrad})`);
        svg.appendChild(innerArea);

        /* ── Strokes ── */
        const blPath = document.createElementNS(ns, "path");
        blPath.setAttribute("d", blPathD);
        blPath.setAttribute("fill", "none");
        blPath.setAttribute("stroke", blColor);
        blPath.setAttribute("stroke-width", "1.75");
        blPath.setAttribute("stroke-dasharray", "5 4");
        blPath.setAttribute("opacity", "0.85");
        svg.appendChild(blPath);

        const userPath = document.createElementNS(ns, "path");
        userPath.setAttribute("d", pathD);
        userPath.setAttribute("fill", "none");
        userPath.setAttribute("stroke", "#7dd3fc");
        userPath.setAttribute("stroke-width", "2.5");
        svg.appendChild(userPath);

        /* ── Dots ── */
        xs.forEach((x, i) => {
          const userDot = document.createElementNS(ns, "circle");
          userDot.setAttribute("cx", x); userDot.setAttribute("cy", userYs[i]);
          userDot.setAttribute("r", i === hoveredArcIndex ? "6" : "4");
          userDot.setAttribute("fill", "#7dd3fc");
          userDot.setAttribute("stroke", "#0a0a12");
          userDot.setAttribute("stroke-width", "2");
          svg.appendChild(userDot);

          const blDot = document.createElementNS(ns, "circle");
          blDot.setAttribute("cx", x); blDot.setAttribute("cy", blYs[i]);
          blDot.setAttribute("r", i === hoveredArcIndex ? "5" : "3.5");
          blDot.setAttribute("fill", blColor);
          blDot.setAttribute("stroke", "#0a0a12");
          blDot.setAttribute("stroke-width", "1.5");
          svg.appendChild(blDot);
        });

        const actLabels = document.getElementById("actLabels");
        if (actLabels) {
          actLabels.innerHTML = "";
          acts.forEach(a => {
            const chip = document.createElement("div");
            chip.className = "act-chip";
            chip.innerHTML = `<span class="act-key">${a.act || ''}</span><span class="act-name">${a.label || ''}</span>`;
            actLabels.appendChild(chip);
          });
        }
      }

      /* ── Rhythmic Pacing (Paragraph Barcode) ── */
      function drawPacing(stats, baseline) {
        const userPacing = stats.pacing || [];
        const isWeb = baseline === "web_novel";
        const baselineColor = isWeb ? "#a78bfa" : "#fbbf24";
        const baselineData = PACING_BASELINES[baseline];

        const userAvg = userPacing.length > 0 ? (userPacing.reduce((a,b)=>a+b,0)/userPacing.length).toFixed(1) : 0;
        const baseAvg = baselineData.reduce((a,b)=>a+b,0)/baselineData.length;
        
        document.getElementById("pacingDraftLabel").textContent = `Your Draft (Average Paragraph Length: ${userAvg} words/chars)`;
        document.getElementById("pacingBaselineLabel").textContent = `${isWeb ? "Web Novel" : "Classic Lit"} Baseline (Average Paragraph Length: ${baseAvg.toFixed(1)} words/chars)`;

        renderBarcode("pacingBarcodeUser", userPacing, "#7dd3fc");
        renderBarcode("pacingBarcodeBaseline", baselineData, baselineColor);
      }

      function renderBarcode(containerId, data, color) {
        const container = document.getElementById(containerId);
        container.innerHTML = "";
        
        if (!data || data.length === 0) {
          container.innerHTML = "<div style='color:rgba(255,255,255,0.3); font-size:0.8rem; padding: 1rem; width:100%; text-align:center;'>No paragraph pacing data available</div>";
          return;
        }

        const maxVal = Math.max(...data);
        data.forEach(val => {
          const intensity = val / maxVal;
          const bar = document.createElement("div");
          bar.style.flex = "1";
          bar.style.backgroundColor = color;
          bar.style.opacity = Math.max(0.18, intensity);
          bar.style.borderRadius = "2px";
          bar.style.transition = "all 0.3s ease";
          bar.title = `${val} words/characters`;
          container.appendChild(bar);
        });
      }

      /* ── Doppelgängers / Similar Novels Renderer ── */
      function renderSimilarNovels(matches) {
        const container = document.getElementById("similarNovelsContainer");
        if (!container) return;
        container.innerHTML = "";

        if (!matches || matches.length === 0) {
          container.innerHTML = `<p style="color: #64748b; font-size: 13px; margin: 0; padding: 12px;">No similar matches found.</p>`;
          return;
        }

        matches.forEach((m, index) => {
          const item = document.createElement("div");
          item.className = "doppelganger-item";
          item.addEventListener("click", () => {
            window.location.href = `/library?novelId=${m.id}`;
          });

          const pct = Math.round((m.similarity_score || 0) * 100);
          const topGenres = (m.genre || 'Fiction').split(',').map(g => g.trim()).filter(Boolean).slice(0, 3).join(', ');
          const scoreColor = m.similarity_score > 0.9 ? '#38bdf8' : m.similarity_score > 0.8 ? '#818cf8' : '#94a3b8';

          item.innerHTML = `
            <div class="doppelganger-left">
              <span class="doppelganger-rank">#${index + 1}</span>
              <div class="doppelganger-info">
                <h4 class="doppelganger-item-title">${m.title}</h4>
                ${m.author ? `<span class="doppelganger-author">${m.author}</span>` : ''}
                <span class="doppelganger-badge">${topGenres}</span>
                ${m.reasons && m.reasons.length > 0 ? `
                  <div class="doppelganger-reasons">
                    ${m.reasons.slice(0, 3).map(r => `<span class="reason-pill">${r}</span>`).join('')}
                  </div>
                ` : ''}
              </div>
            </div>

            <div class="doppelganger-right">
              <span class="doppelganger-score" style="color: ${scoreColor}">${pct}%</span>
              ${m.breakdown ? `
                <div class="doppelganger-breakdown">
                  ${[
                    { label: 'STY', name: 'Prose Style', val: m.breakdown.style },
                    { label: 'GEN', name: 'Genre', val: m.breakdown.genre },
                    { label: 'TAG', name: 'Tags', val: m.breakdown.tags },
                    { label: 'TER', name: 'Territory', val: m.breakdown.territory },
                    { label: 'SEM', name: 'Semantic', val: m.breakdown.semantic }
                  ].map(f => {
                    const fPct = Math.round((f.val || 0) * 100);
                    const fColor = f.val > 0.8 ? '#22d3ee' : '#64748b';
                    return `
                      <div class="doppelganger-factor" title="${f.name}: ${fPct}%">
                        <span class="doppelganger-factor-label">${f.label}</span>
                        <div class="doppelganger-factor-bar-bg">
                          <div class="doppelganger-factor-bar-fill" style="width: ${fPct}%; background-color: ${fColor}"></div>
                        </div>
                      </div>
                    `;
                  }).join('')}
                </div>
              ` : `
                <div class="doppelganger-progress-bg">
                  <div class="doppelganger-progress-fill" style="width: ${pct}%; background-color: ${scoreColor}"></div>
                </div>
              `}
            </div>
          `;
          container.appendChild(item);
        });
      }

      /* ── Radar & Arc Chart Mouse Hover & Tooltip Events ── */
      function setupChartHoverListeners() {
        const canvasNode = document.getElementById("radarChart");
        const tooltipNode = document.getElementById("radarTooltip");

        if (canvasNode && tooltipNode) {
          canvasNode.addEventListener("mousemove", (e) => {
            if (!currentStats) return;
            const rect = canvasNode.getBoundingClientRect();
            const mx = e.clientX - rect.left;
            const my = e.clientY - rect.top;
            const cx = rect.width / 2;
            const cy = rect.height / 2;
            const dx = mx - cx;
            const dy = my - cy;
            const d = Math.sqrt(dx * dx + dy * dy);
            let angle = Math.atan2(dy, dx);

            const labelPad = 75;
            const R_css = Math.min(rect.width, rect.height) / 2 - labelPad;
            const n = RADAR_DIMS.length;
            let bestIndex = -1;
            let minDiff = Infinity;

            for (let i = 0; i < n; i++) {
              const spokeAngle = (2 * Math.PI * i / n) - Math.PI / 2;
              let diff = Math.abs(angle - spokeAngle);
              while (diff > Math.PI) {
                diff = Math.abs(diff - 2 * Math.PI);
              }
              if (diff < minDiff) {
                minDiff = diff;
                bestIndex = i;
              }
            }

            if (bestIndex !== hoveredIndex) {
              hoveredIndex = bestIndex;
              if (currentStats) drawRadar(currentStats, activeBaseline);
            }

            if (hoveredIndex !== -1) {
              const dim = RADAR_DIMS[hoveredIndex];
              const prefix = Object.keys(currentStats).find(k => k.startsWith("zh_")) ? "zh_" :
                             Object.keys(currentStats).find(k => k.startsWith("ja_")) ? "ja_" : "en_";
              const statsKey = dim.key.replace("en_", prefix);

              const userVal = (currentStats.normalized_radar && currentStats.normalized_radar[statsKey] !== undefined)
                ? currentStats.normalized_radar[statsKey]
                : norm(currentStats[statsKey] ?? (currentStats.features ? currentStats.features[dim.key.replace("en_", "")] : 0), dim.min, dim.max);

              const blVals = (currentStats.baselines && currentStats.baselines.radar && currentStats.baselines.radar[activeBaseline])
                ? currentStats.baselines.radar[activeBaseline]
                : RADAR_BASELINES[activeBaseline];
              const blVal = blVals ? blVals[hoveredIndex] : 0.5;

              const userPct = Math.round(Math.max(0, Math.min(1, userVal)) * 100) + "%";
              const blPct = Math.round(Math.max(0, Math.min(1, blVal)) * 100) + "%";
              const baseName = activeBaseline === "web_novel" ? "Web Novel Baseline" : "Classic Lit Baseline";
              const blColor = activeBaseline === "web_novel" ? "#a78bfa" : "#fbbf24";

              tooltipNode.innerHTML = `
                <div class="radar-tooltip-title">${dim.label}</div>
                <div class="radar-tooltip-row">
                  <span style="color: rgba(255,255,255,0.7)">Your Draft:</span>
                  <span class="radar-tooltip-val" style="color: #7dd3fc">${userPct}</span>
                </div>
                <div class="radar-tooltip-row">
                  <span style="color: rgba(255,255,255,0.7)">${baseName}:</span>
                  <span class="radar-tooltip-val" style="color: ${blColor}">${blPct}</span>
                </div>
              `;

              tooltipNode.style.display = "block";
              tooltipNode.style.left = (e.clientX + 15) + "px";
              tooltipNode.style.top = (e.clientY + 15) + "px";
            } else {
              tooltipNode.style.display = "none";
            }
          });

          canvasNode.addEventListener("mouseleave", () => {
            if (hoveredIndex !== -1) {
              hoveredIndex = -1;
              if (currentStats) drawRadar(currentStats, activeBaseline);
            }
            tooltipNode.style.display = "none";
          });
        }

        const svgNode = document.getElementById("arcChart");
        const arcTooltipNode = document.getElementById("arcTooltip");

        if (svgNode && arcTooltipNode) {
          svgNode.addEventListener("mousemove", (e) => {
            if (!currentArc) return;
            try {
              const rect = svgNode.getBoundingClientRect();
              const svgX = e.clientX - rect.left;
              const W = rect.width || 600;
              const PAD = { left: 45, right: 30 };
              const plotW = W - PAD.left - PAD.right;

              const acts = currentArc.quantiles
                ? currentArc.quantiles.map((v, i) => ({ sentiment: v, actIndex: i }))
                : currentArc.acts;

              const actX = i => PAD.left + i * plotW / (acts.length - 1);

              let closestIdx = -1;
              let minDiff = Infinity;

              for (let i = 0; i < acts.length; i++) {
                const diff = Math.abs(svgX - actX(i));
                if (diff < minDiff) {
                  minDiff = diff;
                  closestIdx = i;
                }
              }

              if (svgX < PAD.left - 25 || svgX > W - PAD.right + 25) {
                closestIdx = -1;
              }

              if (closestIdx !== hoveredArcIndex) {
                hoveredArcIndex = closestIdx;
                if (currentArc) drawArc(currentArc, activeBaseline);
              }

              if (hoveredArcIndex !== -1) {
                const act = acts[hoveredArcIndex];
                const userVal = typeof act === "number" ? act : act.sentiment;
                const blVals = (currentArc.baselines && currentArc.baselines[activeBaseline])
                  ? currentArc.baselines[activeBaseline]
                  : [0.0839, 0.0588, 0.1347, 0.1006];
                const blVal = blVals[hoveredArcIndex] || 0;

                const labelMap = { "Introduction": "Intro", "Development": "Dev", "Twist": "Twist", "Resolution": "Res" };
                const actNames = ["Ki (Intro)", "Shō (Dev)", "Ten (Twist)", "Ketsu (Res)"];
                const titleFmt = actNames[hoveredArcIndex] || `${act.act || ''} (${labelMap[act.label] || act.label || ''})`;

                const userFmt = userVal >= 0 ? `+${userVal.toFixed(2)}` : userVal.toFixed(2);
                const blFmt = blVal >= 0 ? `+${blVal.toFixed(2)}` : blVal.toFixed(2);
                const baseName = activeBaseline === "web_novel" ? "Web Novel Baseline" : "Classic Lit Baseline";
                const blColor = activeBaseline === "web_novel" ? "#a78bfa" : "#fbbf24";

                arcTooltipNode.innerHTML = `
                  <div class="radar-tooltip-title">${titleFmt}</div>
                  <div class="radar-tooltip-row">
                    <span style="color: rgba(255,255,255,0.7)">Your Draft:</span>
                    <span class="radar-tooltip-val" style="color: #7dd3fc">${userFmt}</span>
                  </div>
                  <div class="radar-tooltip-row">
                    <span style="color: rgba(255,255,255,0.7)">${baseName}:</span>
                    <span class="radar-tooltip-val" style="color: ${blColor}">${blFmt}</span>
                  </div>
                `;

                arcTooltipNode.style.display = "block";
                arcTooltipNode.style.left = (e.clientX + 15) + "px";
                arcTooltipNode.style.top = (e.clientY + 15) + "px";
              } else {
                arcTooltipNode.style.display = "none";
              }
            } catch (err) {
              console.error("Error handling arc tooltip:", err);
            }
          });

          svgNode.addEventListener("mouseleave", () => {
            if (hoveredArcIndex !== -1) {
              hoveredArcIndex = -1;
              if (currentArc) drawArc(currentArc, activeBaseline);
            }
            arcTooltipNode.style.display = "none";
          });
        }
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupChartHoverListeners);
      } else {
        setupChartHoverListeners();
      }
    </script>
    <div id="radarTooltip" class="radar-tooltip"></div>
    <div id="arcTooltip" class="radar-tooltip"></div>
  </body>
</html>
